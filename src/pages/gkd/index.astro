---
import BaseLayout from '../../layouts/BaseLayout.astro'
import subscription from '../../data/gkd-subscription.json'

const primaryUrl = 'https://nisconder.pages.dev/gkd/subscription.json5'
const backupUrl = 'https://raw.githubusercontent.com/nisconder/gkd-subscription/main/dist/gkd.json5'
const repositoryUrl = 'https://github.com/nisconder/gkd-subscription'
const verifiedScenes = [
  { app: 'X', scope: '个人简介、个人页信息流中的翻译', version: '12.42.0-prod.01 · 版本代码 312420001' },
  { app: '拼多多', scope: '商品详情页直播浮窗关闭', version: '8.31.0 · 版本代码 83100' },
  { app: 'WakeUp 课程表', scope: '课表底部广告关闭', version: '版本代码 562' },
]
---

<BaseLayout
  title={subscription.name}
  description="获取 Nisconder 的 GKD 订阅地址，查看添加步骤、已验证场景和问题反馈入口。"
>
  <div class="gkd-page" data-gkd-subscription>
    <header class="page-intro gkd-intro">
      <p class="eyebrow">GKD / 规则订阅 <span class="gkd-version">v{subscription.version}</span></p>
      <h1>{subscription.name}</h1>
      <p class="lede">在 GKD 中添加订阅地址，获取规则与后续更新。</p>
    </header>

    <div class="gkd-start">
      <section class="subscription-address" aria-labelledby="subscription-address-title">
        <header>
          <p class="eyebrow">先复制地址</p>
          <h2 id="subscription-address-title">订阅链接</h2>
        </header>
        <div class="address-field" data-copy-field>
          <label for="gkd-primary-url">主地址 · Cloudflare Pages</label>
          <textarea id="gkd-primary-url" readonly rows="2" spellcheck="false" wrap="soft" aria-describedby="gkd-primary-status">{primaryUrl}</textarea>
          <div class="address-actions">
            <button class="copy-button" type="button" data-copy-url hidden>复制主地址</button>
            <a href={primaryUrl} data-astro-reload>打开 JSON 文件 <span aria-hidden="true">↗</span></a>
          </div>
          <p id="gkd-primary-status" class="copy-status" role="status" aria-live="polite" data-copy-status></p>
        </div>
        <details class="backup-address">
          <summary>备用地址 · GitHub Raw</summary>
          <div class="address-field" data-copy-field>
            <p class="address-help">主地址暂时无法获取，或想即时获取仓库已发布的版本时，可使用这个地址。</p>
            <label for="gkd-backup-url">备用订阅链接</label>
            <textarea id="gkd-backup-url" readonly rows="3" spellcheck="false" wrap="soft" aria-describedby="gkd-backup-status">{backupUrl}</textarea>
            <div class="address-actions">
              <button class="copy-button" type="button" data-copy-url hidden>复制备用地址</button>
              <a href={backupUrl} data-astro-reload>打开备用 JSON <span aria-hidden="true">↗</span></a>
            </div>
            <p id="gkd-backup-status" class="copy-status" role="status" aria-live="polite" data-copy-status></p>
          </div>
        </details>
        <noscript><p class="address-help">可直接选中上方链接复制，再到 GKD 中添加。</p></noscript>
      </section>

      <section class="subscription-steps" aria-labelledby="subscription-steps-title">
        <p class="eyebrow">再到 GKD 添加</p>
        <h2 id="subscription-steps-title">添加订阅</h2>
        <ol>
          <li><strong>复制上方地址</strong><span>主地址与备用地址选一个即可。</span></li>
          <li><strong>打开 GKD 的「订阅」页</strong><span>点击「＋」添加订阅。</span></li>
          <li><strong>粘贴链接并确认添加</strong><span>获取规则后，按需要开启对应规则组。</span></li>
        </ol>
        <p class="steps-note">后续可在 GKD 中更新订阅，继续使用同一个地址。博客镜像通常在新版本发布后半小时内同步；GitHub 备用直链可即时获取已发布版本。</p>
      </section>
    </div>

    <section class="verified-scenes" aria-labelledby="verified-scenes-title">
      <header>
        <p class="eyebrow">适配记录</p>
        <h2 id="verified-scenes-title">已验证的具体场景</h2>
        <p>以下记录对应具体页面或版本；其他规则仍需逐项验证。</p>
      </header>
      <dl class="scene-list">
        {verifiedScenes.map((scene) => (
          <div>
            <dt>{scene.app}<small>{scene.version}</small></dt>
            <dd>{scene.scope}<span class="scene-status">已验证</span></dd>
          </div>
        ))}
      </dl>
      <p class="scope-note">应用更新或界面变化可能影响匹配。没有出现目标广告或提示，不等于该场景已经验证通过。</p>
    </section>

    <section class="gkd-maintenance" aria-labelledby="gkd-maintenance-title">
      <div>
        <h2 id="gkd-maintenance-title">规则与反馈</h2>
        <p>遇到漏跳或误触，请说明应用版本、所在页面和复现步骤。</p>
      </div>
      <nav aria-label="GKD 订阅项目链接">
        <a href={repositoryUrl} rel="noreferrer">查看规则仓库 <span aria-hidden="true">↗</span></a>
        <a href={`${repositoryUrl}/issues`} rel="noreferrer">反馈问题 <span aria-hidden="true">↗</span></a>
      </nav>
    </section>
  </div>
</BaseLayout>

<style>
  .gkd-page { max-width: 62rem; margin-inline: auto; }
  .gkd-intro { margin-block-end: 2rem; }
  .gkd-intro h1 { max-width: 19ch; font-size: clamp(2rem, 5vw, 3.2rem); overflow-wrap: anywhere; }
  .gkd-intro .eyebrow { display: flex; align-items: center; gap: 1rem; }
  .gkd-version { padding: 0.15rem 0.55rem; border: 1px solid var(--color-line-strong); border-radius: var(--card-radius); color: var(--color-muted); font-family: var(--font-utility); letter-spacing: 0; }
  .gkd-start { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); border: 1px solid var(--color-line-strong); border-block-start: 0.35rem solid var(--color-primary); border-radius: var(--card-radius); background: var(--color-card); overflow: hidden; }
  .subscription-address, .subscription-steps { min-width: 0; padding: clamp(1.25rem, 3vw, 2rem); }
  .gkd-start h2, .gkd-maintenance h2 { margin: 0 0 1.25rem; font-family: var(--font-display); font-size: var(--title-card); }
  .gkd-start .eyebrow { margin-block-end: 0.35rem; }
  .address-field label { display: block; margin-block-end: 0.5rem; }
  .address-field textarea { display: block; min-height: 5.2rem; padding: 0.8rem; resize: vertical; font-family: var(--font-utility); font-size: 0.875rem; line-height: 1.65; overflow-wrap: anywhere; }
  .address-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1rem; margin-block-start: 0.75rem; }
  .copy-button { min-height: 2.75rem; padding: 0.6rem 1rem; border: 1px solid var(--color-primary); border-radius: var(--card-radius); background: var(--color-primary); color: var(--color-on-primary); cursor: pointer; font-size: var(--text-sm); font-weight: 700; }
  .copy-button[hidden] { display: none; }
  .copy-button:disabled { cursor: progress; opacity: 0.7; }
  .address-actions a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.35rem; font-size: var(--text-sm); font-weight: 650; }
  .copy-status { min-height: 1.65em; margin: 0.5rem 0 0; color: var(--color-muted); font-size: var(--text-xs); line-height: 1.65; }
  .backup-address { margin-block-start: 0.75rem; border-block-start: 1px solid var(--color-line); }
  .backup-address summary { padding-block: 0.8rem; color: var(--color-text); cursor: pointer; font-size: var(--text-sm); font-weight: 650; }
  .address-help { margin: 0 0 0.75rem; color: var(--color-muted); font-size: var(--text-sm); }
  .subscription-steps { border-inline-start: 1px solid var(--color-line); background: var(--color-primary-soft); }
  .subscription-steps ol { display: grid; gap: 1.2rem; margin: 0; padding-inline-start: 1.5rem; }
  .subscription-steps li { padding-inline-start: 0.35rem; }
  .subscription-steps li::marker { color: var(--color-primary); font-family: var(--font-utility); font-weight: 800; }
  .subscription-steps strong, .subscription-steps li span { display: block; }
  .subscription-steps li span, .steps-note { color: var(--color-muted); font-size: var(--text-sm); }
  .steps-note { padding-block-start: 1rem; margin: 1.25rem 0 0; border-block-start: 1px solid var(--color-line); }
  .verified-scenes { margin-block: 3rem; }
  .verified-scenes h2 { margin: 0; font-family: var(--font-display); font-size: var(--title-section); }
  .verified-scenes header > p:last-child { margin: 0.6rem 0 1.25rem; color: var(--color-muted); }
  .scene-list { margin: 0; border-block-start: 1px solid var(--color-line-strong); }
  .scene-list > div { display: grid; grid-template-columns: minmax(11rem, 0.8fr) minmax(0, 1.2fr); gap: 0.75rem 1.5rem; padding-block: 1.25rem; border-block-end: 1px solid var(--color-line); }
  .scene-list dt { font-weight: 750; }
  .scene-list small { display: block; margin-block-start: 0.25rem; color: var(--color-muted); font-size: var(--text-xs); font-weight: 400; }
  .scene-list dd { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0; }
  .scene-status { flex: 0 0 auto; padding-inline: 0.5rem; border-inline-start: 2px solid var(--color-primary); color: var(--color-primary); font-size: var(--text-xs); }
  .scope-note { margin-block-start: 1rem; color: var(--color-muted); font-size: var(--text-sm); }
  .gkd-maintenance { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-block: 1.5rem; border-block-start: 1px solid var(--color-line-strong); }
  .gkd-maintenance h2 { margin-block-end: 0.5rem; }
  .gkd-maintenance p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  .gkd-maintenance nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .gkd-maintenance a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.35rem; font-size: var(--text-sm); font-weight: 700; }
  @media (max-width: 48rem) {
    .gkd-start { grid-template-columns: minmax(0, 1fr); }
    .subscription-steps { border-inline-start: 0; border-block-start: 1px solid var(--color-line); }
  }
  @media (max-width: 34rem) {
    .scene-list > div { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .scene-list dd { font-size: var(--text-sm); }
    .gkd-maintenance { align-items: flex-start; }
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const page = document.querySelector('[data-gkd-subscription]')
    if (!(page instanceof HTMLElement) || page.dataset.copyBound === 'true') return
    page.dataset.copyBound = 'true'
    const lifecycle = new AbortController()
    const { signal } = lifecycle

    page.querySelectorAll('[data-copy-field]').forEach((field) => {
      const input = field.querySelector('textarea')
      const button = field.querySelector('[data-copy-url]')
      const status = field.querySelector('[data-copy-status]')
      if (!(input instanceof HTMLTextAreaElement)
        || !(button instanceof HTMLButtonElement)
        || !(status instanceof HTMLElement)) return
      button.hidden = false
      button.addEventListener('click', async () => {
        button.disabled = true
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable')
          await navigator.clipboard.writeText(input.value)
          if (signal.aborted || !page.isConnected) return
          status.textContent = '已复制。到 GKD 的「订阅」页点击「＋」，粘贴地址。'
        } catch {
          if (signal.aborted || !page.isConnected) return
          input.focus()
          input.select()
          status.textContent = '未能自动复制。链接已选中，请长按或使用 Ctrl/Cmd+C 复制。'
        } finally {
          if (!signal.aborted && page.isConnected) button.disabled = false
        }
      }, { signal })
    })

    document.addEventListener('astro:before-swap', () => {
      lifecycle.abort()
      page.querySelectorAll('[data-copy-url]').forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = false
      })
      delete page.dataset.copyBound
    }, { once: true, signal })
  })()
</script>
