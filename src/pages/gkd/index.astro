---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CopySubscriptionUrl from '../../components/CopySubscriptionUrl.astro'
import subscription from '../../data/gkd-subscription.json'

const primaryUrl = 'https://nisconder.pages.dev/gkd/subscription.json5'
const backupUrl = 'https://raw.githubusercontent.com/nisconder/Nisconder-GKD-Subscription/main/dist/gkd.json5'
const repositoryUrl = 'https://github.com/nisconder/Nisconder-GKD-Subscription'
const releaseHistory = [
  {
    date: '2026-11-13',
    title: '订阅地址上线',
    changes: [
      '提供固定订阅地址与 GitHub 备用地址，后续可通过同一地址获取更新。',
      '整理应用规则与全局规则的适用范围，继续保留原有排除条件和按需开启的默认设置。',
      '保留 WakeUp 底部广告、X 个人简介与个人页翻译、拼多多商品页直播浮窗的定向修订。',
    ],
  },
]
---

<BaseLayout
  title={subscription.name}
  description="获取 Nisconder 的 GKD 订阅地址，查看添加步骤、更新历史和问题反馈入口。"
>
  <div class="gkd-page" data-gkd-subscription>
    <header class="page-intro gkd-intro">
      <p class="eyebrow">GKD / 规则订阅</p>
      <h1>{subscription.name}</h1>
      <p class="lede">在 GKD 中添加订阅地址，获取规则与后续更新。</p>
    </header>

    <div class="gkd-start">
      <section class="subscription-address" aria-labelledby="subscription-address-title">
        <header>
          <p class="eyebrow">先复制地址</p>
          <h2 id="subscription-address-title">订阅链接</h2>
        </header>
        <CopySubscriptionUrl
          id="gkd-primary-url"
          url={primaryUrl}
          label="主地址 · Cloudflare Pages"
          copyLabel="复制主地址"
          copyHint="到 GKD 的「订阅」页点击「＋」，粘贴地址。"
          openLabel="打开 JSON 文件"
        />
        <details class="backup-address">
          <summary>备用地址 · GitHub Raw</summary>
          <p class="address-help">主地址暂时无法获取，或想即时获取仓库已发布的版本时，可使用这个地址。</p>
          <CopySubscriptionUrl
            id="gkd-backup-url"
            url={backupUrl}
            label="备用订阅链接"
            copyLabel="复制备用地址"
            copyHint="到 GKD 的「订阅」页点击「＋」，粘贴地址。"
            openLabel="打开备用 JSON"
            rows={3}
          />
        </details>
      </section>

      <section class="subscription-steps" aria-labelledby="subscription-steps-title">
        <p class="eyebrow">再到 GKD 添加</p>
        <h2 id="subscription-steps-title">添加订阅</h2>
        <ol>
          <li><strong>复制上方地址</strong><span>主地址与备用地址选一个即可。</span></li>
          <li><strong>打开 GKD 的「订阅」页</strong><span>点击「＋」添加订阅。</span></li>
          <li><strong>粘贴链接并确认添加</strong><span>获取规则后，按需要开启对应规则组。</span></li>
        </ol>
        <p class="steps-note">后续可在 GKD 中更新订阅，继续使用同一个地址。博客镜像通常在新版本发布后半小时内同步；GitHub 备用直链可即时获取已发布版本。</p>
      </section>
    </div>

    <section id="updates" class="release-history" aria-labelledby="release-history-title">
      <header>
        <h2 id="release-history-title">更新历史</h2>
      </header>
      <ol class="release-list">
        {releaseHistory.map((release) => (
          <li>
            <time class="release-date" datetime={release.date}>{release.date}</time>
            <div>
              <h3>{release.title}</h3>
              <ul>{release.changes.map((change) => <li>{change}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="gkd-maintenance" aria-labelledby="gkd-maintenance-title">
      <div>
        <h2 id="gkd-maintenance-title">规则与反馈</h2>
        <p>遇到漏跳或误触，请说明应用版本、所在页面和复现步骤。</p>
      </div>
      <nav aria-label="GKD 订阅项目链接">
        <a href={repositoryUrl} rel="noreferrer">查看规则仓库 <span aria-hidden="true">↗</span></a>
        <a href={`${repositoryUrl}/issues`} rel="noreferrer">反馈问题 <span aria-hidden="true">↗</span></a>
      </nav>
    </section>
  </div>
</BaseLayout>

<style>
  .gkd-page { max-width: 62rem; margin-inline: auto; }
  .gkd-intro { margin-block-end: 2rem; }
  .gkd-intro h1 { max-width: 19ch; font-size: clamp(2rem, 5vw, 3.2rem); overflow-wrap: anywhere; }
  .gkd-start { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); border: 1px solid var(--color-line-strong); border-block-start: 0.35rem solid var(--color-primary); border-radius: var(--card-radius); background: var(--color-card); overflow: hidden; }
  .subscription-address, .subscription-steps { min-width: 0; padding: clamp(1.25rem, 3vw, 2rem); }
  .gkd-start h2, .gkd-maintenance h2 { margin: 0 0 1.25rem; font-family: var(--font-display); font-size: var(--title-card); }
  .gkd-start .eyebrow { margin-block-end: 0.35rem; }
  .backup-address { margin-block-start: 0.75rem; border-block-start: 1px solid var(--color-line); }
  .backup-address summary { padding-block: 0.8rem; color: var(--color-text); cursor: pointer; font-size: var(--text-sm); font-weight: 650; }
  .address-help { margin: 0 0 0.75rem; color: var(--color-muted); font-size: var(--text-sm); }
  .subscription-steps { border-inline-start: 1px solid var(--color-line); background: var(--color-primary-soft); }
  .subscription-steps ol { display: grid; gap: 1.2rem; margin: 0; padding-inline-start: 1.5rem; }
  .subscription-steps li { padding-inline-start: 0.35rem; }
  .subscription-steps li::marker { color: var(--color-primary); font-family: var(--font-utility); font-weight: 800; }
  .subscription-steps strong, .subscription-steps li span { display: block; }
  .subscription-steps li span, .steps-note { color: var(--color-muted); font-size: var(--text-sm); }
  .steps-note { padding-block-start: 1rem; margin: 1.25rem 0 0; border-block-start: 1px solid var(--color-line); }
  .release-history { margin-block: 3rem; }
  .release-history > header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; margin-block-end: 1.25rem; }
  .release-history h2 { margin: 0; font-family: var(--font-display); font-size: var(--title-section); }
  .release-list { padding: 0; margin: 0; border-block-start: 1px solid var(--color-line-strong); list-style: none; }
  .release-list > li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; padding-block: 1.5rem; border-block-end: 1px solid var(--color-line); }
  .release-date { color: var(--color-primary); font-family: var(--font-utility); font-size: var(--text-sm); font-weight: 800; white-space: nowrap; }
  .release-list h3 { margin: 0 0 0.75rem; font-family: var(--font-display); font-size: 1.15rem; }
  .release-list ul { display: grid; gap: 0.5rem; margin: 0; padding-inline-start: 1.1rem; color: var(--color-muted); font-size: var(--text-sm); line-height: 1.8; }
  .gkd-maintenance { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-block: 1.5rem; border-block-start: 1px solid var(--color-line-strong); }
  .gkd-maintenance h2 { margin-block-end: 0.5rem; }
  .gkd-maintenance p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  .gkd-maintenance nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .gkd-maintenance a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.35rem; font-size: var(--text-sm); font-weight: 700; }
  @media (max-width: 48rem) {
    .gkd-start { grid-template-columns: minmax(0, 1fr); }
    .subscription-steps { border-inline-start: 0; border-block-start: 1px solid var(--color-line); }
  }
  @media (max-width: 34rem) {
    .release-list > li { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .gkd-maintenance { align-items: flex-start; }
  }
</style>
