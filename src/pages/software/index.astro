---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  softwareKindLabels,
  softwareProjects,
  softwareStatusLabels,
} from '../../data/software'

const isExternal = (href: string) => /^https?:\/\//.test(href)
const kinds = [...new Set(softwareProjects.map((project) => project.kind))]
const statuses = [...new Set(softwareProjects.map((project) => project.status))]
const formatUpdated = (value: string) => value.replace(/-/g, '.')
const searchText = (project: (typeof softwareProjects)[number]) => [
  project.name,
  project.summary,
  softwareKindLabels[project.kind],
  softwareStatusLabels[project.status],
  project.language,
  ...project.tags,
].filter(Boolean).join(' ').toLocaleLowerCase('zh-CN')
---

<BaseLayout
  title="软件园"
  description="Nisconder 做过、正在维护与公开实验的软件项目。"
  comments
  commentsTitle="讨论这些项目"
  commentsDescription="使用问题、功能建议、合作想法，或者你希望我继续做什么，都可以直接留在这里。"
>
  <header class="page-intro software-intro">
    <div class="software-intro__copy">
      <p class="eyebrow">SOFTWARE / GARDEN</p>
      <h1>做出来的东西，<br />都放在这里。</h1>
      <p class="lede">
        从供应链安全工具到 AI 游戏，也包括支撑本站运行的服务。公开代码提供仓库入口，在线服务提供实际地址。
      </p>
    </div>
    <dl class="software-intro__facts" aria-label="软件园概况">
      <div>
        <dt>项目与服务</dt>
        <dd>{softwareProjects.length.toString().padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>主要方向</dt>
        <dd>安全 · 工具 · AI</dd>
      </div>
      <div>
        <dt>数据核对</dt>
        <dd>GitHub · 2026.08.26</dd>
      </div>
    </dl>
  </header>

  <section class="axis-section" data-note="项目" aria-labelledby="software-list-title">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">PROJECT INDEX</p>
        <h2 id="software-list-title">项目与服务</h2>
      </div>
      <p>先看用途，再决定要不要点进仓库。</p>
    </div>

    <form class="software-filter" data-software-filter role="search" aria-controls="software-projects">
      <label class="software-filter__search">
        <span>搜索项目</span>
        <input
          type="search"
          name="q"
          autocomplete="off"
          placeholder="名称、用途或技术栈…"
        />
      </label>
      <label>
        <span>类型</span>
        <select name="kind">
          <option value="">全部类型</option>
          {kinds.map((kind) => <option value={kind}>{softwareKindLabels[kind]}</option>)}
        </select>
      </label>
      <label>
        <span>状态</span>
        <select name="status">
          <option value="">全部状态</option>
          {statuses.map((status) => <option value={status}>{softwareStatusLabels[status]}</option>)}
        </select>
      </label>
      <div class="software-filter__footer">
        <output data-software-count aria-live="polite">显示 {softwareProjects.length} 个项目</output>
        <button type="reset">清除筛选</button>
      </div>
    </form>

    <p class="software-empty" data-software-empty hidden>
      没有匹配项目。<button type="button" data-software-clear>清除筛选</button>
    </p>

    <div id="software-projects" class="software-grid">
      {softwareProjects.map((project) => (
        <article
          class:list={['software-card', project.featured && 'software-card--featured']}
          id={project.slug}
          data-kind={project.kind}
          data-status={project.status}
          data-search={searchText(project)}
        >
          <header class="software-card__head">
            <span class="software-card__mark" aria-hidden="true">{project.label}</span>
            <div>
              <p class="software-card__meta">
                <span>{softwareKindLabels[project.kind]}</span>
                <span>{softwareStatusLabels[project.status]}</span>
                {project.featured && <strong>重点维护</strong>}
              </p>
              <h3>{project.name}</h3>
            </div>
          </header>

          <p class="software-card__summary">{project.summary}</p>

          <dl class="software-card__facts">
            {project.language && <div><dt>语言</dt><dd>{project.language}</dd></div>}
            <div><dt>Stars</dt><dd>{project.stars ?? 0}</dd></div>
            <div><dt>更新</dt><dd><time datetime={project.updatedAt}>{formatUpdated(project.updatedAt)}</time></dd></div>
          </dl>

          <ul class="software-card__tags" aria-label={`${project.name} 技术标签`}>
            {project.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
          </ul>

          <div class="software-card__actions">
            {project.projectUrl && (
              <a
                href={project.projectUrl}
                target={isExternal(project.projectUrl) ? '_blank' : undefined}
                rel={isExternal(project.projectUrl) ? 'noopener noreferrer' : undefined}
              >
                {project.actionLabel ?? (isExternal(project.projectUrl) ? '打开项目' : '查看本站')}
                <span aria-hidden="true">{isExternal(project.projectUrl) ? '↗' : '→'}</span>
              </a>
            )}
            {project.sourceUrl && (
              <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
                源码与说明 <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .software-intro {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.55fr);
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-card);
  }

  .software-intro__copy {
    min-width: 0;
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }

  .software-intro h1 {
    max-width: 16ch;
  }

  .software-intro__facts {
    display: grid;
    align-content: center;
    gap: 0;
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-inline-start: 1px solid var(--color-line-strong);
    background: var(--color-media-soft);
  }

  .software-intro__facts > div {
    padding-block: 1rem;
    border-block-start: 1px solid var(--color-line-strong);
  }

  .software-intro__facts > div:last-child {
    border-block-end: 1px solid var(--color-line-strong);
  }

  .software-intro__facts dt {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    letter-spacing: 0.07em;
  }

  .software-intro__facts dd {
    margin: 0.2rem 0 0;
    color: var(--color-heading);
    font-size: 1rem;
    font-weight: 700;
  }

  .software-filter {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) minmax(9rem, 11rem) minmax(9rem, 11rem);
    gap: 0.75rem;
    margin-block-end: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-surface-soft);
  }

  .software-filter label {
    display: grid;
    align-content: end;
    gap: 0.35rem;
  }

  .software-filter label > span {
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .software-filter input,
  .software-filter select,
  .software-filter button {
    min-height: 3rem;
  }

  .software-filter__footer {
    display: flex;
    min-height: 2.75rem;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-start: 0.5rem;
    border-block-start: 1px solid var(--color-line);
  }

  .software-filter output {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .software-filter button,
  .software-empty button {
    border: 1px solid var(--color-media);
    border-radius: var(--card-radius);
    background: var(--color-media-soft);
    color: var(--color-media);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .software-filter button {
    padding-inline: 1rem;
  }

  .software-empty {
    padding: 1.25rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-card);
    color: var(--color-muted);
    text-align: center;
  }

  .software-empty button {
    min-height: 2.75rem;
    margin-inline-start: 0.5rem;
    padding-inline: 0.75rem;
  }

  .software-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 1rem;
  }

  .software-card {
    --project-accent: var(--color-line-strong);
    display: flex;
    min-width: 0;
    min-height: 18rem;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--color-line-strong);
    border-block-start: 0.4rem solid var(--project-accent);
    border-radius: var(--card-radius);
    background: var(--color-card);
  }

  .software-card[hidden] {
    display: none;
  }

  .software-card[data-status='active'] {
    --project-accent: var(--color-reading);
  }

  .software-card[data-status='experimental'] {
    --project-accent: var(--color-media);
  }

  .software-card--featured {
    min-height: 0;
    grid-column: 1 / -1;
    background: var(--color-reading-soft);
  }

  .software-card__head {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .software-card__mark {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--card-radius);
    background: var(--color-media-panel);
    color: var(--color-on-media-panel);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .software-card[data-status='active'] .software-card__mark {
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
  }

  .software-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.65rem;
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .software-card__meta strong {
    color: var(--color-reading);
  }

  .software-card h3 {
    margin: 0.1rem 0 0;
    font-size: var(--title-card);
    overflow-wrap: anywhere;
  }

  .software-card__summary {
    margin-block: 1rem;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .software-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    margin: 0 0 1rem;
    padding-block: 0.7rem;
    border-block: 1px solid var(--color-line);
  }

  .software-card__facts > div {
    display: flex;
    gap: 0.35rem;
  }

  .software-card__facts dt,
  .software-card__facts dd {
    margin: 0;
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .software-card__facts dt {
    color: var(--color-muted);
  }

  .software-card__facts dd {
    color: var(--color-text);
  }

  .software-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 1rem;
    list-style: none;
  }

  .software-card__tags li {
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--color-line);
    border-radius: var(--card-radius);
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
  }

  .software-card__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: auto;
    border-block-start: 1px solid var(--color-line-strong);
  }

  .software-card__actions a {
    display: inline-flex;
    min-width: 0;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-reading);
    font-size: var(--text-sm);
    font-weight: 750;
    text-decoration: none;
  }

  .software-card__actions a + a {
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--color-line);
    color: var(--color-media);
  }

  .software-card__actions a:only-child {
    grid-column: 1 / -1;
  }

  .software-card__actions a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (min-width: 64rem) {
    .software-card--featured {
      display: grid;
      grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.2fr);
      grid-template-areas:
        "head summary"
        "facts tags"
        "actions actions";
      gap: 1rem 2rem;
      align-items: start;
    }

    .software-card--featured .software-card__head { grid-area: head; }
    .software-card--featured .software-card__summary { grid-area: summary; margin: 0; }
    .software-card--featured .software-card__facts { grid-area: facts; margin: 0; }
    .software-card--featured .software-card__tags { grid-area: tags; margin: 0; }
    .software-card--featured .software-card__actions { grid-area: actions; }
  }

  @media (max-width: 52rem) {
    .software-intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .software-intro__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-block-start: 1px solid var(--color-line-strong);
      border-inline-start: 0;
    }

    .software-intro__facts > div,
    .software-intro__facts > div:last-child {
      padding: 0.75rem;
      border-block: 0;
    }

    .software-intro__facts > div + div {
      border-inline-start: 1px solid var(--color-line-strong);
    }
  }

  @media (max-width: 46rem) {
    .software-filter {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 0.75rem;
    }

    .software-filter__search,
    .software-filter__footer {
      grid-column: 1 / -1;
    }

    .software-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .software-card {
      min-height: 0;
      padding: 1rem;
    }
  }

  @media (max-width: 34rem) {
    .software-intro h1 br {
      display: none;
    }

    .software-intro__facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .software-intro__facts > div + div {
      border-block-start: 1px solid var(--color-line-strong);
      border-inline-start: 0;
    }

  }

  @media (max-width: 22rem) {
    .software-filter {
      grid-template-columns: minmax(0, 1fr);
    }

    .software-filter > * {
      grid-column: 1;
    }
  }
</style>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-software-filter]')
    const cards = [...document.querySelectorAll('#software-projects .software-card')]
    const output = document.querySelector('[data-software-count]')
    const empty = document.querySelector('[data-software-empty]')
    const clear = document.querySelector('[data-software-clear]')
    if (!(form instanceof HTMLFormElement) || !(output instanceof HTMLOutputElement)) return

    const update = () => {
      const data = new FormData(form)
      const query = String(data.get('q') ?? '').trim().toLocaleLowerCase('zh-CN')
      const kind = String(data.get('kind') ?? '')
      const status = String(data.get('status') ?? '')
      let visible = 0

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return
        const matches = (!query || card.dataset.search?.includes(query))
          && (!kind || card.dataset.kind === kind)
          && (!status || card.dataset.status === status)
        card.hidden = !matches
        if (matches) visible += 1
      })

      output.value = `显示 ${visible} 个项目`
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => {
      event.preventDefault()
      update()
    })
    form.addEventListener('reset', () => requestAnimationFrame(update))
    clear?.addEventListener('click', () => {
      form.reset()
      update()
      form.querySelector('input')?.focus()
    })
  })()
</script>
