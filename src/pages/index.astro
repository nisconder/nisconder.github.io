---
import PostRow from '../components/PostRow.astro'
import { featuredSoftware, softwareProjects, softwareStatusLabels } from '../data/software'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPlaylistTracks } from '../lib/playlist'
import {
  formatPostDate,
  getFeaturedPost,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../lib/posts'

const posts = await getPublishedPosts()
const playlist = await getPlaylistTracks()
const playablePlaylist = playlist.filter((track) => track.fee === 0 || track.fee === 8)
const playlistPreview = playablePlaylist.slice(0, 3)
const musicianCount = new Set(
  playlist.flatMap((track) => track.author.split('/').map((artist) => artist.trim()).filter(Boolean)),
).size
const latestPost = posts[0]
const featuredPost = await getFeaturedPost(posts)
const pinnedPost = featuredPost?.id !== latestPost?.id ? featuredPost : undefined
const recentPosts = posts
  .filter((post) => post.id !== latestPost?.id)
  .slice(0, 4)

const topicCounts = new Map<string, number>()
const categoryCounts = new Map<string, number>()
for (const post of posts) {
  const category = getPostCategory(post)
  if (category) categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1)
  for (const tag of getPostTags(post)) {
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1)
  }
}

const categories = [...categoryCounts]
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'))
const topics = [...topicCounts]
  .filter(([, count]) => count >= 2)
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'))
  .slice(0, 8)
const querySeeds = [...topicCounts.keys()].slice(0, 5)

const searchHref = (query: string) => `/search/?q=${encodeURIComponent(query)}`
const categoryHref = (category: string) => `/search/?category=${encodeURIComponent(category)}`
---

<BaseLayout
  title="不知名博客"
  description="Nisconder 的个人博客，记录技术、社会观察、音乐与生活。"
  comments
  commentsTitle="在首页碰个面"
  commentsDescription="第一次来、想打个招呼，或只是想留下此刻想到的一句话，都可以写在这里。"
>
  <header class="home-intro" aria-labelledby="home-title">
    <div class="home-intro__identity">
      <div class="home-intro__profile">
        <img
          src="/img/nisconder-avatar.png"
          width="100"
          height="100"
          alt="Nisconder 的头像"
          decoding="async"
        />
        <div>
          <p class="eyebrow">PERSONAL SITE</p>
          <p class="home-intro__name">Nisconder</p>
        </div>
      </div>
      <p class="home-intro__bio">代码、阅读、音乐与生活观察。<br />认真写字，长期主义。</p>
      <dl class="home-intro__stats" aria-label="站点内容统计">
        <div><dt>文章</dt><dd>{posts.length.toString().padStart(2, '0')}</dd></div>
        <div><dt>项目</dt><dd>{softwareProjects.length.toString().padStart(2, '0')}</dd></div>
        <div><dt>歌单</dt><dd>{playlist.length.toString().padStart(2, '0')}</dd></div>
      </dl>
      <nav class="home-intro__links" aria-label="Nisconder 的个人链接">
        <a href="/about/">关于我</a>
        <a href="https://github.com/nisconder" rel="me noreferrer">GitHub</a>
        <a href="mailto:72447244.wnm@gmail.com">邮箱</a>
      </nav>
    </div>
    <div class="home-intro__copy">
      <p class="eyebrow">OPEN NOTES / BY NISCONDER</p>
      <h1 id="home-title">我写代码，也拆解那些<br />被说得太理所当然的事情。</h1>
      <p class="lede">
        这是 Nisconder 的个人站。这里写技术，也写社会、音乐和生活里那些不太容易被一句话说完的部分。
      </p>
    </div>
  </header>

  <section class="home-feature" id="latest" aria-labelledby="home-feature-title">
    <header class="home-feature__head">
      <div>
        <p class="eyebrow">SITE / INDEX</p>
        <h2 id="home-feature-title">站内一览</h2>
      </div>
      <p>{posts.length} 篇文章 · {softwareProjects.length} 个项目 · {playlist.length} 首歌</p>
    </header>

    <div class="home-card-grid">
      {
        latestPost ? (
          <article class="home-card lead-story">
            <header class="lead-story__band">
              <span>LATEST / ARTICLE</span>
              <div class="lead-story__meta">
                <time datetime={getPostDateTime(latestPost.data.date)}>
                  {formatPostDate(latestPost.data.date)}
                </time>
                {getPostCategory(latestPost) && (
                  <a href={categoryHref(getPostCategory(latestPost)!)}>
                    {getPostCategory(latestPost)}
                  </a>
                )}
              </div>
            </header>
            <div class="lead-story__body">
              <h3><a href={getPostUrl(latestPost)}>{latestPost.data.title}</a></h3>
              <p class="lead-story__summary">{getPostDescription(latestPost)}</p>
              {getPostTags(latestPost).length > 0 && (
                <nav class="lead-story__tags" aria-label="文章标签">
                  {getPostTags(latestPost).slice(0, 3).map((tag) => (
                    <a href={searchHref(tag)}>#{tag}</a>
                  ))}
                </nav>
              )}
              {pinnedPost && (
                <aside class="lead-story__pinned" aria-label="置顶推荐">
                  <div class="lead-story__pinned-label">
                    <span>置顶推荐</span>
                    <time datetime={getPostDateTime(pinnedPost.data.date)}>
                      {formatPostDate(pinnedPost.data.date)}
                    </time>
                  </div>
                  <a href={getPostUrl(pinnedPost)}>
                    <strong>{pinnedPost.data.title}</strong>
                    <span aria-hidden="true">→</span>
                  </a>
                </aside>
              )}
              <div class="lead-story__actions">
                <a class="lead-story__read" href={getPostUrl(latestPost)}>
                  阅读全文 <span aria-hidden="true">→</span>
                </a>
                <a class="lead-story__archive" href="/articles/">全部 {posts.length} 篇</a>
              </div>
            </div>
          </article>
        ) : (
          <div class="home-card lead-story lead-story--empty">
            <p class="card-kicker">WRITING</p>
            <h3>文章正在整理。</h3>
            <a class="lead-story__read" href="/articles/">查看文章页 →</a>
          </div>
        )
      }

      <a class="home-card music-card" href="/music/" aria-labelledby="music-card-title">
          <p class="card-kicker">MUSIC / PLAYLIST</p>
          <h3 id="music-card-title">最近反复播放</h3>
          <p class="music-card__summary">{playlist.length} 首 · {musicianCount} 位音乐人</p>
          <ol class="music-card__tracks" aria-label="歌单中的前三首曲目">
            {playlistPreview.map((track, index) => (
              <li>
                <span>{(index + 1).toString().padStart(2, '0')}</span>
                <span class="music-card__track-copy">
                  <strong>{track.title}</strong>
                  <small>{track.author}</small>
                </span>
              </li>
            ))}
          </ol>
          <span class="home-card__action">打开 {playlist.length} 首歌 <span aria-hidden="true">→</span></span>
      </a>

      <form class="home-card search-card" action="/search/" method="get" role="search">
        <p class="card-kicker">SEARCH</p>
        <h3>站内搜索</h3>
        <label for="home-search">文章、项目、分类或标签</label>
        <div class="search-card__controls">
          <input id="home-search" name="q" type="search" autocomplete="off" placeholder="输入文章、项目、分类或标签…" />
          <button type="submit">搜索站内</button>
        </div>
        {querySeeds.length > 0 && (
          <nav class="search-card__seeds" aria-label="常用搜索标签">
            {querySeeds.map((seed) => <a href={searchHref(seed)}>#{seed}</a>)}
          </nav>
        )}
      </form>

      <a class="home-card software-card" href="/software/" aria-labelledby="software-card-title">
        <p class="card-kicker">SOFTWARE / GARDEN</p>
        <div class="software-card__lead">
          <span aria-hidden="true">{featuredSoftware.label}</span>
          <div>
            <small>{softwareStatusLabels[featuredSoftware.status]}</small>
            <strong>{featuredSoftware.name}</strong>
          </div>
        </div>
        <h3 id="software-card-title">我做的软件</h3>
        <p>{featuredSoftware.summary}</p>
        <span class="home-card__action">查看 {softwareProjects.length} 个项目 <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  {categories.length > 0 && (
    <section class="axis-section home-category-section" data-note="分类">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">BROWSE / CATEGORY</p>
          <h2>按分类进入</h2>
        </div>
        <p class="section-aside">先选择一条明确的路径，再继续搜索或阅读。</p>
      </div>

      <nav class="home-category-field" aria-label="文章分类">
        {categories.map(([category, count], index) => (
          <a href={categoryHref(category)} data-tone={index % 2 === 0 ? 'reading' : 'media'}>
            <span>
              <strong>{category}</strong>
              <small>{count} 篇文章</small>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </nav>
    </section>
  )}

  {topics.length >= 3 && (
    <section class="axis-section topic-section" data-note="词语">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">INDEX</p>
          <h2>反复出现的词</h2>
        </div>
        <p class="section-aside">它们会在不同文章里重逢。</p>
      </div>

      <ul class="topic-field" aria-label="文章主题">
        {topics.map(([topic, count]) => (
          <li>
            <a href={searchHref(topic)}>
              <span>{topic}</span>
              <small>{count} 篇</small>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="axis-section" data-note="更新">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">LATEST</p>
          <h2>最近更新</h2>
        </div>
        <a class="text-link" href="/articles/">全部文章 →</a>
      </div>

      <div class="post-list">
        {recentPosts.map((post) => (
          <PostRow
            href={getPostUrl(post)}
            title={post.data.title}
            description={getPostDescription(post)}
            date={formatPostDate(post.data.date)}
            datetime={getPostDateTime(post.data.date)}
            category={getPostCategory(post)}
            tags={getPostTags(post)}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(16rem, 0.58fr) minmax(0, 1.42fr);
    overflow: hidden;
    margin-block-end: clamp(2.5rem, 5vw, 3.75rem);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
  }

  .home-intro__identity,
  .home-intro__copy {
    min-width: 0;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .home-intro__identity {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 1.5rem;
    border-inline-end: 1px solid var(--color-line-strong);
    background: var(--color-media-soft);
  }

  .home-intro__profile {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .home-intro__profile img {
    width: 5.25rem;
    height: 5.25rem;
    flex: 0 0 auto;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    object-fit: cover;
  }

  .home-intro__name {
    margin: 0.2rem 0 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .home-intro__bio {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .home-intro__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-block: 1px solid var(--color-line-strong);
  }

  .home-intro__stats > div {
    display: flex;
    min-width: 0;
    flex-direction: column-reverse;
    padding-block: 0.75rem;
  }

  .home-intro__stats > div + div {
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--color-line-strong);
  }

  .home-intro__stats dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .home-intro__stats dd {
    margin: 0;
    color: var(--color-media);
    font-family: var(--font-utility);
    font-size: 1rem;
    font-weight: 800;
  }

  .home-intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-block-start: auto;
  }

  .home-intro__links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-reading);
    font-size: 0.78rem;
    font-weight: 750;
    text-underline-offset: 0.24em;
  }

  .home-intro__copy {
    background: var(--color-card);
  }

  .home-intro h1 {
    max-width: 18ch;
    margin-block-start: clamp(1rem, 2vw, 1.75rem);
    margin-block-end: 0;
    font-family: var(--font-editorial);
    font-size: var(--title-page);
    line-height: 1.18;
  }

  .home-intro .lede {
    max-width: 35rem;
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
    margin-block-end: 0;
  }

  .home-feature {
    margin-block-end: 0;
  }

  .section-head {
    max-width: var(--content-width);
  }

  .text-link {
    flex: none;
    min-height: 2.75rem;
    padding-block: 0.55rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .lead-story {
    border: 1px solid var(--color-line-strong);
    background: var(--color-card);
  }

  .lead-story__band {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.75rem clamp(1.25rem, 3vw, 2rem);
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .lead-story__body {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .lead-story__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin: 0;
  }

  .lead-story__meta a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
  }

  .lead-story__summary {
    max-width: 34rem;
    margin-block-end: 1rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  .lead-story__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-block-start: 1rem;
  }

  .lead-story__tags a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .lead-story--empty {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .home-feature__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block-end: clamp(1.25rem, 3vw, 2rem);
  }

  .home-feature__head h2 {
    margin: 0.25rem 0 0;
    font-size: var(--title-section);
    letter-spacing: -0.025em;
  }

  .home-feature__head > p {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.75rem;
    text-align: end;
  }

  .home-card-grid {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    isolation: isolate;
    gap: clamp(1rem, 2.4vw, 1.75rem);
  }

  .home-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-card);
  }

  a.home-card {
    color: var(--color-text);
    text-decoration: none;
  }

  a.home-card:hover,
  a.home-card:focus-visible,
  .home-card:focus-within {
    border-color: var(--color-reading);
  }

  .home-card:focus-within {
    z-index: 10;
    outline: 3px solid var(--color-media);
    outline-offset: 3px;
  }

  .card-kicker {
    margin: 0 0 1.25rem;
    color: var(--color-media);
    font-family: var(--font-utility);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.07em;
  }

  .home-card h3 {
    margin-block-end: 0.75rem;
    font-size: var(--title-card);
    letter-spacing: -0.025em;
  }

  .home-card__action {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: auto;
    border-block-start: 1px solid currentColor;
    font-size: 0.875rem;
    font-weight: 750;
  }

  .lead-story {
    display: grid;
    grid-column: 1;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .lead-story__band {
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
  }

  .lead-story__band a:focus-visible {
    outline-color: var(--color-on-reading-panel);
  }

  .lead-story__body {
    display: flex;
    flex-direction: column;
  }

  .lead-story h3 {
    max-width: 19ch;
    margin-block-end: 1.1rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.8rem, 3.4vw, 2.35rem);
    line-height: 1.22;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .lead-story h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .lead-story h3 a:hover,
  .lead-story h3 a:focus-visible {
    color: var(--color-reading);
    text-decoration: underline;
    text-decoration-color: var(--color-media);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .lead-story__tags a {
    color: var(--color-media);
  }

  .lead-story__pinned {
    display: grid;
    gap: 0.55rem;
    margin-block-start: 1.35rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-line-strong);
    border-inline-start: 0.35rem solid var(--color-secondary);
    border-radius: var(--card-radius);
    background: var(--color-secondary-soft);
  }

  .lead-story__pinned-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    color: var(--color-secondary);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.05em;
  }

  .lead-story__pinned a {
    display: grid;
    min-height: 2.75rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .lead-story__pinned strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .lead-story__pinned a > span {
    color: var(--color-secondary);
    font-size: 1.1rem;
    font-weight: 800;
  }

  .lead-story__pinned a:hover strong,
  .lead-story__pinned a:focus-visible strong {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .lead-story__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-block-start: auto;
    padding-block-start: clamp(1.5rem, 3vw, 2.25rem);
  }

  .lead-story__read,
  .lead-story__archive {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    color: var(--color-reading);
    font-size: 0.875rem;
    font-weight: 750;
  }

  .lead-story__read {
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    border-block: 1px solid var(--color-line-strong);
    text-decoration: none;
  }

  .lead-story__archive {
    justify-content: center;
    padding-inline: 0.25rem;
    color: var(--color-media);
    text-underline-offset: 0.25em;
  }

  .lead-story--empty {
    display: flex;
    grid-column: 1;
    flex-direction: column;
  }

  a.music-card {
    display: flex;
    grid-column: 1;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-color: var(--color-media-panel);
    background: var(--color-media-panel);
    color: var(--color-on-media-panel);
  }

  a.music-card:hover,
  a.music-card:focus-visible {
    border-color: var(--color-reading);
    color: var(--color-on-media-panel);
  }

  .music-card .card-kicker,
  .music-card h3 {
    color: inherit;
  }

  .music-card__summary {
    margin-block-end: 1rem;
    color: inherit;
    font-size: var(--text-sm);
  }

  .music-card__tracks {
    padding: 0;
