---
import { featuredSoftware, softwareProjects, softwareStatusLabels } from '../data/software'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPlaylistTracks, isPlayableTrack } from '../lib/playlist'
import {
  formatPostDate,
  getPinnedPost,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostReadingMinutes,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../lib/posts'

const posts = await getPublishedPosts()
const playlist = await getPlaylistTracks()
const playableTracks = playlist.filter(isPlayableTrack)
const playlistPreview = (playableTracks.length > 0 ? playableTracks : playlist).slice(0, 3)
const musicianCount = new Set(
  playlist.flatMap((track) => track.author.split('/').map((artist) => artist.trim()).filter(Boolean)),
).size

const latestPost = posts[0]
const featuredPost = await getPinnedPost(posts)
const pinnedPost = featuredPost?.id !== latestPost?.id ? featuredPost : undefined

const topicCounts = new Map<string, number>()
for (const post of posts) {
  for (const tag of getPostTags(post)) {
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1)
  }
}

const querySeeds = [...topicCounts]
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'))
  .slice(0, 3)
  .map(([name]) => name)

const searchHref = (query: string) => `/search/?q=${encodeURIComponent(query)}`
const categoryHref = (category: string) => `/search/?category=${encodeURIComponent(category)}`
---

<BaseLayout
  title="Nisconder"
  description="Nisconder 的个人站：技术文章、个人项目、阅读与音乐记录。"
  comments
  commentsTitle="在首页留言"
  commentsDescription="站点建议、想讨论的话题，或简单打个招呼，都可以写在这里。"
>
  <header class="home-dashboard" aria-labelledby="home-title">
    <section class="identity-panel register-panel">
      <span class="registration-mark" aria-hidden="true"><i></i><i></i></span>
      <div class="identity-panel__profile">
        <img
          src="/img/nisconder-avatar.png"
          width="104"
          height="104"
          alt="Nisconder 的头像"
          decoding="async"
        />
        <div>
          <p class="eyebrow"><span lang="zh-Hant">個人索引</span> / PERSONAL INDEX</p>
          <h1 id="home-title">Nisconder</h1>
        </div>
      </div>

      <p class="identity-panel__bio">技术文章、个人项目、阅读与音乐记录。</p>

      <dl class="identity-panel__stats" aria-label="站点内容统计">
        <div><dt>文章</dt><dd>{posts.length.toString().padStart(2, '0')}</dd></div>
        <div><dt>项目</dt><dd>{softwareProjects.length.toString().padStart(2, '0')}</dd></div>
        <div><dt>歌曲</dt><dd>{playlist.length.toString().padStart(2, '0')}</dd></div>
      </dl>

      <nav class="identity-panel__links" aria-label="Nisconder 的个人链接">
        <a href="/about/">关于我</a>
        <a href="https://github.com/nisconder" rel="me noreferrer">GitHub</a>
        <a href="mailto:72447244.wnm@gmail.com">邮箱</a>
      </nav>
    </section>

    {
      latestPost ? (
        <article class="latest-panel register-panel">
          <span class="registration-mark" aria-hidden="true"><i></i><i></i></span>
          <header class="latest-panel__meta">
            <span>最新文章</span>
            <div>
              <time datetime={getPostDateTime(latestPost.data.date)}>
                {formatPostDate(latestPost.data.date)}
              </time>
              <span>约 {getPostReadingMinutes(latestPost)} 分钟</span>
              {getPostCategory(latestPost) && (
                <a href={categoryHref(getPostCategory(latestPost)!)}>{getPostCategory(latestPost)}</a>
              )}
            </div>
          </header>

          <div class="latest-panel__body">
            <h2><a href={getPostUrl(latestPost)}>{latestPost.data.title}</a></h2>
            <p>{getPostDescription(latestPost)}</p>

            {getPostTags(latestPost).length > 0 && (
              <nav class="latest-panel__tags" aria-label="最新文章标签">
                {getPostTags(latestPost).slice(0, 4).map((tag) => (
                  <a href={searchHref(tag)}>#{tag}</a>
                ))}
              </nav>
            )}

            {pinnedPost && (
              <aside class="latest-panel__pinned" aria-label="置顶推荐">
                <span>置顶</span>
                <a href={getPostUrl(pinnedPost)}>{pinnedPost.data.title}</a>
                <time datetime={getPostDateTime(pinnedPost.data.date)}>
                  {formatPostDate(pinnedPost.data.date)}
                </time>
              </aside>
            )}

            <div class="latest-panel__actions">
              <a class="primary-link" href={getPostUrl(latestPost)}>
                阅读文章 <span aria-hidden="true">→</span>
              </a>
              <a class="quiet-link" href="/articles/">全部 {posts.length} 篇</a>
            </div>
          </div>
        </article>
      ) : (
        <section class="latest-panel latest-panel--empty register-panel">
          <p class="eyebrow">最新文章</p>
          <h2>文章正在整理</h2>
          <a class="primary-link" href="/articles/">查看文章页 →</a>
        </section>
      )
    }
  </header>

  <section class="home-secondary" aria-label="项目与音乐">
    <a class="project-panel register-panel" href={`/software/#${featuredSoftware.slug}`}>
      <div class="project-panel__topline">
        <p class="eyebrow">项目 / PROJECTS</p>
        <span>{softwareStatusLabels[featuredSoftware.status]}</span>
      </div>
      <div class="project-panel__featured">
        <span aria-hidden="true">{featuredSoftware.label}</span>
        <div>
          <small>最近维护</small>
          <strong>{featuredSoftware.name}</strong>
        </div>
      </div>
      <h2>项目与工具</h2>
      <p>{featuredSoftware.summary}</p>
      <span class="panel-action">从 {featuredSoftware.name} 进入项目页 <i aria-hidden="true">→</i></span>
    </a>

    <a class="music-panel register-panel" href="/music/">
      <div class="music-panel__topline">
        <p class="eyebrow">音乐 / PLAYLIST</p>
        <span>{playableTracks.length} 首可试听</span>
      </div>
      <h2>最近反复播放</h2>
      <p>{playlist.length} 首 · {musicianCount} 位音乐人</p>
      <ol aria-label="歌单预览">
        {playlistPreview.map((track, index) => (
          <li>
            <span>{(index + 1).toString().padStart(2, '0')}</span>
            <span>
              <strong>{track.title}</strong>
              <small>{track.author}</small>
            </span>
          </li>
        ))}
      </ol>
      <span class="panel-action">打开音乐页 <i aria-hidden="true">→</i></span>
    </a>
  </section>

  <section class="home-search register-panel" aria-labelledby="home-search-title">
    <div class="home-search__intro">
      <p class="eyebrow">查找 / SEARCH</p>
      <h2 id="home-search-title">搜索本站</h2>
      <p>直接检索文章正文、项目、分类与标签。</p>
    </div>
    <form class="home-search__form" action="/search/" method="get" role="search">
      <label for="home-search-input">搜索本站</label>
      <div class="home-search__controls">
        <input
          id="home-search-input"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="例如：npm-safe、社会学、TypeScript"
        />
        <button type="submit">搜索</button>
      </div>
      {querySeeds.length > 0 && (
        <nav class="home-search__seeds" aria-label="常用搜索标签">
          {querySeeds.map((seed) => <a href={searchHref(seed)}>#{seed}</a>)}
        </nav>
      )}
    </form>
  </section>
</BaseLayout>

<style>
  .register-panel {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-card);
  }

  .register-panel::before,
  .register-panel::after {
    position: absolute;
    z-index: 1;
    content: '';
    pointer-events: none;
  }

  .register-panel::before {
    inset: 0 auto auto 0;
    width: 42%;
    height: 0.32rem;
    background: var(--color-primary);
  }

  .register-panel::after {
    inset: 0 0 auto auto;
    width: 24%;
    height: 0.32rem;
    background: var(--color-secondary);
  }

  .registration-mark {
    position: absolute;
    z-index: 2;
    inset-block-start: 1.25rem;
    inset-inline-end: 1.25rem;
    width: 1.8rem;
    height: 1.65rem;
    pointer-events: none;
  }

  .registration-mark i {
    position: absolute;
    display: block;
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .registration-mark i:first-child {
    inset: 0 auto auto 0;
    background: var(--color-primary);
  }

  .registration-mark i:last-child {
    inset: auto 0 0 auto;
    background: var(--color-secondary);
  }

  .register-panel:hover .registration-mark i:first-child {
    transform: translate(-2px, -2px);
  }

  .register-panel:hover .registration-mark i:last-child {
    transform: translate(2px, 2px);
  }

  .home-dashboard {
    display: grid;
    grid-template-columns: minmax(17.5rem, 0.72fr) minmax(0, 1.28fr);
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .identity-panel,
  .latest-panel {
    min-height: 28rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .identity-panel {
    display: flex;
    flex-direction: column;
    background: var(--color-secondary-soft);
  }

  .identity-panel::before {
    width: 28%;
    background: var(--color-secondary);
  }

  .identity-panel::after {
    width: 48%;
    background: var(--color-primary);
  }

  .identity-panel__profile {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline-end: 2.25rem;
  }

  .identity-panel__profile img {
    width: 5.5rem;
    height: 5.5rem;
    flex: 0 0 auto;
    border: 1px solid var(--color-line-strong);
    border-radius: calc(var(--card-radius) - 0.15rem);
    object-fit: cover;
  }

  .identity-panel h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    letter-spacing: -0.035em;
  }

  .identity-panel .eyebrow {
    margin-block-end: 0.25rem;
  }

  .identity-panel__bio {
    max-width: 24ch;
    margin: 2rem 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .identity-panel__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-block: 1px solid var(--color-line-strong);
  }

  .identity-panel__stats div {
    display: flex;
    min-width: 0;
    flex-direction: column-reverse;
    padding: 0.8rem 0;
  }

  .identity-panel__stats div + div {
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--color-line-strong);
  }

  .identity-panel__stats dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .identity-panel__stats dd {
    margin: 0;
    color: var(--color-secondary);
    font-family: var(--font-utility);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .identity-panel__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-block-start: auto;
    padding-block-start: 1.25rem;
  }

  .identity-panel__links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .latest-panel {
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .latest-panel__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.2rem;
    padding: 1rem 4rem 1rem clamp(1.5rem, 3vw, 2.25rem);
    border-block-end: 1px solid var(--color-line-strong);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .latest-panel__meta > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 0.8rem;
    color: var(--color-muted);
    font-weight: 650;
    letter-spacing: 0;
  }

  .latest-panel__meta a {
    color: var(--color-secondary);
  }

  .latest-panel__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 2.6rem);
  }

  .latest-panel h2 {
    max-width: 18ch;
    margin: 0 0 1rem;
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4.2vw, 3.35rem);
    font-weight: 650;
    line-height: 1.17;
    letter-spacing: -0.035em;
  }

  .latest-panel h2 a {
    color: var(--color-heading);
    text-decoration: none;
  }

  .latest-panel h2 a:hover {
    color: var(--color-primary);
  }

  .latest-panel__body > p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .latest-panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.8rem;
    margin-block-start: 1rem;
  }

  .latest-panel__tags a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .latest-panel__pinned {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: auto;
    padding: 0.85rem 0;
    border-block: 1px solid var(--color-line);
    font-size: 0.82rem;
  }

  .latest-panel__pinned > span {
    color: var(--color-secondary);
    font-family: var(--font-utility);
    font-weight: 800;
  }

  .latest-panel__pinned a {
    min-width: 0;
    overflow: hidden;
    color: var(--color-text);
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-panel__pinned time {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
  }

  .latest-panel__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 1rem;
  }

  .primary-link,
  .quiet-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 750;
  }

  .primary-link {
    gap: 1rem;
    color: var(--color-primary);
    text-decoration: none;
  }

  .primary-link span {
    color: var(--color-secondary);
    transition: transform 180ms ease;
  }

  .primary-link:hover span {
    transform: translateX(0.3rem);
  }

  .quiet-link {
    color: var(--color-secondary);
  }

  .latest-panel--empty {
    justify-content: center;
  }

  .home-search {
    display: grid;
    grid-template-columns: minmax(14rem, 0.42fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-block-start: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--color-primary-soft);
  }

  .home-search__intro h2,
  .project-panel h2,
  .music-panel h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    letter-spacing: -0.025em;
  }

  .home-search__intro > p:last-child,
  .project-panel > p,
  .music-panel > p {
    margin: 0.45rem 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .home-search__form label {
    display: block;
    margin-block-end: 0.45rem;
  }

  .home-search__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem;
  }

  .home-search__controls input,
  .home-search__controls button {
    min-height: 3.25rem;
  }

  .home-search__controls input {
    padding-inline: 1rem;
    background: var(--color-card);
  }

  .home-search__controls button {
    min-width: 7rem;
    padding-inline: 1.25rem;
    border: 1px solid var(--color-primary);
    border-inline-end: 0.28rem solid var(--color-secondary);
    border-radius: var(--card-radius);
    background: var(--color-primary);
    color: var(--color-on-primary);
    cursor: pointer;
    font-weight: 800;
  }

  .home-search__controls button:hover {
    border-color: var(--color-secondary);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .home-search__seeds {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-block-start: 0.55rem;
  }

  .home-search__seeds a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    color: var(--color-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .home-secondary {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(18rem, 0.82fr);
    gap: 1rem;
  }

  .project-panel,
  .music-panel {
    display: flex;
    min-height: 23rem;
    flex-direction: column;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    color: var(--color-text);
    text-decoration: none;
  }

  .project-panel__topline,
  .music-panel__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1.6rem;
  }

  .project-panel__topline .eyebrow,
  .music-panel__topline .eyebrow {
    margin: 0;
  }

  .project-panel__topline > span,
  .music-panel__topline > span {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
  }

  .project-panel__featured {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-block-end: 1.8rem;
  }

  .project-panel__featured > span {
    display: grid;
    width: 3.6rem;
    height: 3.6rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: calc(var(--card-radius) - 0.1rem);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 900;
  }

  .project-panel__featured div {
    display: grid;
  }

  .project-panel__featured small {
    color: var(--color-muted);
  }

  .project-panel__featured strong {
    font-size: 1.1rem;
  }

  .music-panel {
    background: var(--color-secondary-soft);
  }

  .music-panel ol {
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }

  .music-panel li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.65rem 0;
    border-block-start: 1px solid var(--color-line-strong);
  }

  .music-panel li > span:first-child {
    color: var(--color-secondary);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .music-panel li > span:last-child {
    display: grid;
    min-width: 0;
  }

  .music-panel li strong,
  .music-panel li small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .music-panel li small {
    color: var(--color-muted);
  }

  .panel-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    margin-block-start: auto;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--color-line-strong);
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .panel-action i {
    color: var(--color-secondary);
    font-style: normal;
    transition: transform 180ms ease;
  }

  .project-panel:hover .panel-action i,
  .music-panel:hover .panel-action i {
    transform: translateX(0.3rem);
  }

  @media (max-width: 52rem) {
    .home-dashboard,
    .home-secondary {
      grid-template-columns: minmax(0, 1fr);
    }

    .identity-panel,
    .latest-panel,
    .project-panel,
    .music-panel {
      min-height: 0;
    }

    .identity-panel__bio {
      max-width: none;
    }

    .home-search {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 40rem) {
    .home-dashboard,
    .home-secondary {
      gap: 0.75rem;
    }

    .identity-panel,
    .latest-panel__body,
    .home-search,
    .project-panel,
    .music-panel {
      padding: 1.25rem;
    }

    .identity-panel__profile {
      padding-inline-end: 1.5rem;
    }

    .identity-panel__profile img {
      width: 4.6rem;
      height: 4.6rem;
    }

    .latest-panel__meta {
      align-items: flex-start;
      flex-direction: column;
      padding: 1rem 3.5rem 1rem 1.25rem;
    }

    .latest-panel__meta > div {
      justify-content: flex-start;
    }

    .latest-panel h2 {
      font-size: clamp(1.75rem, 8.5vw, 2.35rem);
    }

    .latest-panel__pinned {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .latest-panel__pinned time {
      display: none;
    }

    .home-search__controls {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-search__controls button {
      width: 100%;
    }

  }

  @media (max-width: 26rem) {
