---
import PostRow from '../components/PostRow.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPlaylistTracks } from '../lib/playlist'
import {
  formatPostDate,
  getFeaturedPost,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../lib/posts'

const posts = await getPublishedPosts()
const playlist = await getPlaylistTracks()
const playlistPreview = playlist.slice(0, 3)
const featuredPost = await getFeaturedPost(posts)
const recentPosts = posts
  .filter((post) => post.id !== featuredPost?.id)
  .slice(0, 4)

const topicCounts = new Map<string, number>()
for (const post of posts) {
  for (const tag of getPostTags(post)) {
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1)
  }
}

const topics = [...topicCounts]
  .filter(([, count]) => count >= 2)
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'))
  .slice(0, 8)

const searchHref = (query: string) => `/search/?q=${encodeURIComponent(query)}`
---

<BaseLayout
  title="不知名博客"
  description="Nisconder 的个人博客，记录技术、社会观察、音乐与生活。"
>
  <header class="home-intro" aria-labelledby="home-title">
    <div class="home-intro__identity">
      <p class="eyebrow">NISCONDER</p>
      <p>{posts.length.toString().padStart(2, '0')} 篇公开文章</p>
    </div>
    <div class="home-intro__copy">
      <p class="eyebrow">OPEN NOTES</p>
      <h1 id="home-title">写代码，也拆解那些<br />被说得太理所当然的事情。</h1>
      <p class="lede">
        这里写技术，也写社会、音乐和生活里那些不太容易被一句话说完的部分。
      </p>
    </div>
  </header>

  <section class="home-feature" id="latest" aria-label="最新内容">
    <div class="editorial-splice">
      {
        featuredPost ? (
          <article class="lead-story">
            <header class="lead-story__band">
              <span>LATEST ARTICLE</span>
              <div class="lead-story__meta">
                <time datetime={getPostDateTime(featuredPost.data.date)}>
                  {formatPostDate(featuredPost.data.date)}
                </time>
                {getPostCategory(featuredPost) && (
                  <a href={searchHref(getPostCategory(featuredPost)!)}>
                    {getPostCategory(featuredPost)}
                  </a>
                )}
              </div>
            </header>
            <div class="lead-story__body">
              <h2><a href={getPostUrl(featuredPost)}>{featuredPost.data.title}</a></h2>
              <p class="lead-story__summary">{getPostDescription(featuredPost)}</p>
              {getPostTags(featuredPost).length > 0 && (
                <nav class="lead-story__tags" aria-label="文章标签">
                  {getPostTags(featuredPost).map((tag) => (
                    <a href={searchHref(tag)}>#{tag}</a>
                  ))}
                </nav>
              )}
              <a class="lead-story__read" href={getPostUrl(featuredPost)}>
                阅读全文 <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ) : (
          <div class="lead-story lead-story--empty">
            <p class="lead-story__meta">WRITING</p>
            <h2>文章正在整理。</h2>
            <a class="lead-story__read" href="/articles/">查看文章页 →</a>
          </div>
        )
      }

      <div class="home-branches">
        <aside class="side-notes" aria-labelledby="side-notes-title">
          <p class="side-notes__label">NETEASE / PLAYLIST</p>
          <h2 id="side-notes-title">最近反复播放</h2>
          <ol class="side-notes__tracks" aria-label="歌单中的前三首曲目">
            {playlistPreview.map((track, index) => (
              <li>
                <span>{(index + 1).toString().padStart(2, '0')}</span>
                <strong>{track.title}</strong>
              </li>
            ))}
          </ol>
          <a class="side-notes__main" href="/music/">打开 {playlist.length} 首歌 <span aria-hidden="true">→</span></a>
        </aside>

        <aside class="about-note" aria-labelledby="about-note-title">
          <p class="about-note__label">ABOUT</p>
          <h2 id="about-note-title">本站与我</h2>
          <p>这里为什么存在，以及我还在关注什么。</p>
          <a href="/about/">关于 Nisconder <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    </div>
  </section>

  {topics.length >= 3 && (
    <section class="axis-section topic-section" data-note="词语">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">INDEX</p>
          <h2>反复出现的词</h2>
        </div>
        <p class="section-aside">它们会在不同文章里重逢。</p>
      </div>

      <ul class="topic-field" aria-label="文章主题">
        {topics.map(([topic, count]) => (
          <li>
            <a href={searchHref(topic)}>
              <span>{topic}</span>
              <small>{count} 篇</small>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="axis-section" data-note="更新">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">LATEST</p>
          <h2>最近更新</h2>
        </div>
        <a class="text-link" href="/articles/">全部文章 →</a>
      </div>

      <div class="post-list">
        {recentPosts.map((post) => (
          <PostRow
            href={getPostUrl(post)}
            title={post.data.title}
            description={getPostDescription(post)}
            date={formatPostDate(post.data.date)}
            datetime={getPostDateTime(post.data.date)}
            category={getPostCategory(post)}
            tags={getPostTags(post)}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1.68fr);
    margin-block-end: clamp(2.75rem, 6vw, 4.5rem);
    border: 1px solid var(--color-line-strong);
  }

  .home-intro__identity,
  .home-intro__copy {
    min-width: 0;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .home-intro__identity {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    border-inline-end: 1px solid var(--color-line-strong);
    background: var(--color-primary-soft);
  }

  .home-intro__identity p:last-child {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .home-intro__copy {
    background: var(--color-surface);
  }

  .home-intro h1 {
    max-width: 18ch;
    margin-block-start: clamp(1rem, 2vw, 1.75rem);
    margin-block-end: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 4.2vw, 3rem);
    line-height: 1.18;
  }

  .home-intro .lede {
    max-width: 35rem;
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
    margin-block-end: 0;
  }

  .home-feature {
    margin-block-end: clamp(3rem, 6vw, 5rem);
  }

  .section-head {
    max-width: var(--content-width);
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-head h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.025em;
  }

  .section-head--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .text-link {
    flex: none;
    min-height: 2.75rem;
    padding-block: 0.55rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .editorial-splice {
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(17rem, 0.72fr);
    align-items: start;
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .lead-story,
  .home-branches,
  .side-notes,
  .about-note {
    min-width: 0;
  }

  .home-branches {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .lead-story {
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
  }

  .lead-story__band {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.75rem clamp(1.25rem, 3vw, 2rem);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-utility);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .lead-story__body {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .lead-story__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin: 0;
  }

  .lead-story__meta a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
  }

  .lead-story h2 {
    max-width: 18ch;
    margin-block-end: 1.25rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.85rem, 3.4vw, 2.55rem);
    line-height: 1.22;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .lead-story h2 a {
    color: inherit;
    text-decoration: none;
  }

  .lead-story h2 a:hover,
  .lead-story h2 a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .lead-story__summary {
    max-width: 34rem;
    margin-block-end: 1rem;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .lead-story__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-block-start: 1rem;
  }

  .lead-story__tags a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .lead-story__read {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: clamp(1.75rem, 4vw, 3rem);
    border-block-start: 1px solid var(--color-line-strong);
    color: var(--color-primary);
    font-weight: 750;
    text-decoration: none;
  }

  .lead-story__read:hover,
  .lead-story__read:focus-visible,
  .side-notes__main:hover,
  .side-notes__main:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .lead-story--empty h2 {
    margin-block-end: 2rem;
  }

  .lead-story--empty {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .side-notes {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    align-content: stretch;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--color-secondary);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .about-note {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    padding: clamp(1.35rem, 3vw, 1.75rem);
    border: 1px solid var(--color-line-strong);
    border-inline-start: 0.45rem solid var(--color-primary);
    background: var(--color-primary-soft);
    color: var(--color-text);
  }

  .side-notes__label,
  .about-note__label {
    margin: 0 0 1.5rem;
    font-family: var(--font-utility);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
  }

  .side-notes h2,
  .about-note h2 {
    max-width: 12ch;
    margin-block-end: 0.75rem;
    color: inherit;
    font-size: clamp(1.45rem, 2.5vw, 1.8rem);
    letter-spacing: -0.025em;
  }

  .side-notes__tracks {
    padding: 0;
    margin: 0.5rem 0 1.25rem;
    list-style: none;
  }

  .side-notes__tracks li {
    display: grid;
    min-height: 2.75rem;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
    border-block-start: 1px solid color-mix(in srgb, currentColor, transparent 50%);
  }

  .side-notes__tracks span {
    font-family: var(--font-utility);
    font-size: 0.65rem;
  }

  .side-notes__tracks strong {
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .about-note > p:not(.about-note__label) {
    margin-block-end: 1.25rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .side-notes a {
    color: inherit;
    font-weight: 700;
  }

  .side-notes__main {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    align-self: end;
    border-block: 1px solid currentColor;
    text-decoration: none;
  }

  .about-note a {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    align-self: end;
    border-block: 1px solid var(--color-line-strong);
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .about-note a:hover,
  .about-note a:focus-visible {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .editorial-splice a:focus-visible {
    outline-color: currentColor;
  }

  .section-aside {
    max-width: 17rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .topic-field {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .topic-field li {
    grid-column: 1 / span 7;
  }

  .topic-field li:nth-child(2n) {
    grid-column: 7 / span 6;
  }

  .topic-field li:nth-child(3n) {
    grid-column: 3 / span 7;
  }

  .topic-field li:nth-child(4n) {
    grid-column: 8 / span 5;
  }

  .topic-field a {
    display: flex;
    min-height: 4.5rem;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-block-end: 1px solid var(--color-line-strong);
    color: var(--color-text);
    text-decoration: none;
  }

  .topic-field span {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.5vw, 1.8rem);
  }

  .topic-field small {
    color: var(--color-muted);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .topic-field a:hover span,
  .topic-field a:focus-visible span {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 42rem) {
    .home-intro {
      grid-template-columns: 1fr;
    }

    .home-intro__identity {
      min-height: auto;
      align-items: center;
      flex-direction: row;
      gap: 1rem;
      border-block-end: 1px solid var(--color-line-strong);
      border-inline-end: 0;
    }

    .home-intro h1 br {
      display: none;
    }

    .section-head--split {
      display: block;
    }

    .text-link,
    .section-aside {
      display: inline-block;
      margin-block-start: 0.75rem;
    }

    .editorial-splice {
      grid-template-columns: 1fr;
    }

    .lead-story {
      border-inline-end: 1px solid var(--color-line-strong);
    }

    .home-branches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .topic-field {
      grid-template-columns: 1fr;
    }

    .topic-field li,
    .topic-field li:nth-child(n) {
      grid-column: 1;
    }
  }

  @media (max-width: 28rem) {
    .lead-story__band {
      align-items: start;
      flex-direction: column;
    }

    .home-branches {
      grid-template-columns: 1fr;
    }

    .topic-field a {
      align-items: start;
      flex-direction: column;
    }

    .topic-field small {
      white-space: normal;
    }
  }
</style>
