---
import PostRow from '../components/PostRow.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  formatPostDate,
  getFeaturedPost,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../lib/posts'

const posts = await getPublishedPosts()
const featuredPost = await getFeaturedPost(posts)
const recentPosts = posts
  .filter((post) => post.id !== featuredPost?.id)
  .slice(0, 4)

const topicCounts = new Map<string, number>()
for (const post of posts) {
  for (const tag of getPostTags(post)) {
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1)
  }
}

const topics = [...topicCounts]
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'))
  .slice(0, 8)

const latestUrl = featuredPost ? getPostUrl(featuredPost) : '/articles/'
const searchHref = (query: string) => `/search/?q=${encodeURIComponent(query)}`
---

<BaseLayout
  title="不知名博客"
  description="Nisconder 的个人博客，记录技术、社会观察、音乐与生活。"
>
  <header class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">NISCONDER / OPEN NOTES</p>
    <h1 id="home-title">写代码，也拆解那些<br />被说得太理所当然的事情。</h1>
    <div class="home-intro__tail">
      <p class="lede">
        这里写技术，也写社会、音乐和生活里那些不太容易被一句话说完的部分。
      </p>
      <div class="button-row intro-actions">
        <a class="button" href={latestUrl}>读最新文章</a>
        <a class="button secondary" href="/search/">站内搜索</a>
      </div>
    </div>
  </header>

  <section class="axis-section editorial-splice-section" data-note="近作" id="latest">
    <div class="editorial-splice">
      {
        featuredPost ? (
          <article class="lead-story">
            <div class="lead-story__meta">
              <time datetime={getPostDateTime(featuredPost.data.date)}>
                {formatPostDate(featuredPost.data.date)}
              </time>
              {getPostCategory(featuredPost) && (
                <a href={searchHref(getPostCategory(featuredPost)!)}>
                  {getPostCategory(featuredPost)}
                </a>
              )}
            </div>
            <h2><a href={getPostUrl(featuredPost)}>{featuredPost.data.title}</a></h2>
            <p class="lead-story__summary">{getPostDescription(featuredPost)}</p>
            {getPostTags(featuredPost).length > 0 && (
              <nav class="lead-story__tags" aria-label="文章标签">
                {getPostTags(featuredPost).map((tag) => (
                  <a href={searchHref(tag)}>#{tag}</a>
                ))}
              </nav>
            )}
            <a class="lead-story__read" href={getPostUrl(featuredPost)}>
              阅读全文 <span aria-hidden="true">→</span>
            </a>
          </article>
        ) : (
          <div class="lead-story lead-story--empty">
            <p class="lead-story__meta">WRITING</p>
            <h2>文章正在整理。</h2>
            <a class="lead-story__read" href="/articles/">查看文章页 →</a>
          </div>
        )
      }

      <aside class="side-notes" aria-labelledby="side-notes-title">
        <p class="side-notes__label">NETEASE / 17846303428</p>
        <h2 id="side-notes-title">最近反复播放</h2>
        <p>一张持续更新的私人歌单，收着近期循环，也保留一些阶段性的心情。</p>
        <a class="side-notes__main" href="/music/">打开歌单 <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  {topics.length > 0 && (
    <section class="axis-section topic-section" data-note="词语">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">INDEX</p>
          <h2>反复出现的词</h2>
        </div>
        <p class="section-aside">它们会在不同文章里重逢。</p>
      </div>

      <ul class="topic-field" aria-label="文章主题">
        {topics.map(([topic, count]) => (
          <li>
            <a href={searchHref(topic)}>
              <span>{topic}</span>
              <small>{count} 篇</small>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="axis-section" data-note="更新">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">LATEST</p>
          <h2>最近更新</h2>
        </div>
        <a class="text-link" href="/articles/">全部文章 →</a>
      </div>

      <div class="post-list">
        {recentPosts.map((post) => (
          <PostRow
            href={getPostUrl(post)}
            title={post.data.title}
            description={getPostDescription(post)}
            date={formatPostDate(post.data.date)}
            datetime={getPostDateTime(post.data.date)}
            category={getPostCategory(post)}
            tags={getPostTags(post)}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .home-intro {
    padding-block-end: clamp(4.5rem, 10vw, 8rem);
  }

  .home-intro h1 {
    max-width: 17ch;
    margin-block-end: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.55rem, 6.2vw, 4.7rem);
  }

  .home-intro__tail {
    max-width: 37rem;
    margin-block-start: clamp(1.75rem, 4vw, 3rem);
    margin-inline-start: clamp(0rem, 9vw, 7rem);
  }

  .home-intro .lede {
    margin-block-end: 0;
  }

  .intro-actions {
    margin-block-start: 1.75rem;
  }

  .section-head {
    max-width: var(--content-width);
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-head h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.025em;
  }

  .section-head--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .text-link {
    flex: none;
    min-height: 2.75rem;
    padding-block: 0.55rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .editorial-splice {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.7fr);
    align-items: stretch;
  }

  .lead-story,
  .side-notes {
    min-width: 0;
  }

  .lead-story {
    padding: clamp(1.75rem, 5vw, 3.75rem);
    padding-inline-end: clamp(3rem, 8vw, 6rem);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .lead-story__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin: 0 0 clamp(2.5rem, 7vw, 5rem);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .lead-story__meta a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
  }

  .lead-story h2 {
    max-width: 18ch;
    margin-block-end: 1rem;
    color: inherit;
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 5vw, 3.4rem);
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .lead-story h2 a {
    color: inherit;
    text-decoration: none;
  }

  .lead-story h2 a:hover,
  .lead-story h2 a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .lead-story__summary {
    max-width: 38rem;
    margin-block-end: 1rem;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .lead-story__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-block-start: 1rem;
  }

  .lead-story__tags a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
    font-family: var(--font-utility);
    font-size: 0.72rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .lead-story__read {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: clamp(2rem, 5vw, 4rem);
    border-block-start: 1px solid currentColor;
    color: inherit;
    font-weight: 750;
    text-decoration: none;
  }

  .lead-story__read:hover,
  .lead-story__read:focus-visible,
  .side-notes__main:hover,
  .side-notes__main:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .lead-story--empty h2 {
    margin-block-end: 3rem;
  }

  .side-notes {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    align-content: stretch;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .side-notes__label {
    margin: 0 0 2.5rem;
    font-family: var(--font-utility);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
  }

  .side-notes h2 {
    max-width: 12ch;
    margin-block-end: 0.75rem;
    color: inherit;
    font-size: clamp(1.65rem, 4vw, 2.35rem);
    letter-spacing: -0.025em;
  }

  .side-notes > p:not(.side-notes__label) {
    margin-block-end: 1.5rem;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .side-notes a {
    color: inherit;
    font-weight: 700;
  }

  .side-notes__main {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    align-self: end;
    border-block: 1px solid currentColor;
    text-decoration: none;
  }

  .editorial-splice a:focus-visible {
    outline-color: currentColor;
  }

  .section-aside {
    max-width: 17rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .topic-field {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .topic-field li {
    grid-column: 1 / span 7;
  }

  .topic-field li:nth-child(2n) {
    grid-column: 7 / span 6;
  }

  .topic-field li:nth-child(3n) {
    grid-column: 3 / span 7;
  }

  .topic-field li:nth-child(4n) {
    grid-column: 8 / span 5;
  }

  .topic-field a {
    display: flex;
    min-height: 4.5rem;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-block-end: 1px solid var(--color-line-strong);
    color: var(--color-text);
    text-decoration: none;
  }

  .topic-field span {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.5vw, 1.8rem);
  }

  .topic-field small {
    color: var(--color-muted);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .topic-field a:hover span,
  .topic-field a:focus-visible span {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 52rem) {
    .editorial-splice {
      width: calc(100% + 4rem);
      margin-inline-start: -4rem;
    }
  }

  @media (max-width: 42rem) {
    .home-intro h1 br {
      display: none;
    }

    .home-intro__tail {
      margin-inline-start: 0;
    }

    .section-head--split {
      display: block;
    }

    .text-link,
    .section-aside {
      display: inline-block;
      margin-block-start: 0.75rem;
    }

    .editorial-splice {
      grid-template-columns: 1fr;
    }

    .lead-story {
      padding-inline-end: clamp(1.75rem, 5vw, 3.75rem);
    }

    .side-notes {
      margin-block-start: 0;
      margin-inline: 0;
    }

    .topic-field {
      grid-template-columns: 1fr;
    }

    .topic-field li,
    .topic-field li:nth-child(n) {
      grid-column: 1;
    }
  }

  @media (max-width: 28rem) {
    .topic-field a {
      align-items: start;
      flex-direction: column;
    }

    .topic-field small {
      white-space: normal;
    }
  }
</style>
