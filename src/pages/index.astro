---
import PostRow from '../components/PostRow.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  formatPostDate,
  getFeaturedPost,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../lib/posts'

const posts = await getPublishedPosts()
const featuredPost = await getFeaturedPost(posts)
const recentPosts = posts
  .filter((post) => post.id !== featuredPost?.id)
  .slice(0, 4)

const topicCounts = new Map<string, number>()
for (const post of posts) {
  for (const tag of getPostTags(post)) {
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1)
  }
}

const topics = [...topicCounts]
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'))
  .slice(0, 8)

const startingUrl = featuredPost ? getPostUrl(featuredPost) : '/articles/'
---

<BaseLayout
  title="不知名博客"
  description="Nisconder 的个人博客：沿一条主线进入，在文章、主题、音乐与生活观察之间自由转向。"
>
  <header class="home-intro" aria-labelledby="home-title">
    <div class="home-intro__copy">
      <p class="eyebrow">NISCONDER / OPEN NOTES</p>
      <h1 id="home-title">写代码，也拆解那些<br />被说得太理所当然的事情。</h1>
      <p class="lede">
        一条主线负责带路；文章、主题、音乐与关于在沿途分叉。你可以顺着读，也可以随时从可见的出口转向。
      </p>
      <div class="button-row intro-actions" aria-label="推荐入口">
        <a class="button" href={startingUrl}>从一篇文章开始</a>
        <a class="button secondary" href="#switchyard">自己选择方向</a>
      </div>
    </div>

    <aside class="home-compass" aria-label="本站浏览方式">
      <p>HOW TO WANDER</p>
      <dl>
        <div>
          <dt>推荐</dt>
          <dd>先读一篇完整的文字</dd>
        </div>
        <div>
          <dt>自由</dt>
          <dd>从主题、音乐或作者进入</dd>
        </div>
      </dl>
      <small>方向始终可见，顺序从不强制。</small>
    </aside>
  </header>

  {featuredPost && (
    <section class="axis-section featured-section" data-note="沿主线">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">A COMPLETE THOUGHT</p>
          <h2>建议从这里开始</h2>
        </div>
        <a class="text-link" href="/articles/">全部文章 →</a>
      </div>

      <div class="featured-field">
        <PostRow
          href={getPostUrl(featuredPost)}
          title={featuredPost.data.title}
          description={getPostDescription(featuredPost)}
          date={formatPostDate(featuredPost.data.date)}
          datetime={getPostDateTime(featuredPost.data.date)}
          category={getPostCategory(featuredPost)}
          tags={getPostTags(featuredPost)}
        />
      </div>
    </section>
  )}

  <section class="axis-section switchyard-section" data-note="路线分岔" id="switchyard">
    <div class="section-head">
      <p class="eyebrow">GUIDE / WANDER</p>
      <h2>顺着走，或者现在就转向</h2>
      <p>这里把两种走法并排放在一起：左边给出下一步，右边把选择权交还给你。</p>
    </div>

    <div class="switchyard" role="group" aria-label="选择下一条浏览路线">
      <section class="switchyard__guide" aria-labelledby="guide-title">
        <p>GUIDE / 推荐路线</p>
        <h3 id="guide-title">继续沿文章阅读</h3>
        <span>按时间查看所有公开文章，不经过推荐算法。</span>
        <a href="/articles/">打开文章归档 <b aria-hidden="true">→</b></a>
      </section>

      <section class="switchyard__wander" aria-labelledby="wander-title">
        <p>WANDER / 自由路线</p>
        <h3 id="wander-title">换一个入口</h3>
        <nav aria-label="自由探索">
          <a href="/search/"><span>从一个词开始</span><b aria-hidden="true">↗</b></a>
          <a href="/music/"><span>去听一张歌单</span><b aria-hidden="true">→</b></a>
          <a href="/about/"><span>认识作者与本站</span><b aria-hidden="true">↗</b></a>
        </nav>
      </section>
    </div>
  </section>

  {topics.length > 0 && (
    <section class="axis-section topic-section" data-note="主题场">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">FOLLOW A THREAD</p>
          <h2>从一个反复出现的词进入</h2>
        </div>
        <p class="section-aside">主题不是栏目，它们会在不同文章之间交叉。</p>
      </div>

      <ul class="topic-field" aria-label="文章主题">
        {topics.map(([topic, count]) => (
          <li>
            <a href={`/search/?q=${encodeURIComponent(topic)}`}>
              <span>{topic}</span>
              <small>{count} 篇 · 进入主题</small>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="axis-section" data-note="继续阅读">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">LATEST WRITING</p>
          <h2>沿主线继续</h2>
        </div>
        <a class="text-link" href="/articles/">查看全部 →</a>
      </div>

      <div class="post-list">
        {recentPosts.map((post) => (
          <PostRow
            href={getPostUrl(post)}
            title={post.data.title}
            description={getPostDescription(post)}
            date={formatPostDate(post.data.date)}
            datetime={getPostDateTime(post.data.date)}
            category={getPostCategory(post)}
            tags={getPostTags(post)}
          />
        ))}
      </div>
    </section>
  )}

  <section class="axis-section exit-section" data-note="继续向外">
    <div class="section-head">
      <p class="eyebrow">MORE WAYS OUT</p>
      <h2>这里没有必须走完的路径</h2>
      <p>订阅更新，去 GitHub 看代码，或者回到搜索重新选择一个词。</p>
    </div>
    <nav class="exit-links" aria-label="其他入口">
      <a href="/rss.xml">订阅 RSS <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/nisconder" rel="me noopener" target="_blank">GitHub <span aria-hidden="true">↗</span></a>
      <a href="/search/">重新搜索 <span aria-hidden="true">→</span></a>
    </nav>
  </section>
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.38fr);
    gap: clamp(2.5rem, 7vw, 5rem);
    align-items: end;
    padding-block-end: clamp(3.75rem, 8vw, 6.75rem);
  }

  .home-intro h1 {
    max-width: 17ch;
    margin-block-end: 1.4rem;
    font-size: clamp(2.55rem, 6.2vw, 4.7rem);
  }

  .home-intro .lede {
    max-width: 35rem;
  }

  .intro-actions {
    margin-block-start: 2rem;
  }

  .home-compass {
    padding-block: 1rem;
    border-block: 1px solid var(--color-line-strong);
  }

  .home-compass > p,
  .home-compass small {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    line-height: 1.6;
  }

  .home-compass dl {
    margin: 1rem 0;
  }

  .home-compass dl > div {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0.75rem;
    padding-block: 0.75rem;
    border-block-start: 1px solid var(--color-line);
  }

  .home-compass dt {
    color: var(--color-primary);
    font-weight: 750;
  }

  .home-compass dl > div:nth-child(2) dt {
    color: var(--color-secondary);
  }

  .home-compass dd {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .section-head {
    max-width: var(--content-width);
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-head h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.025em;
  }

  .section-head > p:last-child:not(.eyebrow) {
    max-width: 38rem;
    margin: 0.75rem 0 0;
    color: var(--color-muted);
  }

  .section-head--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .text-link {
    flex: none;
    min-height: 2.75rem;
    padding-block: 0.55rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .featured-field {
    position: relative;
    border-inline-start: 0.45rem solid var(--color-primary);
    border-block-end: 0.45rem solid var(--color-secondary);
    background: var(--color-surface);
  }

  .featured-field::before {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: clamp(3rem, 12vw, 7rem);
    height: 0.45rem;
    background: var(--color-secondary);
    content: '';
  }

  .featured-field :global(.post-row) {
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    border-block-start: 0;
  }

  .switchyard-section {
    scroll-margin-block-start: 2rem;
  }

  .switchyard {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    border: 1px solid var(--color-line-strong);
  }

  .switchyard > section {
    display: grid;
    align-content: start;
    min-height: 22rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .switchyard__guide {
    margin-block-end: 2rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .switchyard__wander {
    margin-block-start: 2rem;
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .switchyard p {
    margin: 0 0 1.4rem;
    font-family: var(--font-utility);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.07em;
  }

  .switchyard h3 {
    max-width: 12ch;
    margin: 0 0 0.8rem;
    color: inherit;
    font-size: clamp(1.85rem, 4.5vw, 2.85rem);
    letter-spacing: -0.025em;
  }

  .switchyard__guide > span {
    max-width: 28ch;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .switchyard a {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-block-start: 1px solid currentColor;
    color: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .switchyard__guide > a {
    align-self: end;
    margin-block-start: auto;
  }

  .switchyard nav {
    align-self: end;
    display: grid;
    margin-block-start: auto;
  }

  .switchyard a:hover span,
  .switchyard a:hover,
  .switchyard a:focus-visible span,
  .switchyard a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .switchyard b {
    font-size: 1.2rem;
    font-weight: 400;
  }

  .section-aside {
    max-width: 17rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .topic-field {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .topic-field li {
    grid-column: 1 / span 7;
  }

  .topic-field li:nth-child(2n) {
    grid-column: 7 / span 6;
  }

  .topic-field li:nth-child(3n) {
    grid-column: 3 / span 7;
  }

  .topic-field li:nth-child(4n) {
    grid-column: 8 / span 5;
  }

  .topic-field a {
    display: flex;
    min-height: 4.5rem;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-block-end: 1px solid var(--color-line-strong);
    color: var(--color-text);
    text-decoration: none;
  }

  .topic-field span {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.5vw, 1.8rem);
  }

  .topic-field small {
    color: var(--color-muted);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .topic-field a:hover span,
  .topic-field a:focus-visible span {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .exit-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--color-line-strong);
  }

  .exit-links a {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .exit-links a + a {
    border-inline-start: 1px solid var(--color-line-strong);
  }

  .exit-links a:hover,
  .exit-links a:focus-visible {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
  }

  @media (max-width: 62rem) {
    .home-intro {
      grid-template-columns: 1fr;
    }

    .home-compass {
      max-width: 30rem;
    }
  }

  @media (min-width: 52rem) {
    .switchyard {
      width: calc(100% + 4rem);
      margin-inline-start: -4rem;
    }
  }

  @media (max-width: 42rem) {
    .home-intro h1 br {
      display: none;
    }

    .section-head--split {
      display: block;
    }

    .text-link,
    .section-aside {
      display: inline-block;
      margin-block-start: 0.75rem;
    }

    .switchyard {
      grid-template-columns: 1fr;
    }

    .switchyard > section {
      min-height: 18rem;
    }

    .switchyard__guide {
      margin-block-end: 0;
      margin-inline-end: 1.25rem;
    }

    .switchyard__wander {
      margin-block-start: 0;
      margin-inline-start: 1.25rem;
    }

    .topic-field {
      grid-template-columns: 1fr;
    }

    .topic-field li,
    .topic-field li:nth-child(n) {
      grid-column: 1;
    }

    .exit-links {
      grid-template-columns: 1fr;
    }

    .exit-links a + a {
      border-block-start: 1px solid var(--color-line-strong);
      border-inline-start: 0;
    }
  }

  @media (max-width: 28rem) {
    .home-compass dl > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .topic-field a {
      align-items: start;
      flex-direction: column;
    }

    .topic-field small {
      white-space: normal;
    }
  }
</style>
