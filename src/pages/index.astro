---
import PostRow from '../components/PostRow.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPlaylistTracks } from '../lib/playlist'
import {
  formatPostDate,
  getFeaturedPost,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../lib/posts'

const posts = await getPublishedPosts()
const playlist = await getPlaylistTracks()
const playablePlaylist = playlist.filter((track) => track.fee === 0 || track.fee === 8)
const playlistPreview = playablePlaylist.slice(0, 3)
const musicianCount = new Set(
  playlist.flatMap((track) => track.author.split('/').map((artist) => artist.trim()).filter(Boolean)),
).size
const featuredPost = await getFeaturedPost(posts)
const recentPosts = posts
  .filter((post) => post.id !== featuredPost?.id)
  .slice(0, 4)

const topicCounts = new Map<string, number>()
for (const post of posts) {
  for (const tag of getPostTags(post)) {
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1)
  }
}

const topics = [...topicCounts]
  .filter(([, count]) => count >= 2)
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'))
  .slice(0, 8)
const querySeeds = [...topicCounts.keys()].slice(0, 5)

const searchHref = (query: string) => `/search/?q=${encodeURIComponent(query)}`
---

<BaseLayout
  title="不知名博客"
  description="Nisconder 的个人博客，记录技术、社会观察、音乐与生活。"
>
  <header class="home-intro" aria-labelledby="home-title">
    <div class="home-intro__identity">
      <p class="eyebrow">NISCONDER</p>
      <p>{posts.length.toString().padStart(2, '0')} 篇公开文章</p>
    </div>
    <div class="home-intro__copy">
      <p class="eyebrow">OPEN NOTES</p>
      <h1 id="home-title">写代码，也拆解那些<br />被说得太理所当然的事情。</h1>
      <p class="lede">
        这里写技术，也写社会、音乐和生活里那些不太容易被一句话说完的部分。
      </p>
    </div>
  </header>

  <section class="home-feature" id="latest" aria-labelledby="home-feature-title">
    <header class="home-feature__head">
      <div>
        <p class="eyebrow">SITE / INDEX</p>
        <h2 id="home-feature-title">站内一览</h2>
      </div>
      <p>{posts.length} 篇文章 · {playlist.length} 首歌 · {topicCounts.size} 个主题词</p>
    </header>

    <div class="home-card-grid">
      {
        featuredPost ? (
          <article class="home-card lead-story">
            <header class="lead-story__band">
              <span>LATEST / ARTICLE</span>
              <div class="lead-story__meta">
                <time datetime={getPostDateTime(featuredPost.data.date)}>
                  {formatPostDate(featuredPost.data.date)}
                </time>
                {getPostCategory(featuredPost) && (
                  <a href={searchHref(getPostCategory(featuredPost)!)}>
                    {getPostCategory(featuredPost)}
                  </a>
                )}
              </div>
            </header>
            <div class="lead-story__body">
              <h3><a href={getPostUrl(featuredPost)}>{featuredPost.data.title}</a></h3>
              <p class="lead-story__summary">{getPostDescription(featuredPost)}</p>
              {getPostTags(featuredPost).length > 0 && (
                <nav class="lead-story__tags" aria-label="文章标签">
                  {getPostTags(featuredPost).slice(0, 3).map((tag) => (
                    <a href={searchHref(tag)}>#{tag}</a>
                  ))}
                </nav>
              )}
              <div class="lead-story__actions">
                <a class="lead-story__read" href={getPostUrl(featuredPost)}>
                  阅读全文 <span aria-hidden="true">→</span>
                </a>
                <a class="lead-story__archive" href="/articles/">全部 {posts.length} 篇</a>
              </div>
            </div>
          </article>
        ) : (
          <div class="home-card lead-story lead-story--empty">
            <p class="card-kicker">WRITING</p>
            <h3>文章正在整理。</h3>
            <a class="lead-story__read" href="/articles/">查看文章页 →</a>
          </div>
        )
      }

      <a class="home-card music-card" href="/music/" aria-labelledby="music-card-title">
          <p class="card-kicker">MUSIC / PLAYLIST</p>
          <h3 id="music-card-title">最近反复播放</h3>
          <p class="music-card__summary">{playlist.length} 首 · {musicianCount} 位音乐人</p>
          <ol class="music-card__tracks" aria-label="歌单中的前三首曲目">
            {playlistPreview.map((track, index) => (
              <li>
                <span>{(index + 1).toString().padStart(2, '0')}</span>
                <span class="music-card__track-copy">
                  <strong>{track.title}</strong>
                  <small>{track.author}</small>
                </span>
              </li>
            ))}
          </ol>
          <span class="home-card__action">打开 {playlist.length} 首歌 <span aria-hidden="true">→</span></span>
      </a>

      <form class="home-card search-card" action="/search/" method="get" role="search">
        <p class="card-kicker">SEARCH</p>
        <h3>站内搜索</h3>
        <label for="home-search">标题、正文或标签</label>
        <div class="search-card__controls">
          <input id="home-search" name="q" type="search" autocomplete="off" placeholder="输入标题、正文或标签…" />
          <button type="submit">搜索文章</button>
        </div>
        {querySeeds.length > 0 && (
          <nav class="search-card__seeds" aria-label="常用搜索标签">
            {querySeeds.map((seed) => <a href={searchHref(seed)}>#{seed}</a>)}
          </nav>
        )}
      </form>

      <article class="home-card about-card" aria-labelledby="about-card-title">
        <p class="card-kicker">ABOUT / NISCONDER</p>
        <h3 id="about-card-title">本站与我</h3>
        <p>记录代码、阅读、音乐与生活观察。这里为什么存在，我在写什么，以及还在关注什么。</p>
        <div class="about-card__links">
          <a href="/about/">关于 Nisconder <span aria-hidden="true">→</span></a>
          <a href="https://github.com/nisconder" rel="me noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </div>
  </section>

  {topics.length >= 3 && (
    <section class="axis-section topic-section" data-note="词语">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">INDEX</p>
          <h2>反复出现的词</h2>
        </div>
        <p class="section-aside">它们会在不同文章里重逢。</p>
      </div>

      <ul class="topic-field" aria-label="文章主题">
        {topics.map(([topic, count]) => (
          <li>
            <a href={searchHref(topic)}>
              <span>{topic}</span>
              <small>{count} 篇</small>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="axis-section" data-note="更新">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">LATEST</p>
          <h2>最近更新</h2>
        </div>
        <a class="text-link" href="/articles/">全部文章 →</a>
      </div>

      <div class="post-list">
        {recentPosts.map((post) => (
          <PostRow
            href={getPostUrl(post)}
            title={post.data.title}
            description={getPostDescription(post)}
            date={formatPostDate(post.data.date)}
            datetime={getPostDateTime(post.data.date)}
            category={getPostCategory(post)}
            tags={getPostTags(post)}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1.68fr);
    margin-block-end: clamp(2.75rem, 6vw, 4.5rem);
    border: 1px solid var(--color-line-strong);
  }

  .home-intro__identity,
  .home-intro__copy {
    min-width: 0;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .home-intro__identity {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    border-inline-end: 1px solid var(--color-line-strong);
    background: var(--color-primary-soft);
  }

  .home-intro__identity p:last-child {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .home-intro__copy {
    background: var(--color-surface);
  }

  .home-intro h1 {
    max-width: 18ch;
    margin-block-start: clamp(1rem, 2vw, 1.75rem);
    margin-block-end: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 4.2vw, 3rem);
    line-height: 1.18;
  }

  .home-intro .lede {
    max-width: 35rem;
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
    margin-block-end: 0;
  }

  .home-feature {
    margin-block-end: clamp(3rem, 6vw, 5rem);
  }

  .section-head {
    max-width: var(--content-width);
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-head h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.025em;
  }

  .section-head--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .text-link {
    flex: none;
    min-height: 2.75rem;
    padding-block: 0.55rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .lead-story {
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
  }

  .lead-story__band {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.75rem clamp(1.25rem, 3vw, 2rem);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-utility);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .lead-story__body {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .lead-story__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin: 0;
  }

  .lead-story__meta a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
  }

  .lead-story__summary {
    max-width: 34rem;
    margin-block-end: 1rem;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .lead-story__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-block-start: 1rem;
  }

  .lead-story__tags a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .lead-story--empty {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .home-feature__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block-end: clamp(1.25rem, 3vw, 2rem);
  }

  .home-feature__head h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    letter-spacing: -0.025em;
  }

  .home-feature__head > p {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.75rem;
    text-align: end;
  }

  .home-card-grid {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: stretch;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface-soft);
  }

  .home-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-surface);
  }

  a.home-card {
    color: var(--color-text);
    text-decoration: none;
  }

  a.home-card:hover,
  a.home-card:focus-visible,
  .home-card:focus-within {
    border-color: var(--color-reading);
  }

  .home-card:focus-within {
    outline: 3px solid var(--color-media);
    outline-offset: 3px;
  }

  .card-kicker {
    margin: 0 0 1.25rem;
    color: var(--color-media);
    font-family: var(--font-utility);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.07em;
  }

  .home-card h3 {
    margin-block-end: 0.75rem;
    font-size: clamp(1.45rem, 2.8vw, 1.9rem);
    letter-spacing: -0.025em;
  }

  .home-card__action {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: auto;
    border-block-start: 1px solid currentColor;
    font-size: 0.875rem;
    font-weight: 750;
  }

  .lead-story {
    display: grid;
    grid-column: span 7;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .lead-story__band {
    background: var(--color-reading);
    color: var(--color-on-reading);
  }

  .lead-story__band a:focus-visible {
    outline-color: var(--color-on-reading);
  }

  .lead-story__body {
    display: flex;
    flex-direction: column;
  }

  .lead-story h3 {
    max-width: 19ch;
    margin-block-end: 1.1rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.9rem, 3.6vw, 2.55rem);
    line-height: 1.22;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .lead-story h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .lead-story h3 a:hover,
  .lead-story h3 a:focus-visible {
    color: var(--color-reading);
    text-decoration: underline;
    text-decoration-color: var(--color-media);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .lead-story__tags a {
    color: var(--color-media);
  }

  .lead-story__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-block-start: auto;
    padding-block-start: clamp(1.5rem, 3vw, 2.25rem);
  }

  .lead-story__read,
  .lead-story__archive {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    color: var(--color-reading);
    font-size: 0.875rem;
    font-weight: 750;
  }

  .lead-story__read {
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    border-block: 1px solid var(--color-line-strong);
    text-decoration: none;
  }

  .lead-story__archive {
    justify-content: center;
    padding-inline: 0.25rem;
    color: var(--color-media);
    text-underline-offset: 0.25em;
  }

  .lead-story--empty {
    display: flex;
    grid-column: span 7;
    flex-direction: column;
  }

  a.music-card {
    display: flex;
    grid-column: span 5;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-color: var(--color-media);
    background: var(--color-media);
    color: var(--color-on-media);
  }

  a.music-card:hover,
  a.music-card:focus-visible {
    border-color: var(--color-reading);
    color: var(--color-on-media);
  }

  .music-card .card-kicker,
  .music-card h3 {
    color: inherit;
  }

  .music-card__summary {
    margin-block-end: 1rem;
    color: inherit;
    font-size: 0.85rem;
  }

  .music-card__tracks {
    padding: 0;
    margin: 0 0 1.25rem;
    list-style: none;
  }

  .music-card__tracks li {
    display: grid;
    min-height: 3.25rem;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    border-block-start: 1px solid color-mix(in srgb, currentColor, transparent 48%);
  }

  .music-card__tracks > li > span:first-child {
    font-family: var(--font-utility);
    font-size: 0.7rem;
    font-weight: 750;
  }

  .music-card__track-copy {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
  }

  .music-card__track-copy strong,
  .music-card__track-copy small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .music-card__track-copy strong {
    font-size: 0.84rem;
  }

  .music-card__track-copy small {
    color: inherit;
    font-size: 0.72rem;
    opacity: 0.78;
  }

  .search-card {
    display: flex;
    grid-column: span 5;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-block-start: 0.45rem solid var(--color-reading);
    background: var(--color-reading-soft);
  }

  .search-card label {
    margin-block: 0.5rem 0.4rem;
  }

  .search-card__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }

  .search-card__controls input,
  .search-card__controls button {
    min-height: 3rem;
    border-color: var(--color-line-strong);
    border-radius: 0.375rem;
  }

  .search-card__controls button {
    padding-inline: 1rem;
    border: 1px solid var(--color-reading);
    background: var(--color-reading);
    color: var(--color-on-reading);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 750;
  }

  .search-card__controls button:hover,
  .search-card__controls button:focus-visible {
    border-color: var(--color-media);
    background: var(--color-media);
    color: var(--color-on-media);
  }

  .search-card__controls button:focus-visible {
    outline-color: var(--color-text);
    box-shadow: inset 0 0 0 2px var(--color-surface);
  }

  .search-card__seeds {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.35rem;
    margin-block-start: 0.75rem;
  }

  .search-card__seeds a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.35rem;
    color: var(--color-media);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    font-weight: 750;
    text-underline-offset: 0.23em;
  }

  .about-card {
    display: flex;
    grid-column: span 7;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-block-start: 0.45rem solid var(--color-media);
    background: var(--color-surface);
  }

  .about-card > p:not(.card-kicker) {
    max-width: 34rem;
    margin-block-end: 1.25rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .about-card__links {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-block-start: auto;
    border-block-start: 1px solid var(--color-line-strong);
  }

  .about-card__links a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--color-reading);
    font-size: 0.875rem;
    font-weight: 750;
    text-underline-offset: 0.24em;
  }

  .about-card__links a:last-child {
    color: var(--color-media);
  }

  .section-aside {
    max-width: 17rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .topic-field {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .topic-field li {
    grid-column: 1 / span 7;
  }

  .topic-field li:nth-child(2n) {
    grid-column: 7 / span 6;
  }

  .topic-field li:nth-child(3n) {
    grid-column: 3 / span 7;
  }

  .topic-field li:nth-child(4n) {
    grid-column: 8 / span 5;
  }

  .topic-field a {
    display: flex;
    min-height: 4.5rem;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-block-end: 1px solid var(--color-line-strong);
    color: var(--color-text);
    text-decoration: none;
  }

  .topic-field span {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.5vw, 1.8rem);
  }

  .topic-field small {
    color: var(--color-muted);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .topic-field a:hover span,
  .topic-field a:focus-visible span {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 42rem) {
    .home-intro {
      grid-template-columns: 1fr;
    }

    .home-intro__identity {
      min-height: auto;
      align-items: center;
      flex-direction: row;
      gap: 1rem;
      border-block-end: 1px solid var(--color-line-strong);
      border-inline-end: 0;
    }

    .home-intro h1 br {
      display: none;
    }

    .section-head--split {
      display: block;
    }

    .text-link,
    .section-aside {
      display: inline-block;
