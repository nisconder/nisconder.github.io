---
import { Image } from 'astro:assets'
import avatar from '../../source/img/nisconder-avatar.png'
import { featuredSoftware, softwareProjects, softwareStatusLabels } from '../data/software'
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionMasthead from '../components/SectionMasthead.astro'
import RecordTurntable from '../components/RecordTurntable.astro'
import SeriesCard from '../components/SeriesCard.astro'
import { getPublishedSeries, getStandalonePosts } from '../lib/series'
import { getPlaylistTracks, getTrackListeningUrl, isPlayableTrack } from '../lib/playlist'
import {
  formatPostDate,
  getPinnedPost,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostReadingMinutes,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../lib/posts'

const [publishedPosts, series] = await Promise.all([getPublishedPosts(), getPublishedSeries()])
// Collection membership only changes the cards shown, not the site's article totals.
const posts = getStandalonePosts(publishedPosts, series)
const playlist = await getPlaylistTracks()
const playableTracks = playlist.filter(isPlayableTrack)
const playlistPreview = (playableTracks.length > 0 ? playableTracks : playlist).slice(0, 3)
const musicianCount = new Set(
  playlist.flatMap((track) => track.author.split('/').map((artist) => artist.trim()).filter(Boolean)),
).size
const contentLinks = [
  { href: '/articles/', label: '文章', count: publishedPosts.length },
  { href: '/software/', label: '项目', count: softwareProjects.length },
  { href: '/music/', label: '歌曲', count: playlist.length },
]

const latestPost = posts[0]
const featuredPost = await getPinnedPost(posts)
const pinnedPost = featuredPost?.id !== latestPost?.id ? featuredPost : undefined
const latestIsPinned = Boolean(latestPost && featuredPost?.id === latestPost.id)
// Recency and editorial selection are separate entry points, never nested.
// When one article fills both roles, show it once with both labels.
const homeArticles = [
  ...(latestPost ? [{ post: latestPost, kind: 'latest', label: latestIsPinned ? '最新文章 · 置顶' : '最新文章' }] : []),
  ...(pinnedPost ? [{ post: pinnedPost, kind: 'pinned', label: '置顶推荐' }] : []),
]

const topicCounts = new Map<string, number>()
for (const post of publishedPosts) {
  for (const tag of getPostTags(post)) {
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1)
  }
}

const querySeeds = [...topicCounts]
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'))
  .slice(0, 3)
  .map(([name]) => name)

const searchHref = (query: string) => `/search/?q=${encodeURIComponent(query)}`
const categoryHref = (category: string) => `/search/?category=${encodeURIComponent(category)}`
---

<BaseLayout
  title="Nisconder"
  description="Nisconder 的个人站：技术文章、个人项目、阅读与音乐记录。"
  comments
  commentsTitle="在首页留言"
  commentsDescription="站点建议、想讨论的话题，或简单打个招呼，都可以写在这里。"
>
  <SectionMasthead id="home-title" title="Nisconder" variant="home">
    <Fragment slot="summary">
      <div class="home-dashboard__profile">
        <Image
          src={avatar}
          width="104"
          height="104"
          format="webp"
          quality={85}
          loading="eager"
          alt="Nisconder 的头像"
          decoding="async"
        />
        <p>技术文章、个人项目、阅读与音乐记录。</p>
      </div>

      <nav class="home-dashboard__index" aria-label="按内容浏览">
        {contentLinks.map(({ href, label, count }) => (
          <a href={href}>
            <span>{label}</span>
            <strong>{count}</strong>
          </a>
        ))}
      </nav>
    </Fragment>
    {playlistPreview[0] && <RecordTurntable track={playlistPreview[0]} />}
  </SectionMasthead>

  <section class="home-articles" aria-label="文章入口">
    {
      homeArticles.length > 0 ? homeArticles.map(({ post, kind, label }) => (
        <article class:list={['article-panel', `article-panel--${kind}`, 'register-panel']} aria-labelledby={`home-${kind}-title`}>
          <header class="article-panel__meta">
            <span class="article-panel__kind">{label}</span>
            <div>
              <time datetime={getPostDateTime(post.data.date)}>
                {formatPostDate(post.data.date)}
              </time>
              <span>约 {getPostReadingMinutes(post)} 分钟</span>
              {getPostCategory(post) && (
                <a href={categoryHref(getPostCategory(post)!)}>{getPostCategory(post)}</a>
              )}
            </div>
          </header>

          <div class="article-panel__body">
            <h2 id={`home-${kind}-title`}><a data-astro-prefetch href={getPostUrl(post)}>{post.data.title}</a></h2>
            <p>{getPostDescription(post)}</p>

            <div class="article-panel__actions">
              <a data-astro-prefetch class="primary-link" href={getPostUrl(post)} aria-label={`阅读：${post.data.title}`}>
                阅读文章 <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      )) : (
        <section class="article-panel article-panel--empty register-panel">
          <p class="eyebrow">最新文章</p>
          <h2>文章正在整理</h2>
          <a class="primary-link" href="/articles/">查看文章页 →</a>
        </section>
      )
    }
    {publishedPosts.length > 0 && (
      <nav class="home-articles__archive" aria-label="全部文章">
        <a class="quiet-link" href="/articles/">全部 {publishedPosts.length} 篇文章 →</a>
      </nav>
    )}
  </section>

  {series.length > 0 && (
    <section class="home-series" aria-labelledby="home-series-title" data-home-reveal>
      <header class="home-series__heading">
        <h2 id="home-series-title">系列合集</h2>
        <a class="quiet-link" href="/series/">全部 {series.length} 个合集 <span aria-hidden="true">→</span></a>
      </header>
      <SeriesCard series={series[0]} headingLevel={3} />
    </section>
  )}

  <section class="home-secondary" aria-label="项目与音乐" data-home-reveal>
    <a class="project-panel register-panel" href={featuredSoftware ? `/software/#${featuredSoftware.slug}` : '/software/'}>
      <div class="project-panel__topline">
        <h2>项目与工具</h2>
        {featuredSoftware && <span>{softwareStatusLabels[featuredSoftware.status]}</span>}
      </div>
      {featuredSoftware && <div class="project-panel__featured">
        <span aria-hidden="true">{featuredSoftware.label}</span>
        <strong>{featuredSoftware.name}</strong>
      </div>}
      <p>{featuredSoftware?.summary ?? '新的公开项目会自动收录到这里。'}</p>
      <span class="panel-action">{featuredSoftware ? '查看项目' : '查看项目目录'} <i aria-hidden="true">→</i></span>
    </a>

    <section class="music-panel register-panel" aria-labelledby="home-music-title">
      <div class="music-panel__topline">
        <h2 id="home-music-title">音乐收藏</h2>
        <span>{playableTracks.length} 首可试听</span>
      </div>
      <p>{playlist.length} 首 · {musicianCount} 位音乐人</p>
      <ul aria-label="歌单预览">
        {playlistPreview.map((track) => (
          <li>
            <a href={getTrackListeningUrl(track)}>
              <span><strong title={track.title}>{track.title}</strong><small>{track.author}</small></span>
              <i aria-hidden="true">{isPlayableTrack(track) ? '→' : '↗'}</i>
            </a>
          </li>
        ))}
      </ul>
      <a class="panel-action" href="/music/">完整歌单 <i aria-hidden="true">→</i></a>
    </section>
  </section>

  <section class="home-search register-panel" aria-labelledby="home-search-title" data-home-reveal>
    <div class="home-search__intro">
      <h2 id="home-search-title">搜索本站</h2>
      <p>直接检索文章正文、项目、分类与标签。</p>
    </div>
    <form class="home-search__form" action="/search/" method="get" role="search">
      <div class="home-search__controls">
        <input
          id="home-search-input"
          aria-label="搜索本站"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="例如：npm-safe、社会学、TypeScript"
        />
        <button type="submit">搜索</button>
      </div>
      {querySeeds.length > 0 && (
        <nav class="home-search__seeds" aria-label="常用搜索标签">
          {querySeeds.map((seed) => <a href={searchHref(seed)}>#{seed}</a>)}
        </nav>
      )}
    </form>
  </section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll('[data-home-reveal]')
    if (!sections.length || !('IntersectionObserver' in window)) return

    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        entry.target.setAttribute('data-home-reveal', 'visible')
        observer.unobserve(entry.target)
      }
    }, { rootMargin: '0px 0px -24px' })
    sections.forEach(section => observer.observe(section))
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true })
  })
</script>

<style>
  .home-series,
  .home-secondary,
  .home-search {
    content-visibility: auto;
    contain-intrinsic-size: auto 28rem;
  }

  .home-series {
    margin-block: clamp(2rem, 4vw, 3rem);
  }

  .home-series__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-block-end: 1rem;
  }

  .home-series__heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--title-section);
  }

  .register-panel {
    min-width: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--card-radius);
    background: var(--color-card);
  }

  .home-dashboard__profile {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-block-start: 0.8rem;
  }

  .home-dashboard__profile img {
    width: clamp(2rem, 3vw, 2.5rem);
    height: auto;
    flex: 0 0 auto;
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    object-fit: cover;
  }

  .home-dashboard__profile p {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(0.86rem, 1.2vw, 1rem);
    line-height: 1.55;
  }

  .home-dashboard__index {
    width: min(100%, 25rem);
    margin-block-start: 0.85rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    padding: 0.2rem 0;
    border-block: 1px solid var(--color-line);
  }

  .home-dashboard__index a {
    display: flex;
    min-block-size: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.45rem;
    border-radius: 0.25rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
    text-decoration: none;
  }

  .home-dashboard__index a:is(:hover, :focus-visible) {
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .home-dashboard__index strong {
    order: -1;
    color: var(--color-primary);
    font-family: var(--font-utility);
    font-size: 1.35rem;
    font-variant-numeric: tabular-nums;
    font-weight: 750;
  }

  .home-articles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .home-articles > .article-panel:only-of-type {
    grid-column: 1 / -1;
  }

  .home-articles__archive {
    grid-column: 1 / -1;
    justify-self: end;
  }

  .article-panel {
    --article-accent: var(--color-primary);
    --article-accent-soft: var(--color-primary-soft);
    display: flex;
    flex-direction: column;
    position: relative;
    gap: 1.05rem;
    padding: clamp(1.05rem, 2.65vw, 2rem);
  }

  .article-panel--latest {
    border-block-start: 3px solid var(--color-primary);
    background: var(--feature-surface);
  }
  .article-panel--latest .article-panel__kind { padding-inline-start: 0; background: transparent; }
  .article-panel--latest .article-panel__meta { border-bottom: 1px solid var(--color-line); padding-block-end: 0.7rem; }
  .article-panel--latest .primary-link { background: var(--color-primary); color: var(--color-on-primary); }
  .article-panel--latest .primary-link:is(:hover, :focus-visible) { background: var(--color-secondary); color: var(--color-on-secondary); }
  .article-panel--pinned {
    --article-accent: var(--color-secondary);
    --article-accent-soft: var(--color-secondary-soft);
  }

  .article-panel__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 0.85rem;
    font-size: var(--text-xs);
  }

  .article-panel__kind {
    padding: 0.24rem 0.6rem;
    border-radius: 0.35rem;
    background: var(--article-accent-soft);
    color: var(--article-accent);
    font-weight: 750;
  }

  .article-panel__meta > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.65rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .article-panel__meta a {
    display: inline-flex;
    min-height: 1.5rem;
    align-items: center;
    color: var(--article-accent);
  }

  .article-panel__body {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .article-panel h2 {
    margin: 0 0 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.7vw, 2.2rem);
    font-weight: 650;
    line-height: 1.36;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .article-panel h2 a {
    color: var(--color-heading);
    text-decoration: none;
  }

  .article-panel h2 a:is(:hover, :focus-visible) {
    color: var(--article-accent);
    text-decoration: underline;
    text-decoration-color: var(--article-accent);
  }

  .article-panel__body > p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .article-panel__actions {
    margin-block-start: auto;
    padding-block-start: 0.85rem;
  }

  .primary-link,
  .quiet-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 750;
  }

  .primary-link {
    gap: 0.65rem;
    padding-inline: 0.75rem;
    border-radius: calc(var(--card-radius) - 0.3rem);
    background: var(--article-accent-soft);
    color: var(--article-accent);
    text-decoration: none;
  }

  .primary-link:is(:hover, :focus-visible) {
    background: color-mix(in srgb, var(--article-accent-soft), var(--article-accent) 12%);
    text-decoration: underline;
  }

  .quiet-link {
    gap: 0.35rem;
    color: var(--color-primary);
  }

  .article-panel--empty {
    align-items: flex-start;
    justify-content: center;
  }

  .home-search {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-block-start: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--color-surface);
  }

  .home-search__intro h2,
  .project-panel h2,
  .music-panel h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2.3vw, 1.6rem);
    letter-spacing: -0.025em;
  }

  .home-search__intro > p:last-child,
  .project-panel > p,
  .music-panel > p {
    margin: 0.45rem 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .home-search__form {
    min-width: 0;
  }

  .home-search__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem;
  }

  .home-search__controls input,
  .home-search__controls button {
    min-height: 2.75rem;
  }

  .home-search__controls input {
    padding-inline: 1rem;
    background: var(--color-card);
  }

  .home-search__controls button {
    padding-inline: clamp(0.7rem, 3vw, 1.25rem);
    border: 1px solid var(--color-primary);
    border-radius: var(--card-radius);
    background: var(--color-primary);
    color: var(--color-on-primary);
    cursor: pointer;
    font-weight: 800;
  }

  .home-search__controls button:hover {
    border-color: var(--color-secondary);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .home-search__seeds {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-block-start: 0.55rem;
  }

  .home-search__seeds a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    color: var(--color-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .home-secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-panel,
  .music-panel {
    display: flex;
    flex-direction: column;
    padding: clamp(1.05rem, 2.8vw, 1.75rem);
    color: var(--color-text);
    text-decoration: none;
  }

  .project-panel__topline,
  .music-panel__topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.85rem;
    margin-block-end: 0.6rem;
  }

  .project-panel__topline > span,
  .music-panel__topline > span {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
  }

  .project-panel__featured {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-block: 0.9rem 0.25rem;
  }

  .project-panel__featured > span {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: calc(var(--card-radius) - 0.1rem);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 900;
  }

  .project-panel__featured strong {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    overflow-wrap: anywhere;
  }

  .music-panel {
    background: var(--color-surface);
  }

  .music-panel ul {
    padding: 0;
    margin: 0.65rem 0 0;
    list-style: none;
  }

  .music-panel li {
    display: grid;
    border-block-start: 1px solid var(--color-line);
  }

  .music-panel li a {
    display: flex;
    min-height: 2.75rem;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    padding: 0.35rem 0.2rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .music-panel li a:is(:hover, :focus-visible) strong { color: var(--color-primary); text-decoration: underline; }
  .music-panel li a > span { display: grid; min-width: 0; }
  .music-panel li i { color: var(--color-secondary); font-style: normal; }

  .music-panel li strong {
    font-size: var(--text-sm);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .music-panel li small {
    color: var(--color-muted);
  }

  .panel-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    margin-block-start: auto;
    padding-block-start: 1rem;
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .music-panel .panel-action {
    color: var(--color-secondary);
  }

  .panel-action i {
    font-style: normal;
  }

  :is(.project-panel, .music-panel):is(:hover, :focus-visible) .panel-action {
    text-decoration: underline;
  }

  @media (max-width: 52rem) {
    .home-articles,
    .home-secondary {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-search {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 40rem) {
    .home-articles,
    .home-secondary {
      gap: 0.75rem;
    }

    .article-panel h2 {
      font-size: clamp(1.4rem, 5.8vw, 1.85rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .article-panel {
      animation: home-card-arrive 680ms var(--ease-settle) backwards;
    }

    .article-panel--pinned { animation-delay: 140ms; }

    [data-home-reveal='visible'] {
      animation: home-section-arrive 620ms var(--ease-settle) backwards;
    }

    .primary-link span,
    .panel-action i {
      transition: transform var(--motion-feedback) var(--ease-settle);
    }

    .primary-link:is(:hover, :focus-visible) span,
    :is(.project-panel, .music-panel):is(:hover, :focus-visible) .panel-action i {
      transform: translateX(0.2rem);
    }
  }

  @keyframes home-card-arrive {
    from { transform: translateY(0.7rem); }
  }

  @keyframes home-section-arrive {
    from { opacity: 0.55; transform: translateY(1.8rem); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
