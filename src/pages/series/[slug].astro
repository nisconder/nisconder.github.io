---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedSeries, type BlogSeries } from '../../lib/series'
import { getPostDescription, getPostReadingMinutes, getPostUrl } from '../../lib/posts'

interface Props { series: BlogSeries }
export const getStaticPaths = (async () => (await getPublishedSeries()).map(series => ({ params:{ slug:series.id }, props:{ series } }))) satisfies GetStaticPaths
const { series } = Astro.props
const firstPost = series.posts[0]
---

<BaseLayout title={series.data.title} description={series.data.description} canonical={series.href}>
  <div class="series-detail">
    <nav class="series-detail__breadcrumb" aria-label="当前位置"><a href="/series/">全部合集</a><span aria-hidden="true">/</span><span>合集目录</span></nav>
    <header class="series-detail__cover">
      <div class="series-detail__binding" aria-hidden="true"><span></span><span></span></div>
      <div>
        <p class="eyebrow">系列笔记 · {series.posts.length} 篇</p>
        <h1>{series.data.title}</h1>
        <p class="series-detail__description">{series.data.description}</p>
        {firstPost && <a class="series-detail__start" href={getPostUrl(firstPost)}>从第一篇开始 <span aria-hidden="true">→</span></a>}
      </div>
    </header>
    <section aria-labelledby="series-chapters-title">
      <div class="series-detail__heading"><h2 id="series-chapters-title">阅读目录</h2><span>按章节顺序阅读</span></div>
      <ol class="series-chapters">
        {series.posts.map((post,index) => <li>
          <span class="series-chapters__number" aria-hidden="true">{String(index + 1).padStart(2,'0')}</span>
          <div>
            <h3><a href={getPostUrl(post)}>{post.data.title}<span aria-hidden="true">↗</span></a></h3>
            <p>{getPostDescription(post)}</p>
            <small>约 {getPostReadingMinutes(post)} 分钟</small>
          </div>
        </li>)}
      </ol>
    </section>
    <a class="series-detail__back" href="/series/">← 返回全部合集</a>
  </div>
</BaseLayout>

<style>
  .series-detail { max-width:52rem; margin-inline:auto; }
  .series-detail__breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:.75rem; margin-block-end:1.5rem; color:var(--color-muted); font-size:.8125rem; }
  .series-detail__breadcrumb a { display:inline-flex; align-items:center; min-height:2.75rem; text-underline-offset:.25em; }
  .series-detail__cover { display:grid; grid-template-columns:2.5rem minmax(0,1fr); gap:clamp(1rem,4vw,2rem); padding-block:.5rem 2.5rem; }
  .series-detail__binding { display:flex; align-items:flex-start; gap:.35rem; padding-block-start:.25rem; }
  .series-detail__binding span { width:.9rem; height:5rem; border-radius:.2rem .2rem .5rem .5rem; background:var(--color-accent-primary, var(--color-primary)); }
  .series-detail__binding span:last-child { height:3.5rem; margin-block-start:.75rem; background:var(--color-accent-secondary, var(--color-secondary)); }
  .series-detail__cover h1 { margin:0 0 1.2rem; font-family:var(--font-display); font-size:clamp(1.9rem,4.5vw,3rem); font-weight:600; line-height:1.35; letter-spacing:-.035em; overflow-wrap:anywhere; }
  .series-detail__description { max-width:42rem; margin:0; color:var(--color-muted); font-size:var(--text-base); line-height:1.9; }
  .series-detail__start { display:inline-flex; align-items:center; justify-content:space-between; min-height:2.75rem; gap:1.5rem; padding:.5rem 1rem; margin-block-start:1.5rem; border-radius:var(--control-radius, .65rem); background:var(--color-accent-primary, var(--color-primary)); color:var(--color-on-accent-primary, var(--color-on-primary)); font-size:.875rem; font-weight:650; text-decoration:none; box-shadow:var(--shadow-accent-control, none); }
  .series-detail__start:hover { background:var(--color-accent-secondary, var(--color-secondary)); color:var(--color-on-accent-secondary, var(--color-on-secondary)); }
  .series-detail__heading { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.5rem 1rem; padding-block:1.25rem; border-block:1px solid var(--color-line); }
  .series-detail__heading h2 { margin:0; font-family:var(--font-display); font-size:1.25rem; }
  .series-detail__heading > span { color:var(--color-muted); font-size:.75rem; }
  .series-chapters { padding:0; margin:0; list-style:none; }
  .series-chapters > li { display:grid; grid-template-columns:2.5rem minmax(0,1fr); gap:clamp(1rem,4vw,2rem); padding-block:1.5rem; border-block-end:1px solid var(--color-line); }
  .series-chapters__number { padding-block-start:.55rem; color:var(--color-secondary); font: .875rem/1.6 var(--font-utility); }
  .series-chapters h3 { margin:0 0 .35rem; font-family:var(--font-display); font-size:clamp(1.05rem,2vw,1.25rem); font-weight:600; line-height:1.6; }
  .series-chapters h3 a { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; min-height:2.75rem; padding-block:.3rem; color:var(--color-text); text-decoration:none; overflow-wrap:anywhere; }
  .series-chapters h3 a:hover { color:var(--color-primary); }
  .series-chapters h3 a > span { flex-shrink:0; color:var(--color-primary); font-size:.875rem; }
  .series-chapters p { margin:0 0 .5rem; color:var(--color-muted); font-size:.875rem; line-height:1.85; overflow-wrap:anywhere; }
  .series-chapters small { color:var(--color-muted); font-size:.75rem; }
  .series-detail__back { display:inline-flex; align-items:center; min-height:2.75rem; margin-block-start:1.5rem; font-size:.875rem; text-underline-offset:.25em; }
  @media (max-width:30rem) { .series-detail__cover, .series-chapters > li { grid-template-columns:1.5rem minmax(0,1fr); gap:.75rem; } .series-detail__binding { gap:.2rem; } .series-detail__binding span { width:.6rem; } }
</style>
