---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionMasthead from '../../components/SectionMasthead.astro'
import SeriesCard from '../../components/SeriesCard.astro'
import { getPublishedSeries } from '../../lib/series'
const series = await getPublishedSeries()
---

<BaseLayout title="合集" description="把同一个主题的笔记收在一起，沿着目录逐篇阅读。" canonical="/series/">
  <div class="series-index">
    <SectionMasthead title="系列合集" description={`${series.length} 个合集，沿着目录逐篇阅读。`}>
      <a class="series-index__link" href="/articles/">按时间浏览文章 <span aria-hidden="true">→</span></a>
    </SectionMasthead>
    <div class="series-index__list">
      {series.length ? series.map(item => <SeriesCard series={item} />) : <div class="empty-state"><h2>合集正在整理</h2><p>先到文章目录，读一篇感兴趣的笔记。</p><a href="/articles/">浏览文章 →</a></div>}
    </div>
  </div>
</BaseLayout>

<style>
  .series-index__link { display:inline-flex; align-items:center; gap:.5rem; min-height:2.75rem; font-size:var(--text-sm); text-underline-offset:.25em; }
  .series-index__list { display:grid; gap:2rem; }
</style>
