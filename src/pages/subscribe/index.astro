---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CopySubscriptionUrl from '../../components/CopySubscriptionUrl.astro'
import subscription from '../../data/gkd-subscription.json'

const rssUrl = 'https://nisconder.pages.dev/rss.xml'
const gkdUrl = 'https://nisconder.pages.dev/gkd/subscription.json5'
---

<BaseLayout title="订阅" description="订阅 Nisconder 的文章 RSS，或获取 GKD 规则订阅地址。">
  <div class="subscribe-page">
    <header class="page-intro subscribe-intro">
      <p class="eyebrow">RSS / GKD</p>
      <h1>订阅</h1>
      <p class="lede">订阅文章更新，或获取 GKD 规则。</p>
    </header>

    <section class="subscription-row subscription-row--rss" aria-labelledby="rss-title">
      <div class="subscription-object">
        <p class="eyebrow">文章更新</p>
        <h2 id="rss-title">文章 RSS</h2>
        <p>把地址添加到常用的 RSS 阅读器，新文章发布后就能在那里阅读。</p>
      </div>
      <div class="subscription-target">
        <CopySubscriptionUrl
          id="rss-url"
          url={rssUrl}
          label="RSS 地址"
          copyLabel="复制 RSS 地址"
          copyHint="在 RSS 阅读器中添加订阅，粘贴这个地址。"
          openLabel="打开 RSS"
        />
      </div>
    </section>

    <section class="subscription-row subscription-row--gkd" aria-labelledby="gkd-title">
      <div class="subscription-object">
        <p class="eyebrow">界面规则 <span class="subscription-version">v{subscription.version}</span></p>
        <h2 id="gkd-title">{subscription.name}</h2>
        <p>在 GKD 中添加此地址，获取规则更新，再按需要开启对应规则组。</p>
      </div>
      <div class="subscription-target">
        <CopySubscriptionUrl
          id="gkd-url"
          url={gkdUrl}
          label="GKD 订阅地址"
          copyLabel="复制 GKD 地址"
          copyHint="到 GKD 的「订阅」页点击「＋」，粘贴地址。"
          openLabel="打开 JSON 文件"
        />
        <nav class="subscription-links" aria-label="GKD 订阅说明">
          <a href="/gkd/">添加说明与备用地址 <span aria-hidden="true">→</span></a>
          <a href="/gkd/#updates">更新历史 <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .subscribe-page { max-width: 62rem; margin-inline: auto; }
  .subscribe-intro { margin-block-end: 2.5rem; }
  .subscribe-intro h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); }
  .subscription-row { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 4vw, 3rem); padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--color-line-strong); border-inline-start-width: 0.35rem; border-radius: var(--card-radius); background: var(--color-card); }
  .subscription-row + .subscription-row { margin-block-start: 1.25rem; }
  .subscription-row--rss { border-inline-start-color: var(--color-secondary); }
  .subscription-row--gkd { border-inline-start-color: var(--color-primary); }
  .subscription-object, .subscription-target { min-width: 0; }
  .subscription-object .eyebrow { display: flex; align-items: center; gap: 0.75rem; margin-block-end: 0.65rem; }
  .subscription-object h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.4rem, 2.3vw, 1.8rem); line-height: 1.4; overflow-wrap: anywhere; }
  .subscription-object > p:last-child { margin: 1rem 0 0; color: var(--color-muted); font-size: var(--text-sm); line-height: 1.8; }
  .subscription-version { padding: 0.1rem 0.5rem; border: 1px solid var(--color-line); border-radius: var(--card-radius); font-family: var(--font-utility); font-size: var(--text-xs); letter-spacing: 0; }
  .subscription-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin-block-start: 0.5rem; padding-block-start: 0.5rem; border-block-start: 1px solid var(--color-line); }
  .subscription-links a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.75rem; font-size: var(--text-sm); font-weight: 650; }
  @media (max-width: 46rem) {
    .subscription-row { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .subscription-object > p:last-child { margin-block-start: 0.65rem; }
  }
</style>
