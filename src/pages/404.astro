---
import SectionMasthead from "../components/SectionMasthead.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout
  title="页面未找到"
  description="你访问的页面不存在，或已经移动到新的地址。"
  noindex
>
  <SectionMasthead id="not-found-title" title="没有找到这个页面" description="页面可能改了名字，也可能从未存在。可以回到首页，或者直接搜索站内内容。">
    <span class="status-code" slot="before-title">404</span>
    <nav class="not-found__actions" aria-label="继续浏览">
      <a class="button" href="/">返回首页</a>
      <a class="text-link" href="/search/">搜索本站 →</a>
    </nav>
  </SectionMasthead>
</BaseLayout>

<style>
  .status-code { color: var(--color-primary); font: 700 0.87rem/1.7 var(--font-utility); }
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .text-link {
    margin-left: 0.35rem;
    font-size: 0.9rem;
  }

  @media (max-width: 34rem) {
    .not-found__actions {
      align-items: stretch;
    }

    .not-found__actions .button {
      flex: 1 1 auto;
    }

    .text-link {
      flex-basis: 100%;
      margin: 0.35rem 0 0;
    }
  }
</style>
