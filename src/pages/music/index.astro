---
import BaseLayout from '../../layouts/BaseLayout.astro'
import MusicTrackList from '../../components/MusicTrackList.astro'
import { getInterestJourney } from '../../lib/interests'
import {
  getNeteaseTrackUrl,
  getPlaylistTracks,
  isPlayableTrack,
  PLAYLIST_ID,
} from '../../lib/playlist'

const playlist = await getPlaylistTracks()
const playableEntries = playlist.flatMap((track, index) =>
  isPlayableTrack(track) ? [{ track, index }] : [],
)
const externalEntries = playlist.flatMap((track, index) =>
  isPlayableTrack(track) ? [] : [{ track, index }],
)
const playableTracks = playableEntries.map(({ track }) => track)
const playableIndexes = playableEntries.map(({ index }) => index)
const externalTracks = externalEntries.map(({ track }) => track)
const externalIndexes = externalEntries.map(({ index }) => index)
const playerIndexes = playableEntries.map((_, index) => index)
const initialTrack = playableTracks[0]
const audioPayload = playableEntries.map(({ track, index }) => ({
  id: String(track.id),
  playlistIndex: index,
  name: track.title,
  artist: track.author,
  url: track.audio,
  externalUrl: getNeteaseTrackUrl(track),
  cover: '/img/nisconder-avatar.png',
}))
const audioJson = JSON.stringify(audioPayload).replace(/</g, '\\u003c')
const interestPoints = await getInterestJourney('music')
---

<BaseLayout
  title='音乐'
  description={`Nisconder 的网易云收藏，其中 ${playableTracks.length} 首可在站内播放，其余曲目仅提供外部链接。`}
  comments
  commentsTitle='交换一首歌'
  commentsDescription='可以推荐最近在听的曲目，也可以写下你为什么喜欢它。'
  interestPoints={interestPoints}
>
  <section class='music-studio' aria-labelledby='music-title' data-music-studio>
    <header class='music-studio__sleeve'>
      <div class='music-studio__mark' aria-hidden='true'><span></span><span></span></div>
      <p class='eyebrow'>MUSIC / NETEASE</p>
      <div class='music-studio__copy'>
        <h1 id='music-title'>正在听</h1>
        <p>
          {playlist.length} 首收藏；{playableTracks.length} 首可站内播放，
          {externalTracks.length} 首仅在网易云打开。
        </p>
      </div>
      <a
        class='music-studio__external'
        href={`https://music.163.com/#/playlist?id=${PLAYLIST_ID}`}
        target='_blank'
        rel='noreferrer'
      >在网易云打开完整歌单 <span aria-hidden='true'>↗</span></a>
    </header>

    <div class='music-studio__deck'>
      <header class='music-studio__bar'>
        <div>
          <p class='eyebrow'>PLAYLIST / {PLAYLIST_ID}</p>
          <h2>最近反复播放</h2>
        </div>
        <button
          class='playlist-toggle'
          type='button'
          aria-controls='music-playlist-panel'
          aria-expanded='false'
          data-playlist-toggle
        >
          <span data-playlist-toggle-label>展开歌单</span>
          <span class='playlist-toggle__mark' aria-hidden='true'></span>
        </button>
      </header>

      <section class='music-player-shell' data-player-shell aria-label='APlayer 音乐播放器' aria-busy='true'>
        <div class='music-player' id='music-player' data-aplayer-mount>
          <p class='music-player__fallback'>正在载入 APlayer…</p>
        </div>
        <footer class='music-player__foot'>
          <p class='music-player__status' data-player-status role='status' aria-live='polite'>
            {initialTrack ? '正在载入 APlayer 1.10.1…' : '当前歌单没有可用的站内音频。'}
          </p>
          <a
            class='music-player__external'
            href={initialTrack ? getNeteaseTrackUrl(initialTrack) : `https://music.163.com/#/playlist?id=${PLAYLIST_ID}`}
            target='_blank'
            rel='noreferrer'
            data-player-external
          >当前曲目 · 网易云 <span aria-hidden='true'>↗</span></a>
        </footer>
      </section>

      <div
        class='playlist-panel'
        id='music-playlist-panel'
        data-playlist-panel
        aria-hidden='true'
        inert
      >
        <div class='playlist-panel__inner'>
          <p class='playlist-panel__note'>
            站内播放器使用网易云公开音频地址；若曲目权限或直链临时不可用，可从歌曲链接继续。
          </p>
          <div class='playlist-panel__groups'>
            <section class='playlist-group' aria-labelledby='playable-tracks-title'>
              <header class='playlist-group__header'>
                <h3 id='playable-tracks-title'>可站内播放</h3>
                <span>{playableTracks.length} 首</span>
              </header>
              {
                playableTracks.length > 0 ? (
                  <MusicTrackList
                    tracks={playableTracks}
                    indexes={playableIndexes}
                    playerIndexes={playerIndexes}
                    label='可站内播放的曲目'
                  />
                ) : (
                  <p class='playlist-group__empty'>暂时没有可用音频。</p>
                )
              }
            </section>

            <section class='playlist-group playlist-group--external' aria-labelledby='external-tracks-title'>
              <header class='playlist-group__header'>
                <h3 id='external-tracks-title'>仅外部打开</h3>
                <span>{externalTracks.length} 首</span>
              </header>
              {
                externalTracks.length > 0 ? (
                  <MusicTrackList
                    tracks={externalTracks}
                    indexes={externalIndexes}
                    label='仅能在网易云打开的曲目'
                  />
                ) : (
                  <p class='playlist-group__empty'>当前所有曲目都可站内播放。</p>
                )
              }
            </section>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type='application/json' data-player-tracks set:html={audioJson}></script>
</BaseLayout>

<script is:inline data-astro-rerun>
  (() => {
    // Load player assets after the page swap. A stylesheet in the destination's
    // head would make Astro wait for the CDN before displaying the music page.
    const loadAPlayerStyles = () => {
      const href = 'https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css'
      const existing = document.querySelector(`link[rel="stylesheet"][href="${href}"]`)
      if (existing?.sheet) return { promise: Promise.resolve(), cancel: () => {} }

      const link = existing || document.createElement('link')
      link.rel = 'stylesheet'
      link.href = href
      link.crossOrigin = 'anonymous'
      link.referrerPolicy = 'no-referrer'
      let finish
      let settled = false
      let timeout
      const promise = new Promise((resolve, reject) => {
        finish = (error) => {
          if (settled) return
          settled = true
          window.clearTimeout(timeout)
          link.removeEventListener('load', onLoad)
          link.removeEventListener('error', onError)
          if (error) {
            link.remove()
            reject(error)
          } else {
            resolve()
          }
        }
        function onLoad() { finish() }
        function onError() { finish(new Error('APlayer stylesheet failed to load')) }
        link.addEventListener('load', onLoad, { once: true })
        link.addEventListener('error', onError, { once: true })
        timeout = window.setTimeout(() => finish(new Error('APlayer stylesheet loading timed out')), 15000)
      })

      if (!existing) {
        // Keep site/theme overrides later in the cascade, even though the
        // player's base stylesheet is inserted asynchronously.
        const firstStyle = document.head.querySelector('style, link[rel="stylesheet"]')
        document.head.insertBefore(link, firstStyle)
      }
      return {
        promise,
        cancel: () => finish(new DOMException('Music page was left', 'AbortError')),
      }
    }

    const loadAPlayer = () => {
      if (typeof window.APlayer === 'function') {
        return { promise: Promise.resolve(window.APlayer), cancel: () => {} }
      }
      if (window.__nisconderAPlayerLibrary) return window.__nisconderAPlayerLibrary

      const script = document.createElement('script')
      script.src = 'https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js'
      script.crossOrigin = 'anonymous'
      script.referrerPolicy = 'no-referrer'
      let finish
      let settled = false
      let timeout
      const promise = new Promise((resolve, reject) => {
        finish = (error) => {
          if (settled) return
          settled = true
          window.clearTimeout(timeout)
          script.removeEventListener('load', onLoad)
          script.removeEventListener('error', onError)
          if (error) {
            script.remove()
            reject(error)
          } else {
            resolve(window.APlayer)
          }
        }
        function onLoad() {
          finish(typeof window.APlayer === 'function' ? null : new Error('APlayer is unavailable'))
        }
        function onError() {
          finish(new Error('APlayer failed to load'))
        }
        script.addEventListener('load', onLoad, { once: true })
        script.addEventListener('error', onError, { once: true })
        timeout = window.setTimeout(() => finish(new Error('APlayer loading timed out')), 15000)
      })
      const request = {
        promise,
        cancel: () => finish(new DOMException('Music page was left', 'AbortError')),
      }
      window.__nisconderAPlayerLibrary = request
      promise.catch(() => {
        if (window.__nisconderAPlayerLibrary === request) delete window.__nisconderAPlayerLibrary
      })
      document.head.append(script)
      return request
    }

    const initialise = () => {
      const studio = document.querySelector('[data-music-studio]')
      const mount = document.querySelector('[data-aplayer-mount]')
      const shell = document.querySelector('[data-player-shell]')
      const status = document.querySelector('[data-player-status]')
      const tracksNode = document.querySelector('[data-player-tracks]')
      const listToggle = document.querySelector('[data-playlist-toggle]')
      const listToggleLabel = document.querySelector('[data-playlist-toggle-label]')
      const listPanel = document.querySelector('[data-playlist-panel]')
      const externalNode = document.querySelector('[data-player-external]')
      const trackControls = [...document.querySelectorAll('[data-track-control]')]

      if (!(mount instanceof HTMLElement) || mount.dataset.playerBound === 'true') return
      mount.dataset.playerBound = 'true'

      const lifecycle = new AbortController()
      let disposed = false
      let libraryRequest
      let stylesheetRequest
      let resourcesLoading = false
      let resourceRevision = 0
      let trackFrame
      let statusAnimation
      let mountAnimation
      const active = () => !disposed && mount.isConnected

      let tracks = []
      try {
        const parsed = JSON.parse(tracksNode?.textContent || '[]')
        tracks = Array.isArray(parsed)
          ? parsed.filter((track) => track && typeof track.url === 'string' && track.url.length > 0)
          : []
      } catch {
        tracks = []
      }

      let player
      let listExpanded = false
      const failedIndexes = new Set()
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

      const setStatus = (message, state = 'loading') => {
        if (!active() || !status) return
        const changed = status.textContent !== message || status.dataset.state !== state
        status.textContent = message
        status.dataset.state = state
        if (changed && !reducedMotion.matches) {
          statusAnimation?.cancel()
          statusAnimation = status.animate(
            [{ opacity: 0.35 }, { opacity: 1 }],
            { duration: 160, easing: 'ease-out' },
          )
        }
      }

      const setListState = (expanded) => {
        if (!active()) return
        listExpanded = expanded
        studio?.classList.toggle('is-list-open', expanded)
        listToggle?.setAttribute('aria-expanded', String(expanded))
        if (listToggleLabel) listToggleLabel.textContent = expanded ? '关闭歌单' : '展开歌单'
        if (listPanel) {
          listPanel.setAttribute('aria-hidden', String(!expanded))
          listPanel.toggleAttribute('inert', !expanded)
        }
      }

      const activeIndex = () => {
        const index = Number(player?.list?.index)
        return Number.isInteger(index) && index >= 0 ? index : 0
      }

      const currentTrack = () => tracks[activeIndex()]

      const setDurationPlaceholder = () => {
        if (!active()) return
        const duration = Number(player?.audio?.duration)
        const durationNode = mount.querySelector('.aplayer-dtime')
        if (durationNode && (!Number.isFinite(duration) || duration <= 0)) {
          durationNode.textContent = '--:--'
        }
      }

      const syncTrackRows = () => {
        if (!active()) return
        const current = activeIndex()
        const playing = Boolean(player?.audio && !player.audio.paused)

        trackControls.forEach((control) => {
          const index = Number(control.dataset.trackIndex)
          const state = control.querySelector('[data-track-state]')
          const isCurrent = index === current
          const failed = failedIndexes.has(index)
          const isPlaying = isCurrent && playing

          control.toggleAttribute('aria-current', isCurrent)
          control.setAttribute('aria-pressed', String(isPlaying))
          control.dataset.trackError = String(failed)
          control.setAttribute(
            'aria-label',
            failed
              ? '音频暂不可用；再次点击可重试'
              : isPlaying
                ? '暂停当前曲目'
                : isCurrent
                  ? '继续播放当前曲目'
                  : '用 APlayer 播放这首歌',
          )

          if (state) {
            state.textContent = failed
              ? '暂不可播'
              : isPlaying
                ? '播放中'
                : isCurrent
                  ? '继续播放'
                  : '站内播放'
          }
        })
      }

      const syncCurrentTrack = () => {
        if (!active()) return
        const track = currentTrack()
        if (track && externalNode) externalNode.href = track.externalUrl
        syncTrackRows()
      }

      const setPlaying = (playing) => {
        if (!active()) return
        studio?.classList.toggle('is-playing', playing)
        syncTrackRows()
      }

      const setReadyStatus = () => {
        const track = currentTrack()
        const playing = Boolean(player?.audio && !player.audio.paused)
        setPlaying(playing)
        setStatus(
          track
            ? playing
              ? '正在播放“' + track.name + '”'
              : '“' + track.name + '”已准备播放'
            : playing
              ? '正在播放当前曲目'
              : '音频已准备',
          'ready',
        )
      }

      const handlePlayFailure = (error) => {
        if (!active() || error?.name === 'AbortError') return
        const index = activeIndex()
        failedIndexes.add(index)
        setPlaying(false)
        setStatus('浏览器没有开始播放；可再点一次，或在网易云打开当前曲目。', 'error')
      }

      const playAt = (index) => {
        if (!active() || !player || !tracks[index]) return

        failedIndexes.delete(index)
        if (index !== activeIndex()) player.list.switch(index)
        syncCurrentTrack()

        try {
          const request = player.play()
          if (request && typeof request.catch === 'function') request.catch(handlePlayFailure)
        } catch (error) {
          handlePlayFailure(error)
        }
      }

      listToggle?.addEventListener('click', () => setListState(!listExpanded), { signal: lifecycle.signal })

      trackControls.forEach((control) => {
        control.addEventListener('click', () => {
          const index = Number(control.dataset.trackIndex)
          if (!Number.isInteger(index) || !tracks[index] || !player) return

          if (index === activeIndex() && !player.audio.paused) {
            player.pause()
            return
          }

          playAt(index)
        }, { signal: lifecycle.signal })
      })

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && listExpanded) {
          setListState(false)
          listToggle?.focus()
        }
      }, { signal: lifecycle.signal })

      const failLibraryLoad = (allowRetry = true) => {
        if (!active()) return
        shell?.setAttribute('aria-busy', 'false')
        mount.replaceChildren()
        const fallback = document.createElement('p')
        fallback.className = 'music-player__fallback'
        fallback.textContent = 'APlayer 资源未能载入；可以重试，或在网易云打开歌单。'
        mount.append(fallback)
        if (allowRetry) {
          const retry = document.createElement('button')
          retry.type = 'button'
          retry.className = 'button secondary music-player__retry'
          retry.textContent = '重新加载播放器'
          retry.addEventListener('click', loadPlayerResources, { once: true, signal: lifecycle.signal })
          mount.append(retry)
        }
        setStatus('播放器资源载入失败；外部歌曲链接仍可使用。', 'error')
      }

      const createPlayer = () => {
        if (!active() || player) return true
        if (typeof window.APlayer !== 'function') return false
        if (tracks.length === 0) {
          failLibraryLoad(false)
          setStatus('当前歌单没有可用的站内音频；请在网易云打开完整歌单。', 'error')
          return true
        }

        try {
          player = new window.APlayer({
            container: mount,
            audio: tracks.map(({ name, artist, url, cover }) => ({
              name,
              artist,
              url,
              cover,
            })),
            autoplay: false,
            loop: 'all',
            order: 'list',
            preload: 'metadata',
            volume: 0.72,
            mutex: true,
            listFolded: true,
            listMaxHeight: '0px',
            lrcType: 0,
            theme: '#6b5878',
            storageName: 'nisconder-music-player',
          })
        } catch {
          failLibraryLoad()
          return true
        }

        if (!reducedMotion.matches) {
          mountAnimation = mount.animate(
            [{ opacity: 0 }, { opacity: 1 }],
            { duration: 180, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
          )
        }

        const onPlayer = (event, callback) => player.on(event, (...args) => {
          if (active()) callback(...args)
        })

        onPlayer('play', () => {
          failedIndexes.delete(activeIndex())
          shell?.setAttribute('aria-busy', 'false')
          setPlaying(true)
          setStatus('正在播放“' + (currentTrack()?.name || '当前曲目') + '”', 'ready')
        })

        onPlayer('pause', () => {
          setPlaying(false)
          const track = currentTrack()
          setStatus(track ? '已暂停“' + track.name + '”' : '播放已暂停', 'ready')
        })

        onPlayer('ended', () => {
          setPlaying(false)
          const track = currentTrack()
          setStatus(track ? '“' + track.name + '”播放完毕' : '当前曲目播放完毕', 'ready')
        })

        onPlayer('listswitch', () => {
          shell?.setAttribute('aria-busy', 'true')
          setPlaying(false)
          cancelAnimationFrame(trackFrame)
          trackFrame = requestAnimationFrame(() => {
            if (!active()) return
            syncCurrentTrack()
            setDurationPlaceholder()
            const track = currentTrack()
            setStatus(track ? '正在读取“' + track.name + '”的音频信息…' : '正在切换曲目…')
          })
        })

        onPlayer('loadstart', () => {
          shell?.setAttribute('aria-busy', 'true')
          setDurationPlaceholder()
        })

        onPlayer('loadedmetadata', () => {
          shell?.setAttribute('aria-busy', 'false')
          setReadyStatus()
        })

        onPlayer('canplay', () => {
          shell?.setAttribute('aria-busy', 'false')
          setReadyStatus()
        })

        onPlayer('stalled', () => {
          setStatus('网易云音频载入较慢；可以稍候，或打开当前曲目链接。', 'error')
        })

        onPlayer('error', () => {
          failedIndexes.add(activeIndex())
          shell?.setAttribute('aria-busy', 'false')
          setPlaying(false)
          setDurationPlaceholder()
          setStatus('这首歌暂时无法站内播放；请在网易云打开，或切换下一首。', 'error')
        })

        syncCurrentTrack()
        setDurationPlaceholder()
        setStatus('APlayer 已就绪，点击封面或曲目开始播放。', 'ready')
        return true
      }

      const loadPlayerResources = () => {
        if (!active() || resourcesLoading || player) return
        resourcesLoading = true
        const revision = ++resourceRevision
        shell?.setAttribute('aria-busy', 'true')
        mount.replaceChildren()
        const placeholder = document.createElement('p')
        placeholder.className = 'music-player__fallback'
        placeholder.textContent = '正在载入 APlayer…'
        mount.append(placeholder)
        setStatus('正在载入 APlayer 1.10.1…')
        stylesheetRequest = loadAPlayerStyles()
        libraryRequest = loadAPlayer()
        Promise.all([stylesheetRequest.promise, libraryRequest.promise]).then(() => {
          if (!active() || revision !== resourceRevision) return
          resourcesLoading = false
          createPlayer()
        }).catch((error) => {
          if (!active() || revision !== resourceRevision) return
          resourcesLoading = false
          stylesheetRequest?.cancel()
          libraryRequest?.cancel()
          if (error?.name !== 'AbortError') failLibraryLoad()
        })
      }

      document.addEventListener('astro:before-swap', () => {
        player?.audio?.pause()
      }, { signal: lifecycle.signal })

      document.addEventListener('astro:after-swap', () => {
        if (mount.isConnected) return
        disposed = true
        resourceRevision += 1
        lifecycle.abort()
        libraryRequest?.cancel()
        stylesheetRequest?.cancel()
        cancelAnimationFrame(trackFrame)
        statusAnimation?.cancel()
        mountAnimation?.cancel()
        const audio = player?.audio
        try {
          player?.destroy()
        } finally {
          audio?.pause()
          audio?.removeAttribute('src')
          audio?.load()
          player = undefined
        }
      }, { signal: lifecycle.signal })

      setListState(false)
      loadPlayerResources()
    }

    initialise()
  })()
</script>

<style>
  .music-studio {
    display: grid;
    grid-template-columns: minmax(15rem, 0.34fr) minmax(0, 1fr);
    align-items: start;
    gap: 0.9rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }

  .music-studio__sleeve,
  .music-studio__deck {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: calc(var(--card-radius) - 0.15rem);
  }

  .music-studio__sleeve {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.6rem);
    background: var(--color-media-soft);
  }

  .music-studio__sleeve::after {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 0.38rem;
    background: var(--color-secondary);
    content: '';
  }

  .music-studio__mark {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
  }

  .music-studio__mark span {
    position: absolute;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.55rem;
    transition: transform 260ms ease;
  }

  .music-studio__mark span:first-child {
    inset: 0 auto auto 0;
    background: var(--color-reading-panel);
  }

  .music-studio__mark span:last-child {
    inset: auto 0 0 auto;
    background: var(--color-media-panel);
  }

  .music-studio.is-playing .music-studio__mark span:first-child {
    transform: translate(-0.12rem, -0.12rem);
  }

  .music-studio.is-playing .music-studio__mark span:last-child {
    transform: translate(0.12rem, 0.12rem);
  }

  .music-studio__sleeve > .eyebrow {
    margin-block: 0.75rem 0;
  }

  .music-studio__copy h1,
  .music-studio__copy p {
    margin: 0;
  }

  .music-studio__copy h1 {
    margin-block-end: 0.75rem;
    font-size: clamp(2.35rem, 4.6vw, 3.45rem);
    line-height: 1;
  }

  .music-studio__copy p {
    color: var(--color-muted);
    line-height: 1.6;
  }

  .music-studio__external {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    margin-block-start: 0.35rem;
    border-block-start: 1px solid var(--color-line-strong);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }

