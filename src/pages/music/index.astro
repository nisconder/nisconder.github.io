---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ListeningAudio from '../../components/ListeningAudio.astro'
import MusicTrackList from '../../components/MusicTrackList.astro'
import RecordTurntable from '../../components/RecordTurntable.astro'
import SectionMasthead from '../../components/SectionMasthead.astro'
import { getInterestJourney } from '../../lib/interests'
import {
  getNeteaseTrackUrl,
  getPlaylistTracks,
  isPlayableTrack,
  PLAYLIST_ID,
} from '../../lib/playlist'

const playlist = await getPlaylistTracks()
const playableEntries = playlist.flatMap((track, index) =>
  isPlayableTrack(track) ? [{ track, index }] : [],
)
const externalEntries = playlist.flatMap((track, index) =>
  isPlayableTrack(track) ? [] : [{ track, index }],
)
const playableTracks = playableEntries.map(({ track }) => track)
const playableIndexes = playableEntries.map(({ index }) => index)
const externalTracks = externalEntries.map(({ track }) => track)
const externalIndexes = externalEntries.map(({ index }) => index)
const playerIndexes = playableEntries.map((_, index) => index)
const initialTrack = playableTracks[0]
const previewCount = 5
const audioPayload = playableEntries.map(({ track, index }) => ({
  id: String(track.id),
  playlistIndex: index,
  name: track.title,
  artist: track.author,
  url: track.audio,
  externalUrl: getNeteaseTrackUrl(track),
}))
const audioJson = JSON.stringify(audioPayload).replace(/</g, '\\u003c')
const interestPoints = await getInterestJourney('music')
---

<BaseLayout
  title='音乐'
  description={`Nisconder 的网易云收藏，其中 ${playableTracks.length} 首可在站内播放，其余曲目仅提供外部链接。`}
  comments
  commentsTitle='交换一首歌'
  commentsDescription='可以推荐最近在听的曲目，也可以写下你为什么喜欢它。'
  interestPoints={interestPoints}
>
  <SectionMasthead title="音乐收藏" id="music-title" description={`${playlist.length} 首收藏，其中 ${playableTracks.length} 首可在站内试听。`}>
    <a class="music-library-link" href={`https://music.163.com/#/playlist?id=${PLAYLIST_ID}`} target="_blank" rel="noreferrer">网易云歌单 <span aria-hidden="true">↗</span></a>
  </SectionMasthead>

  <section class="music-studio" aria-labelledby="music-title" data-music-studio data-total={playlist.length} data-preview-count={previewCount}>
    <section class="music-console" id="music-console" aria-label="唱片播放器" data-player-shell aria-busy="false">
      {initialTrack ? (
        <RecordTurntable track={initialTrack} mode="player">
          <div class="studio-transport">
            <button type="button" data-disc-step="-1" aria-label="上一首" title="上一首"><span class="transport-icon transport-icon--previous" aria-hidden="true"></span></button>
            <button type="button" class="studio-play" data-disc-toggle><span class="transport-icon transport-icon--play" aria-hidden="true"></span><span data-disc-action>试听</span></button>
            <button type="button" data-disc-step="1" aria-label="下一首" title="下一首"><span class="transport-icon transport-icon--next" aria-hidden="true"></span></button>
          </div>
        </RecordTurntable>
      ) : <p class="studio-empty">目前的收藏可在网易云打开。</p>}
      <div class="music-engine" data-aplayer-mount id="music-player"></div>
      <ListeningAudio />
      <footer class="music-console__foot">
        <p data-player-status role="status" aria-live="polite">{initialTrack ? '选择一首歌开始试听。' : '暂无站内音频。'}</p>
        <a href={initialTrack ? getNeteaseTrackUrl(initialTrack) : `https://music.163.com/#/playlist?id=${PLAYLIST_ID}`} target="_blank" rel="noreferrer" data-player-external>在网易云听 <span aria-hidden="true">↗</span></a>
      </footer>
    </section>

    <section class="studio-library" aria-labelledby="library-title">
      <header class="studio-library__head">
        <h2 id="library-title">歌单</h2>
        <span>{playlist.length} 首</span>
      </header>
      <div id="music-playlist-panel" data-playlist-panel>
        <section class="studio-group" aria-labelledby="playable-tracks-title">
          <h3 id="playable-tracks-title">站内试听 <span>{playableTracks.length}</span></h3>
          {playableTracks.length ? (
            <MusicTrackList tracks={playableTracks} indexes={playableIndexes} playerIndexes={playerIndexes} previewCount={previewCount} label="可站内播放的曲目" />
          ) : <p class="studio-empty">暂无可试听曲目。</p>}
        </section>
        {externalTracks.length > 0 && (
          <section class="studio-group studio-group--external" aria-labelledby="external-tracks-title">
            <h3 id="external-tracks-title">在网易云听 <span>{externalTracks.length}</span></h3>
            <MusicTrackList tracks={externalTracks} indexes={externalIndexes} label="仅能在网易云打开的曲目" />
          </section>
        )}
      </div>
      {(playableTracks.length > previewCount || (playableTracks.length > 0 && externalTracks.length > 0)) && (
        <button class="library-more" type="button" data-playlist-toggle aria-expanded="true" aria-controls="music-playlist-panel" hidden>
          <span data-playlist-toggle-label>收起歌单</span><span aria-hidden="true">⌄</span>
        </button>
      )}
      {initialTrack && <a class="library-return" href="#music-console">回到唱盘 ↑</a>}
    </section>
  </section>

  <script is:inline type='application/json' data-player-tracks set:html={audioJson}></script>
  <noscript><style is:inline>.studio-transport, .turntable__surface, [data-track-control] { display: none; }</style></noscript>
</BaseLayout>

<script is:inline data-astro-rerun>
  (() => {
    // Load player assets after the page swap. A stylesheet in the destination's
    // head would make Astro wait for the CDN before displaying the music page.
    const loadAPlayerStyles = () => {
      const href = 'https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css'
      const existing = document.querySelector(`link[rel="stylesheet"][href="${href}"]`)
      if (existing?.sheet) return { promise: Promise.resolve(), cancel: () => {} }

      const link = existing || document.createElement('link')
      link.rel = 'stylesheet'
      link.href = href
      link.crossOrigin = 'anonymous'
      link.referrerPolicy = 'no-referrer'
      let finish
      let settled = false
      let timeout
      const promise = new Promise((resolve, reject) => {
        finish = (error) => {
          if (settled) return
          settled = true
          window.clearTimeout(timeout)
          link.removeEventListener('load', onLoad)
          link.removeEventListener('error', onError)
          if (error) {
            link.remove()
            reject(error)
          } else {
            resolve()
          }
        }
        function onLoad() { finish() }
        function onError() { finish(new Error('APlayer stylesheet failed to load')) }
        link.addEventListener('load', onLoad, { once: true })
        link.addEventListener('error', onError, { once: true })
        timeout = window.setTimeout(() => finish(new Error('APlayer stylesheet loading timed out')), 15000)
      })

      if (!existing) {
        // Keep site/theme overrides later in the cascade, even though the
        // player's base stylesheet is inserted asynchronously.
        const firstStyle = document.head.querySelector('style, link[rel="stylesheet"]')
        document.head.insertBefore(link, firstStyle)
      }
      return {
        promise,
        cancel: () => finish(new DOMException('Music page was left', 'AbortError')),
      }
    }

    const loadAPlayer = () => {
      if (typeof window.APlayer === 'function') {
        return { promise: Promise.resolve(window.APlayer), cancel: () => {} }
      }
      if (window.__nisconderAPlayerLibrary) return window.__nisconderAPlayerLibrary

      const script = document.createElement('script')
      script.src = 'https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js'
      script.crossOrigin = 'anonymous'
      script.referrerPolicy = 'no-referrer'
      let finish
      let settled = false
      let timeout
      const promise = new Promise((resolve, reject) => {
        finish = (error) => {
          if (settled) return
          settled = true
          window.clearTimeout(timeout)
          script.removeEventListener('load', onLoad)
          script.removeEventListener('error', onError)
          if (error) {
            script.remove()
            reject(error)
          } else {
            resolve(window.APlayer)
          }
        }
        function onLoad() {
          finish(typeof window.APlayer === 'function' ? null : new Error('APlayer is unavailable'))
        }
        function onError() {
          finish(new Error('APlayer failed to load'))
        }
        script.addEventListener('load', onLoad, { once: true })
        script.addEventListener('error', onError, { once: true })
        timeout = window.setTimeout(() => finish(new Error('APlayer loading timed out')), 15000)
      })
      const request = {
        promise,
        cancel: () => finish(new DOMException('Music page was left', 'AbortError')),
      }
      window.__nisconderAPlayerLibrary = request
      promise.catch(() => {
        if (window.__nisconderAPlayerLibrary === request) delete window.__nisconderAPlayerLibrary
      })
      document.head.append(script)
      return request
    }

    const initialise = () => {
      const studio = document.querySelector('[data-music-studio]')
      const mount = document.querySelector('[data-aplayer-mount]')
      const shell = document.querySelector('[data-player-shell]')
      const status = document.querySelector('[data-player-status]')
      const tracksNode = document.querySelector('[data-player-tracks]')
      const listToggle = document.querySelector('[data-playlist-toggle]')
      const listToggleLabel = document.querySelector('[data-playlist-toggle-label]')
      const externalNode = document.querySelector('[data-player-external]')
      const trackControls = [...document.querySelectorAll('[data-track-control]')]

      if (!(mount instanceof HTMLElement) || mount.dataset.playerBound === 'true') return
      mount.dataset.playerBound = 'true'

      const lifecycle = new AbortController()
      let disposed = false
      let libraryRequest
      let stylesheetRequest
      let resourcesLoading = false
      let resourceRevision = 0
      let trackFrame
      let statusAnimation
      let mountAnimation
      const active = () => !disposed && mount.isConnected

      let tracks = []
      try {
        const parsed = JSON.parse(tracksNode?.textContent || '[]')
        tracks = Array.isArray(parsed)
          ? parsed.filter((track) => track && typeof track.url === 'string' && track.url.length > 0)
          : []
      } catch {
        tracks = []
      }

      const disc = studio?.querySelector('record-turntable')
      const discTitle = disc?.querySelector('[data-disc-title]')
      const discArtist = disc?.querySelector('[data-disc-artist]')
      const discPosition = disc?.querySelector('[data-disc-position]')
      const platter = disc?.querySelector('.turntable__platter')
      const playButton = disc?.querySelector('[data-disc-toggle]')
      const surfaceButton = disc?.querySelector('[data-disc-surface]')
      const playLabel = disc?.querySelector('[data-disc-action]')
      const nativeAudio = document.querySelector('[data-native-audio]')
      const requestedId = window.location?.search ? new URLSearchParams(window.location.search).get('track') : null
      const carriedId = nativeAudio?.dataset.continueTrack
      let selectedIndex = Math.max(0, tracks.findIndex(track => track.id === (requestedId || carriedId)))
      let player
      let usingNative = false
      let listExpanded = false
      let playRevision = 0
      let changeAnimation
      const failedIndexes = new Set()
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      const media = () => player?.audio ?? (usingNative ? nativeAudio : null)
      const activeIndex = () => player?.list?.index ?? selectedIndex
      const currentTrack = () => tracks[activeIndex()]
      const options = { signal: lifecycle.signal }

      const setStatus = (message, state = 'loading') => {
        if (!active() || !status) return
        const changed = status.textContent !== message || status.dataset.state !== state
        status.textContent = message
        status.dataset.state = state
        if (changed && !reducedMotion.matches) {
          statusAnimation?.cancel()
          statusAnimation = status.animate([{ opacity: 0.45 }, { opacity: 1 }], { duration: 160 })
        }
      }

      const setListState = expanded => {
        if (!active() || !listToggle) return
        listExpanded = expanded
        studio.classList.toggle('has-preview', true)
        studio.classList.toggle('is-list-open', expanded)
        listToggle.hidden = false
        listToggle.setAttribute('aria-expanded', String(expanded))
        if (listToggleLabel) listToggleLabel.textContent = expanded ? '收起歌单' : '展开全部 ' + studio.dataset.total + ' 首'
      }

      const setDurationPlaceholder = () => {
        const duration = Number(media()?.duration)
        const node = mount.querySelector('.aplayer-dtime')
        if (node && !(duration > 0 && Number.isFinite(duration))) node.textContent = '--:--'
      }

      const syncTrackRows = () => {
        if (!active()) return
        const current = activeIndex()
        const playing = Boolean(media() && !media().paused && !media().ended && !failedIndexes.has(current))
        playButton?.toggleAttribute('data-active', playing)
        if (playLabel) playLabel.textContent = playing ? '暂停' : failedIndexes.has(current) ? '重试' : '试听'
        if (playButton && currentTrack()) {
          const name = playLabel.textContent + ' ' + currentTrack().name
          playButton.setAttribute('aria-label', name)
          surfaceButton?.setAttribute('aria-label', name)
        }
        trackControls.forEach(control => {
          const index = Number(control.dataset.trackIndex)
          const track = tracks[index]
          if (!track) return
          const isCurrent = index === current
          const failed = failedIndexes.has(index)
          const action = failed ? '重试' : isCurrent && playing ? '暂停' : '试听'
          control.setAttribute('aria-current', String(isCurrent))
          control.setAttribute('aria-pressed', String(isCurrent && playing))
          control.setAttribute('aria-label', action + ' ' + track.name + '，' + track.artist)
          control.dataset.trackError = String(failed)
          const state = control.querySelector('[data-track-state]')
          if (state) state.textContent = failed ? '重试' : isCurrent && playing
            ? disc?.hasAttribute('data-playing') ? '播放中' : '缓冲中'
            : isCurrent ? '已选中' : '试听'
        })
      }

      const syncCurrentTrack = (updateUrl = false) => {
        if (!active()) return
        const track = currentTrack()
        if (!track) return
        if (externalNode) externalNode.href = track.externalUrl
        if (disc && disc.dataset.trackId !== track.id) {
          disc.dataset.trackId = track.id
          changeAnimation?.cancel()
          if (platter && disc.hasAttribute('data-in-view') && !reducedMotion.matches) {
            changeAnimation = platter.animate([
              { transform: 'translate3d(-3px,-8px,20px) rotateX(-23deg)', opacity: 0.68 },
              { transform: 'translate3d(0,1px,3px) rotateX(3deg)', opacity: 1, offset: 0.72 },
              { transform: 'translateZ(4px)' },
            ], { duration: 430, easing: 'cubic-bezier(.22,.7,.24,1)' })
          }
        }
        if (discTitle) discTitle.textContent = track.name
        if (discArtist) discArtist.textContent = track.artist
        if (discPosition) discPosition.textContent = String(track.playlistIndex + 1).padStart(2, '0') + ' / ' + studio.dataset.total
        if (updateUrl && window.location) {
          const url = new URL(window.location.href)
          if (url.searchParams.get('track') !== track.id) {
            url.searchParams.set('track', track.id)
            window.history.replaceState(window.history.state, '', url)
          }
        }
        syncTrackRows()
      }

      const setPlaying = playing => {
        if (!active()) return
        studio?.classList.toggle('is-playing', playing)
        disc?.toggleAttribute('data-playing', playing)
        syncTrackRows()
      }

      const setReadyStatus = () => {
        const audio = media()
        const playing = Boolean(audio && !audio.paused && !audio.ended && (audio.readyState ?? 4) >= 3)
        setPlaying(playing)
        if (failedIndexes.has(activeIndex())) return
        if (audio && !audio.paused && !audio.ended && !playing) setStatus('音频缓冲中…')
        else setStatus(playing ? '正在播放' : '已就绪，可以试听。', 'ready')
      }

      const handlePlayFailure = error => {
        if (!active() || error?.name === 'AbortError') return
        failedIndexes.add(activeIndex())
        setPlaying(false)
        shell?.setAttribute('aria-busy', 'false')
        setStatus('这首歌暂时无法试听，可重试或在网易云听。', 'error')
      }

      const enableNative = (keepSource = false) => {
        if (player || usingNative || !nativeAudio) return
        usingNative = true
        resourceRevision++
        libraryRequest?.cancel()
        stylesheetRequest?.cancel()
        if (!keepSource) nativeAudio.src = currentTrack().url
        nativeAudio.hidden = false
        mount.hidden = true
        shell?.setAttribute('aria-busy', 'false')
      }

      const selectTrack = (index, updateUrl) => {
        if (!tracks[index]) return
        if (index !== activeIndex()) {
          ++playRevision
          selectedIndex = index
          setPlaying(false)
          if (player) player.list.switch(index)
          else if (usingNative) nativeAudio.src = tracks[index].url
        }
        syncCurrentTrack(updateUrl)
      }

      const playAt = index => {
        if (!active() || !tracks[index]) return
        if (!player) enableNative()
        if (!media()) return
        selectTrack(index, true)
        const revision = ++playRevision
        if (failedIndexes.delete(index)) media().load()
        try {
          const request = player ? player.play() : nativeAudio.play()
          request?.catch?.(error => {
            if (revision === playRevision && index === activeIndex()) handlePlayFailure(error)
          })
        } catch (error) { handlePlayFailure(error) }
      }

      const togglePlayback = index => {
        if (index === activeIndex() && media() && !media().paused && !failedIndexes.has(index)) {
          ++playRevision
          if (player) player.pause()
          else nativeAudio.pause()
        } else playAt(index)
      }

      listToggle?.addEventListener('click', () => setListState(!listExpanded), options)
      playButton?.addEventListener('click', () => togglePlayback(activeIndex()), options)
      surfaceButton?.addEventListener('click', () => togglePlayback(activeIndex()), options)
      disc?.querySelectorAll('[data-disc-step]').forEach(button => button.addEventListener('click', () => {
        const index = (activeIndex() + Number(button.dataset.discStep) + tracks.length) % tracks.length
        if (media() && !media().paused && !failedIndexes.has(activeIndex())) playAt(index)
        else {
          selectTrack(index, true)
          setStatus('已选曲，点试听开始播放。', 'ready')
        }
      }, options))
      trackControls.forEach(control => control.addEventListener('click', () => togglePlayback(Number(control.dataset.trackIndex)), options))
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && listExpanded && studio.contains(document.activeElement)) {
          setListState(false)
          listToggle?.focus()
        }
      }, options)

      // A click while the enhanced player is loading uses the browser's own
      // audio element immediately. Only one engine owns playback per visit.
      if (nativeAudio) {
        const onNative = (event, callback) => nativeAudio.addEventListener(event, () => {
          if (usingNative && active()) callback()
        }, options)
        onNative('playing', () => {
          if (nativeAudio.paused) return
          setPlaying(true)
          setStatus('正在播放', 'ready')
        })
        onNative('pause', () => {
          if (!nativeAudio.paused) return
          setPlaying(false)
          if (!nativeAudio.error) setStatus('已暂停', 'ready')
        })
        onNative('waiting', () => { setPlaying(false); setStatus('音频缓冲中…') })
        onNative('loadedmetadata', setReadyStatus)
        onNative('error', () => handlePlayFailure(nativeAudio.error))
        onNative('ended', () => playAt((activeIndex() + 1) % tracks.length))
      }

      const failLibraryLoad = (allowRetry = true) => {
        if (!active()) return
        shell?.setAttribute('aria-busy', 'false')
        mount.replaceChildren()
        const fallback = document.createElement('p')
        fallback.className = 'music-player__fallback'
        fallback.textContent = '可直接用浏览器试听。'
        mount.append(fallback)
        if (allowRetry) {
          const retry = document.createElement('button')
          retry.type = 'button'
          retry.className = 'button secondary music-player__retry'
          retry.textContent = '重新载入增强播放器'
          retry.addEventListener('click', loadPlayerResources, { once: true, signal: lifecycle.signal })
          mount.append(retry)
        }
        setStatus('可直接点试听，使用浏览器播放。', 'error')
      }

      const createPlayer = () => {
        if (!active() || player || usingNative) return true
        if (typeof window.APlayer !== 'function') return false
        if (tracks.length === 0) {
          failLibraryLoad(false)
          setStatus('当前歌单没有可用的站内音频；请在网易云打开完整歌单。', 'error')
          return true
        }

        try {
          player = new window.APlayer({
            container: mount,
            audio: tracks.map(({ name, artist, url }) => ({ name, artist, url })),
            autoplay: false,
            loop: 'all',
            order: 'list',
            preload: 'metadata',
            volume: 0.72,
            mutex: true,
            listFolded: true,
            listMaxHeight: '0px',
            lrcType: 0,
            theme: '#6b5878',
            storageName: 'nisconder-music-player',
          })
        } catch {
          failLibraryLoad()
          return true
        }

        if (!reducedMotion.matches) {
          mountAnimation = mount.animate(
            [{ opacity: 0 }, { opacity: 1 }],
            { duration: 180, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
          )
        }

        const onPlayer = (event, callback) => player.on(event, (...args) => {
          if (active()) callback(...args)
        })

        const seekBar = mount.querySelector('.aplayer-bar-wrap')
        if (seekBar) {
          seekBar.tabIndex = 0
          seekBar.setAttribute('role', 'slider')
          seekBar.setAttribute('aria-label', '播放进度')
          seekBar.setAttribute('aria-valuemin', '0')
          const refreshTime = () => {
            const duration = player.audio.duration
            const known = duration > 0 && Number.isFinite(duration)
            const second = Math.floor(player.audio.currentTime || 0)
            seekBar.setAttribute('aria-disabled', String(!known))
            seekBar.setAttribute('aria-valuemax', String(known ? Math.floor(duration) : 0))
            seekBar.setAttribute('aria-valuenow', String(second))
            seekBar.setAttribute('aria-valuetext', Math.floor(second / 60) + ' 分 ' + second % 60 + ' 秒')
          }
          seekBar.addEventListener('keydown', event => {
            const audio = player.audio
            if (!Number.isFinite(audio.duration)) return
            const targets = { ArrowLeft: audio.currentTime - 5, ArrowRight: audio.currentTime + 5, Home: 0, End: audio.duration }
            if (!Object.hasOwn(targets, event.key)) return
            event.preventDefault()
            event.stopPropagation()
            player.seek(Math.max(0, Math.min(audio.duration, targets[event.key])))
            refreshTime()
          }, options)
          onPlayer('timeupdate', refreshTime)
          onPlayer('durationchange', refreshTime)
          refreshTime()
        }
        const volume = mount.querySelector('.aplayer-volume-wrap button')
        const labelVolume = () => volume?.setAttribute('aria-label', player.audio.muted || player.audio.volume === 0 ? '取消静音' : '静音')
        labelVolume()
        onPlayer('volumechange', labelVolume)
        mount.querySelector('.aplayer-icon-loop')?.setAttribute('aria-label', '切换循环模式')

        onPlayer('play', () => {
          failedIndexes.delete(activeIndex())
          shell?.setAttribute('aria-busy', 'false')
          if ((player.audio.readyState ?? 4) >= 3) setReadyStatus()
          else { setPlaying(false); setStatus('音频缓冲中…') }
        })
        onPlayer('playing', () => { setPlaying(true); setStatus('正在播放', 'ready') })
        onPlayer('waiting', () => { setPlaying(false); setStatus('音频缓冲中…') })

        onPlayer('pause', () => {
          setPlaying(false)
          if (!failedIndexes.has(activeIndex())) setStatus('已暂停', 'ready')
        })

        onPlayer('ended', () => {
          setPlaying(false)
          const track = currentTrack()
          setStatus(track ? '“' + track.name + '”播放完毕' : '当前曲目播放完毕', 'ready')
        })

        onPlayer('listswitch', () => {
          shell?.setAttribute('aria-busy', 'true')
          setPlaying(false)
          cancelAnimationFrame(trackFrame)
          trackFrame = requestAnimationFrame(() => {
            if (!active()) return
            syncCurrentTrack(true)
            setDurationPlaceholder()
            if (!failedIndexes.has(activeIndex())) setReadyStatus()
          })
        })

        onPlayer('loadstart', () => {
          shell?.setAttribute('aria-busy', 'true')
          setDurationPlaceholder()
        })

        onPlayer('loadedmetadata', () => {
          shell?.setAttribute('aria-busy', 'false')
          setReadyStatus()
        })

        onPlayer('canplay', () => {
          shell?.setAttribute('aria-busy', 'false')
          setReadyStatus()
        })

        onPlayer('stalled', () => {
          if (!player.audio.paused) { setPlaying(false); setStatus('音频缓冲中…') }
        })

        onPlayer('error', () => {
          handlePlayFailure(player.audio.error)
          setDurationPlaceholder()
        })

        if (selectedIndex !== player.list.index) player.list.switch(selectedIndex)
        syncCurrentTrack()
        setDurationPlaceholder()
        shell?.setAttribute('aria-busy', 'false')
        setStatus('已就绪，可以试听。', 'ready')
        return true
      }

      const loadPlayerResources = () => {
        if (!active() || resourcesLoading || player || usingNative) return
        resourcesLoading = true
        const revision = ++resourceRevision
        shell?.setAttribute('aria-busy', 'true')
        mount.replaceChildren()
        const placeholder = document.createElement('p')
        placeholder.className = 'music-player__fallback'
        placeholder.textContent = '正在准备播放器…'
        mount.append(placeholder)
        setStatus('选择一首歌开始试听。')
        stylesheetRequest = loadAPlayerStyles()
        libraryRequest = loadAPlayer()
        Promise.all([stylesheetRequest.promise, libraryRequest.promise]).then(() => {
          if (!active() || revision !== resourceRevision) return
          resourcesLoading = false
          createPlayer()
        }).catch((error) => {
          if (!active() || revision !== resourceRevision) return
          resourcesLoading = false
          stylesheetRequest?.cancel()
          libraryRequest?.cancel()
          if (error?.name !== 'AbortError') failLibraryLoad()
        })
      }

      document.addEventListener('astro:before-swap', () => {
        // Playback carries from the home preview into this page. Leaving it stops the song.
        nativeAudio?.removeAttribute('data-astro-transition-persist')
        media()?.pause()
      }, { signal: lifecycle.signal })

      const dispose = () => {
        if (disposed) return
        disposed = true
        resourceRevision += 1
        lifecycle.abort()
        libraryRequest?.cancel()
        stylesheetRequest?.cancel()
        cancelAnimationFrame(trackFrame)
        statusAnimation?.cancel()
        mountAnimation?.cancel()
        changeAnimation?.cancel()
        const audio = media()
        try {
          player?.destroy()
        } finally {
          audio?.pause()
          audio?.removeAttribute('src')
          audio?.load()
          player = undefined
        }
      }

      document.addEventListener('astro:after-swap', () => {
        if (!mount.isConnected) dispose()
      }, { signal: lifecycle.signal })

      window.addEventListener('pagehide', (event) => {
        media()?.pause()
        cancelAnimationFrame(trackFrame)
        statusAnimation?.cancel()
        mountAnimation?.cancel()
        // BFCache preserves this document and its controls. Only release the
        // player when the browser is actually discarding the page.
        if (!event.persisted) dispose()
      }, { signal: lifecycle.signal })

      window.addEventListener('pageshow', (event) => {
        if (!event.persisted || !active() || !media()) return
        syncCurrentTrack()
        setPlaying(false)
        setReadyStatus()
      }, { signal: lifecycle.signal })

      setListState(selectedIndex >= Number(studio?.dataset.previewCount) || tracks.length === 0)
      syncCurrentTrack()
      if (carriedId) {
        const shouldResume = nativeAudio.dataset.resume === 'true'
        delete nativeAudio.dataset.continueTrack
        delete nativeAudio.dataset.resume
        if (currentTrack()?.id === carriedId && nativeAudio.getAttribute('src') === currentTrack().url) {
          enableNative(true)
          setReadyStatus()
          if (!shouldResume) setStatus('已暂停', 'ready')
          else if (nativeAudio.paused) {
            // Some browsers pause a media element when it moves between parents.
            const revision = ++playRevision
            nativeAudio.play().catch(error => {
              if (!active() || revision !== playRevision) return
              if (error.name === 'NotAllowedError') setStatus('已保留进度，点试听继续。', 'ready')
              else handlePlayFailure(error)
            })
          }
          return
        }
        nativeAudio.pause()
        nativeAudio.removeAttribute('src')
        nativeAudio.load()
      }
      if (tracks.length) loadPlayerResources()
    }

    initialise()
  })()
</script>

