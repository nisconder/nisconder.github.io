---
import BaseLayout from "../../layouts/BaseLayout.astro"
import SectionMasthead from '../../components/SectionMasthead.astro'
import { getInterestJourney } from "../../lib/interests"

const interestPoints = await getInterestJourney('about')
---

<BaseLayout
  title="关于"
  description="关于 Nisconder、这个博客，以及我在这里持续记录的内容。"
  comments
  commentsTitle="关于页留言"
  commentsDescription="可以介绍自己、提出问题，或留下对本站的反馈。"
  interestPoints={interestPoints}
>
  <SectionMasthead title="关于 Nisconder" description="我在这里记录代码、阅读、音乐与生活观察，也公开自己持续维护的项目。">
    <nav class="about-compass" aria-label="关于页章节">
      <a href="#writing">正在写什么</a>
      <a href="#site">这个站如何运作</a>
      <a href="#contact">联系方式</a>
    </nav>
  </SectionMasthead>

  <div class="about-sections">
    <section id="writing" class="about-copy" data-note="我在写什么">
      <h2>我记录的内容</h2>
      <dl class="about-list">
        <div>
          <dt>技术笔记</dt>
          <dd>写代码时踩过的坑、搭过的服务和折腾过的工具。这个博客本身也是一路实践留下的结果。</dd>
        </div>
        <div>
          <dt>随笔与思考</dt>
          <dd>关于哲学、社会和文化现象的零碎想法。它们不一定给出答案，但会尽量把问题讲明白。</dd>
        </div>
        <div>
          <dt>音乐收藏</dt>
          <dd>用歌单保存某个阶段反复听过的音乐，偶尔也写几句与音乐有关的记忆。</dd>
        </div>
        <div>
          <dt>生活观察</dt>
          <dd>日常里突然冒出来的感受。没有宏大的主题，只因为当时觉得值得记下一笔。</dd>
        </div>
      </dl>
    </section>

    <section id="site" class="about-copy" data-note="关于本站">
      <h2>这个网站</h2>
      <p>
        站点由 Astro 生成静态页面并部署在 Cloudflare Pages。文章保存在仓库中，页面尽量少依赖客户端脚本，让阅读本身保持直接、稳定。
      </p>
      <p>
        这里不会追求高频更新。比起填满时间线，我更在意一篇文字过一段时间再看，仍然说得通。
      </p>
    </section>

    <section id="contact" class="about-copy" data-note="联系">
      <h2>找到我</h2>
      <ul class="contact-list">
        <li>
          <span>GitHub</span>
          <a href="https://github.com/nisconder" rel="me noreferrer">github.com/nisconder</a>
        </li>
        <li>
          <span>邮箱</span>
          <a href="mailto:72447244.wnm@gmail.com">72447244.wnm@gmail.com</a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .about-list {
    margin: 1.5rem 0 0;
  }

  .about-compass {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    max-width: 39rem;
  }

  .about-compass a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .about-compass a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-underline-offset: 0.25em;
  }

  .about-sections { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: 1rem; }
  .about-copy {
    min-width: 0;
    padding: clamp(1.15rem, 2.9vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: var(--card-radius);
    background: var(--color-card);
  }
  .about-copy:first-child {
    grid-row: span 2;
    border-block-start: 3px solid var(--color-primary);
    background: var(--feature-surface);
  }
  .about-copy > :last-child { margin-block-end: 0; }

  .about-copy h2 {
    margin-bottom: 1rem;
    font-size: var(--title-section);
    letter-spacing: -0.018em;
  }

  .about-copy > p {
    line-height: 1.8;
  }

  .about-copy > p + p {
    margin-top: 1.2rem;
  }

  .about-list > div {
    display: grid;
    grid-template-columns: minmax(7rem, 0.28fr) minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .about-list dt {
    font-weight: 650;
  }

  .about-list dd {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .contact-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: grid;
    grid-template-columns: minmax(7rem, 0.28fr) minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--color-line);
  }

  .contact-list span {
    color: var(--color-muted);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-list a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 54rem) {
    .about-sections { grid-template-columns: minmax(0, 1fr); }
    .about-copy:first-child { grid-row: auto; }
  }

  @media (max-width: 38rem) {
    .about-list > div,
    .contact-list li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .about-compass {
      gap: 0 0.85rem;
    }

  }
</style>
