---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostRow from '../../components/PostRow.astro'
import {
  formatPostDate,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../../lib/posts'

const posts = await getPublishedPosts()
---

<BaseLayout
  title="文章"
  description="按时间阅读 Nisconder 的技术、生活与思考。"
  canonical="/articles/"
  comments
  commentsTitle="聊聊这些文字"
  commentsDescription="不必针对某一篇文章。想讨论写作、选题，或者推荐一个值得继续展开的问题，都可以留言。"
>
  <header class="article-header articles-intro">
    <p class="article-kicker">Articles</p>
    <h1>文章</h1>
    <p>公开写作按时间排列，标题、摘要与标签都可以直接展开。</p>
    <a class="button" href="/search/">搜索文章</a>
  </header>

  <section class="axis-section" data-note="按时间">
    <div class="section-heading">
      <div>
        <p class="article-kicker">Archive</p>
        <h2>全部文章</h2>
      </div>
      <p>{posts.length} 篇</p>
    </div>

    {
      posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post) => (
            <PostRow
              href={getPostUrl(post)}
              title={post.data.title}
              description={getPostDescription(post)}
              date={formatPostDate(post.data.date)}
              datetime={getPostDateTime(post.data.date)}
              category={getPostCategory(post)}
              tags={getPostTags(post)}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h2>还没有公开文章</h2>
          <p>新文章发布后会按时间出现在这里。</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .articles-intro {
    max-width: none;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border: 1px solid var(--color-line-strong);
    border-inline-start: 0.5rem solid var(--color-primary);
    border-radius: var(--card-radius);
    background: var(--color-primary-soft);
  }

  .articles-intro > p:not(.article-kicker) {
    max-width: 34rem;
    color: var(--color-muted);
  }

  .articles-intro .button {
    margin-block-start: 0.75rem;
  }
</style>
