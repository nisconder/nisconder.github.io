---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionMasthead from '../../components/SectionMasthead.astro'
import PostRow from '../../components/PostRow.astro'
import SeriesCard from '../../components/SeriesCard.astro'
import { getPublishedSeries, getStandalonePosts } from '../../lib/series'
import { getInterestJourney } from '../../lib/interests'
import {
  formatPostDate,
  getPostCalendarParts,
  getPostCategory,
  getPostDateTime,
  getPostDescription,
  getPostReadingMinutes,
  getPostTags,
  getPostUrl,
  getPublishedPosts,
} from '../../lib/posts'

const [publishedPosts, series] = await Promise.all([getPublishedPosts(), getPublishedSeries()])
const posts = getStandalonePosts(publishedPosts, series)
const categoryCounts = new Map<string, number>()
const topicCounts = new Map<string, number>()
const postsByYear = new Map<string, typeof posts>()

// Index counts include every published article, including collection chapters.
for (const post of publishedPosts) {
  const category = getPostCategory(post)
  if (category) categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1)

  for (const tag of getPostTags(post)) {
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1)
  }
}

// The chronological list still displays only standalone articles.
for (const post of posts) {
  const { year } = getPostCalendarParts(post.data.date)
  const yearPosts = postsByYear.get(year)
  if (yearPosts) yearPosts.push(post)
  else postsByYear.set(year, [post])
}

const categories = [...categoryCounts].sort(
  (left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'),
)
const categoryNames = new Set(categoryCounts.keys())
const topics = [...topicCounts]
  .filter(([topic]) => !categoryNames.has(topic))
  .sort(
    (left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'),
  )
const yearGroups = [...postsByYear].sort(
  (left, right) => Number(right[0]) - Number(left[0]),
)
const archiveViews = Object.fromEntries(['', ...categoryNames].map(category => {
  const matches = (post: typeof posts[number]) => !category || getPostCategory(post) === category
  const standalone = posts.filter(matches)
  const filtered = publishedPosts.filter(matches)
  const collections = Object.fromEntries(series.map(item => [item.id, item.posts.filter(matches).length]))
  const collectionCount = Object.values(collections).filter(count => count > 0).length
  const years = Object.fromEntries(yearGroups.map(([year, items]) => [year, items.filter(matches).length]))
  const tags = new Map<string, number>()
  for (const post of filtered) {
    for (const tag of getPostTags(post)) tags.set(tag, (tags.get(tag) ?? 0) + 1)
  }
  const chapterCount = filtered.length - standalone.length
  const summary = `${standalone.length} 篇独立文章` +
    (collectionCount ? ` · ${collectionCount} 个合集（含 ${chapterCount} 篇文章）` : '')
  return [category, { summary, years, collections, topics: Object.fromEntries(tags) }]
}))
const categoryHref = (category: string) => `/articles/?category=${encodeURIComponent(category)}`
const topicHref = (topic: string) =>
  `/search/?type=article&q=${encodeURIComponent(topic)}`
const interestPoints = await getInterestJourney('articles')
---

<BaseLayout
  title="文章"
  description="按正式发布日期阅读 Nisconder 的技术、生活与思考。"
  canonical="/articles/"
  comments
  commentsTitle="文章区留言"
  commentsDescription="可以讨论写作、选题，或推荐一个值得继续展开的问题。"
  interestPoints={interestPoints}
>
  <SectionMasthead title="文章" description="按时间浏览独立文章，按合集阅读系列笔记。">
    <form class="articles-search" action="/search/" method="get" role="search">
      <input type="hidden" name="type" value="article" />
      <div class="articles-search__field">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <input
          id="articles-search"
          name="q"
          type="search"
          aria-label="搜索文章"
          autocomplete="off"
          placeholder="标题、标签或正文关键词"
        />
        <button type="submit">搜索</button>
      </div>
    </form>
  </SectionMasthead>

  <div data-article-catalog>
  {(categories.length > 0 || topics.length > 0 || yearGroups.length > 0 || series.length > 0) && (
    <div class="articles-tools">
      {(yearGroups.length > 0 || series.length > 0 || topics.length > 0) && (
        <nav class="articles-jump-nav" aria-label="文章页内导航">
          {yearGroups.length > 0 && <a href="#archive" data-jump>按时间</a>}
          {series.length > 0 && <a href="#collections" data-jump>按合集</a>}
          {topics.length > 0 && <a href="#topics" data-jump>按主题</a>}
        </nav>
      )}

      {categories.length > 0 && (
        <nav id="categories" class="category-index" aria-label="按分类浏览文章">
          <span>分类</span>
          <a href="/articles/" data-archive-category="" aria-current="page">全部 <small>{publishedPosts.length}</small></a>
          {categories.map(([category, count]) => (
            <a href={categoryHref(category)} data-archive-category={category}>{category} <small>{count}</small></a>
          ))}
        </nav>
      )}
    </div>
  )}

  <p class="archive-summary" aria-live="polite" data-archive-summary>{archiveViews[''].summary}</p>
  <noscript>当前显示全部文章。启用 JavaScript 后可在本页筛选分类。</noscript>
  {yearGroups.length > 0 && (
    <div id="archive" class="articles-archive">
      {yearGroups.length > 1 && (
        <nav class="year-index" aria-label="按年份跳转">
          {yearGroups.map(([year, yearPosts]) => (
            <a href={`#year-${year}`} data-year-link={year}>{year} 年 <small>{yearPosts.length} 篇</small></a>
          ))}
        </nav>
      )}
      {yearGroups.map(([year, yearPosts]) => (
        <section id={`year-${year}`} class="year-archive" data-archive-year={year} aria-labelledby={`year-${year}-title`}>
          <header class="articles-section__heading">
            <h2 id={`year-${year}-title`}>{year} 年</h2>
            <span data-year-count>{yearPosts.length} 篇独立文章</span>
          </header>
          <div class="post-list">
            {yearPosts.map((post) => (
              <PostRow
                href={getPostUrl(post)}
                title={post.data.title}
                description={getPostDescription(post)}
                date={formatPostDate(post.data.date)}
                datetime={getPostDateTime(post.data.date)}
                readingMinutes={getPostReadingMinutes(post)}
                category={getPostCategory(post)}
                tags={getPostTags(post)}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  )}

  {series.length > 0 && (
    <section id="collections" class="articles-series" aria-labelledby="articles-series-title">
      <header class="articles-section__heading">
        <h2 id="articles-series-title">按合集阅读</h2>
        <a href="/series/">全部 {series.length} 个合集 <span aria-hidden="true">→</span></a>
      </header>
      {series.map(item => <div data-archive-series={item.id}>
        <p class="archive-match" data-matching-chapters hidden></p>
        <SeriesCard series={item} headingLevel={3} />
      </div>)}
    </section>
  )}

  {yearGroups.length === 0 && series.length === 0 && (
    <section class="year-archive">
      <h2>还没有已发布的文章</h2>
    </section>
  )}

  {topics.length > 0 && (
    <section id="topics" class="articles-topics" aria-labelledby="articles-topics-title">
      <header class="articles-section__heading">
        <h2 id="articles-topics-title">主题索引</h2>
        <span data-topic-count>{topics.length} 个主题</span>
      </header>
      <nav class="topic-index" aria-label="按主题浏览文章">
        {topics.map(([topic, count]) => (
          <a href={topicHref(topic)} data-archive-topic={topic}><span>{topic}</span> <small>{count} 篇</small></a>
        ))}
      </nav>
    </section>
  )}
  <script type="application/json" data-archive-views set:html={JSON.stringify(archiveViews).replace(/</g, '\\u003c')} />
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  (() => {
    const catalog = document.querySelector('[data-article-catalog]')
    if (!catalog || catalog.dataset.bound) return
    catalog.dataset.bound = 'true'
    const views = JSON.parse(catalog.querySelector('[data-archive-views]').textContent)
    const links = [...catalog.querySelectorAll('[data-archive-category]')]
    const lifecycle = new AbortController()
    const options = { signal: lifecycle.signal }
    const apply = () => {
      const requested = new URL(location.href).searchParams.get('category') || ''
      const category = Object.hasOwn(views, requested) ? requested : ''
      const view = views[category]
      catalog.querySelector('[data-archive-summary]').textContent = view.summary
      for (const link of links) {
        if (link.dataset.archiveCategory === category) link.setAttribute('aria-current', 'page')
        else link.removeAttribute('aria-current')
      }
      for (const post of catalog.querySelectorAll('[data-post-category]')) {
        post.hidden = Boolean(category && post.dataset.postCategory !== category)
      }
      for (const group of catalog.querySelectorAll('[data-archive-year]')) {
        const count = view.years[group.dataset.archiveYear]
        group.hidden = !count
        group.querySelector('[data-year-count]').textContent = count + ' 篇独立文章'
      }
      for (const link of catalog.querySelectorAll('[data-year-link]')) {
        const count = view.years[link.dataset.yearLink]
        link.hidden = !count
        link.querySelector('small').textContent = count + ' 篇'
      }
      for (const group of catalog.querySelectorAll('[data-archive-series]')) {
        const count = view.collections[group.dataset.archiveSeries]
        group.hidden = !count
        const note = group.querySelector('[data-matching-chapters]')
        note.hidden = !category || !count
        note.textContent = note.hidden ? '' : category + '分类收录本合集中的 ' + count + ' 篇。'
      }
      const topicLinks = [...catalog.querySelectorAll('[data-archive-topic]')]
      for (const link of topicLinks) {
        const topic = link.dataset.archiveTopic
        const count = Object.hasOwn(view.topics, topic) ? view.topics[topic] : 0
        link.hidden = !count
        link.querySelector('small').textContent = count + ' 篇'
      }
      const topicCount = catalog.querySelector('[data-topic-count]')
      if (topicCount) topicCount.textContent = topicLinks.filter(link => !link.hidden).length + ' 个主题'
      for (const [id, selector] of [['archive', '[data-archive-year]'], ['collections', '[data-archive-series]'], ['topics', '[data-archive-topic]']]) {
        const section = catalog.querySelector('#' + id)
        if (section) section.hidden = !section.querySelector(selector + ':not([hidden])')
        const jump = catalog.querySelector('[data-jump][href="#' + id + '"]')
        if (jump) jump.hidden = !section || section.hidden
      }
    }
    for (const link of links) {
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        event.preventDefault()
        if (location.href !== link.href) history.pushState(history.state, '', link.href)
        apply()
      }, options)
    }
    window.addEventListener('popstate', apply, options)
    document.addEventListener('astro:before-swap', () => lifecycle.abort(), { once: true, ...options })
    apply()
  })()
</script>

<style>
  [data-article-catalog] :global([hidden]) { display: none; }
  .archive-summary, .archive-match { margin: 0.65rem 0 0; color: var(--color-muted); font-size: var(--text-sm); }
  .archive-match { margin-block: 0 0.5rem; }
  [data-archive-series] + [data-archive-series] { margin-block-start: 1rem; }

  .articles-search {
    min-width: 0;
    width: min(100%, 27rem);
  }
  @media (min-width: 43rem) { .articles-search { width: clamp(17rem, 35vw, 27rem); } }

  .articles-search__field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.2rem 0.2rem 0.75rem;
    border: 1px solid var(--color-control-border);
    border-radius: var(--card-radius);
    background: var(--color-field);
  }

  .articles-search__field svg {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .articles-search__field input {
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    font-size: var(--text-sm);
  }

  .articles-search__field:focus-within {
    border-color: var(--color-primary);
  }

  .articles-search__field button {
    min-height: 2.75rem;
    padding-inline: clamp(0.75rem, 2vw, 1.2rem);
    border: 1px solid var(--color-reading);
    border-radius: calc(var(--card-radius) - 0.2rem);
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
    cursor: pointer;
    font-weight: 750;
  }

  .articles-search__field button:hover {
    background: var(--color-media-panel);
    color: var(--color-on-media-panel);
  }

  .articles-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    padding-block: 0.35rem;
    border-block: 1px solid var(--color-line);
  }

  .articles-jump-nav,
  .category-index,
  .year-index,
  .topic-index {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
  }

  .articles-jump-nav a,
  .category-index a,
  .year-index a,
  .topic-index a {
    display: inline-flex;
    min-width: 0;
    max-width: 100%;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .articles-jump-nav a {
    padding-inline: 0.25rem;
    font-weight: 700;
  }

  .articles-jump-nav a:is(:hover, :focus-visible),
  .year-index a:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .category-index a,
  .topic-index a {
    padding-inline: clamp(0.45rem, 1vw, 0.7rem);
    border: 1px solid var(--color-line);
    border-radius: calc(var(--card-radius) - 0.2rem);
    background: var(--color-card);
  }

  .category-index a:is(:hover, :focus-visible, [aria-current='page']),
  .topic-index a:is(:hover, :focus-visible) {
    border-color: var(--color-secondary);
    background: var(--color-secondary-soft);
    color: var(--color-secondary);
  }

  .category-index > span,
  .articles-section__heading > span,
  .articles-tools small,
  .year-index small,
  .topic-index small {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .articles-archive,
  .articles-series,
  .articles-topics,
  .year-archive {
    scroll-margin-block-start: 1rem;
  }

  .articles-archive,
  .articles-series,
  .articles-topics,
  .articles-tools + .year-archive {
    margin-block-start: clamp(1.5rem, 4vw, 2.75rem);
  }

  .year-archive + .year-archive {
    margin-block-start: 1rem;
  }

  .year-index {
    margin-block-end: 0.5rem;
  }

  .year-index a {
    padding-inline: 0.4rem;
  }

  .year-archive,
  .articles-topics {
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid var(--color-line);
    border-radius: var(--card-radius);
    background: var(--color-card);
  }

  .year-archive { border-block-start: 3px solid var(--color-primary); }
  .year-archive :global(.post-row:first-child) { margin-block-start: 0.25rem; }

  .articles-section__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-block-end: 0.65rem;
  }

  .articles-section__heading h2,
  .year-archive > h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
  }

  .articles-section__heading a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
  }

  .topic-index a span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

</style>
