---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { softwareProjects } from "../../data/software"
import { getPostTags, getPublishedPosts } from "../../lib/posts"

const posts = await getPublishedPosts()
const querySeeds = Array.from(new Set([
  ...posts.flatMap((post) => getPostTags(post)),
  ...softwareProjects.flatMap((project) => project.tags),
])).slice(0, 6)
---

<BaseLayout
  title="搜索"
  description="按标题、摘要、分类和标签搜索本站文章与软件项目。"
>
  <header class="page-intro search-intro">
    <p class="eyebrow">SEARCH / ARCHIVE</p>
    <h1>从写过的内容里，<br />找到一个词。</h1>
    <p class="lede">
      按标题、正文、项目、分类或标签搜索。
    </p>
    <nav class="query-seeds" aria-label="常用搜索主题">
      <span>常见标签</span>
      {querySeeds.map((seed) => <a href={`/search/?q=${encodeURIComponent(seed)}`}>{seed}</a>)}
    </nav>
  </header>

  <section class="axis-section" data-note="搜索" aria-label="搜索">
    <form class="search-form" role="search" onsubmit="return false">
      <label for="site-search">搜索站内内容</label>
      <input
        id="site-search"
        type="search"
        name="q"
        placeholder="例如：npm-safe、社会学、TypeScript…"
        autocomplete="off"
        spellcheck="false"
        aria-describedby="search-hint search-status"
        data-search-input
      />
      <p id="search-hint" class="search-hint">
        支持同时输入多个关键词，结果会优先匹配标题与标签。
      </p>
    </form>
  </section>

  <section class="axis-section" data-note="结果" aria-label="搜索结果">
    <p id="search-status" class="search-status" aria-live="polite" data-search-status>
      输入关键词后开始搜索。
    </p>
    <div class="search-results" data-search-results></div>
  </section>

</BaseLayout>

<script>
  interface SearchRecord {
    kind?: string
    title?: string
    description?: string
    excerpt?: string
    content?: string
    text?: string
    date?: string
    category?: string
    tags: string[]
    href: string
    url?: string
    search: {
      title: string
      tags: string
      category: string
      description: string
      content: string
    }
  }

  const input = document.querySelector<HTMLInputElement>("[data-search-input]")
  const status = document.querySelector<HTMLElement>("[data-search-status]")
  const results = document.querySelector<HTMLElement>("[data-search-results]")

  let indexPromise: Promise<SearchRecord[]> | null = null
  let searchIndex: SearchRecord[] = []

  const normalise = (value: unknown) =>
    String(value ?? "")
      .normalize("NFKC")
      .toLocaleLowerCase("zh-CN")

  const asArray = (value: unknown): string[] =>
    (Array.isArray(value) ? value : value ? [value] : []).map(String)

  const loadIndex = () => {
    if (indexPromise) return indexPromise

    if (!status) return Promise.reject(new Error("Search status is unavailable"))

    status.textContent = "正在载入搜索索引…"
    indexPromise = fetch("/search-index.json", {
      headers: { Accept: "application/json" },
    })
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        return response.json()
      })
      .then((payload) => {
        const items: Record<string, unknown>[] = Array.isArray(payload)
          ? payload
          : payload.items || payload.posts || []
        searchIndex = items.map((item): SearchRecord => {
          const title = typeof item.title === "string" ? item.title : undefined
          const description = typeof item.description === "string" ? item.description : undefined
          const excerpt = typeof item.excerpt === "string" ? item.excerpt : undefined
          const content = typeof item.content === "string" ? item.content : undefined
          const text = typeof item.text === "string" ? item.text : undefined
          const category = typeof item.category === "string" ? item.category : undefined
          const tags = asArray(item.tags)

          return {
            kind: typeof item.kind === "string" ? item.kind : undefined,
            title,
            description,
            excerpt,
            content,
            text,
            date: typeof item.date === "string" ? item.date : undefined,
            category,
            href: String(item.href || item.url || "#"),
            url: typeof item.url === "string" ? item.url : undefined,
            tags,
            search: {
              title: normalise(title),
              tags: normalise(tags.join(" ")),
              category: normalise(category),
              description: normalise(description || excerpt),
              content: normalise(content || text),
            },
          }
        })
        return searchIndex
      })
      .catch((error) => {
        console.error("Failed to load search index", error)
        indexPromise = null
        status.textContent = "搜索索引暂时无法载入。请稍后重新输入，或前往文章归档浏览。"
        throw error
      })

    return indexPromise
  }

  const scoreItem = (item: SearchRecord, tokens: string[]) => {
    const fields = item.search

    let score = 0
    for (const token of tokens) {
      let tokenScore = 0
      if (fields.title.includes(token)) tokenScore += 8
      if (fields.tags.includes(token)) tokenScore += 5
      if (fields.category.includes(token)) tokenScore += 4
      if (fields.description.includes(token)) tokenScore += 2
      if (fields.content.includes(token)) tokenScore += 1
      if (tokenScore === 0) return 0
      score += tokenScore
    }
    return score
  }

  const appendText = (element: HTMLElement, value: string) => {
    element.textContent = value
    return element
  }

  const render = (rawQuery: string) => {
    if (!status || !results) return
    const tokens = normalise(rawQuery).split(/\s+/).filter(Boolean)
    results.replaceChildren()

    if (tokens.length === 0) {
      status.textContent = "输入关键词后开始搜索。"
      return
    }

    const matches = searchIndex
      .map((item) => ({ item, score: scoreItem(item, tokens) }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score || String(b.item.date || "").localeCompare(String(a.item.date || "")))
      .slice(0, 20)

    status.textContent = matches.length
      ? `找到 ${matches.length} 条相关内容。`
      : `没有找到与“${rawQuery}”相关的内容。可以减少关键词后再试。`

    if (matches.length === 0) {
      const archiveLink = document.createElement("a")
      archiveLink.className = "search-empty-link"
      archiveLink.href = "/"
      appendText(archiveLink, "返回站内一览 →")
      results.append(archiveLink)
      return
    }

    const fragment = document.createDocumentFragment()
    for (const { item } of matches) {
      const article = document.createElement("article")
      article.className = "search-result"

      const meta = document.createElement("p")
      meta.className = "search-result__meta"
      if (item.kind) meta.append(item.kind)
      if (item.kind && (item.category || item.date)) meta.append(" · ")
      if (item.category) {
        const categoryLink = document.createElement("a")
        categoryLink.href = `/search/?q=${encodeURIComponent(item.category)}`
        appendText(categoryLink, item.category)
        meta.append(categoryLink)
      }
      if (item.category && item.date) meta.append(" · ")
      if (item.date) meta.append(item.date)

      const heading = document.createElement("h2")
      const link = document.createElement("a")
      link.href = item.href
      appendText(link, item.title || "未命名内容")
      heading.append(link)

      article.append(meta, heading)

      const description = item.description || item.excerpt
      if (description) {
        const summary = document.createElement("p")
        summary.className = "search-result__description"
        appendText(summary, description)
        article.append(summary)
      }

      if (item.tags.length > 0) {
        const tags = document.createElement("nav")
        tags.className = "search-result__tags"
        tags.setAttribute("aria-label", `《${item.title || "未命名内容"}》的标签`)
        for (const tag of item.tags) {
          const tagLink = document.createElement("a")
          tagLink.href = `/search/?q=${encodeURIComponent(tag)}`
          appendText(tagLink, `#${tag}`)
          tags.append(tagLink)
        }
        article.append(tags)
      }

      fragment.append(article)
    }
    results.append(fragment)
  }

  const syncQueryToUrl = (query: string) => {
    const url = new URL(window.location.href)
    if (query) url.searchParams.set("q", query)
    else url.searchParams.delete("q")
    window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`)
  }

  input?.addEventListener("input", () => {
    const query = input.value.trim()
    syncQueryToUrl(query)
    if (!query) {
      render("")
      return
    }

    void loadIndex()
      .then(() => render(input.value.trim()))
      .catch(() => {})
  })

  const initialQuery = new URLSearchParams(window.location.search).get("q")?.trim() ?? ""
  if (input && initialQuery) {
    input.value = initialQuery
    void loadIndex()
      .then(() => render(input.value.trim()))
      .catch(() => {})
  }

  window.addEventListener("popstate", () => {
    if (!input) return
    const query = new URLSearchParams(window.location.search).get("q")?.trim() ?? ""
    input.value = query
    if (!query) {
      render("")
      return
    }
    void loadIndex()
      .then(() => render(query))
      .catch(() => {})
  })
</script>

<style>
  .search-intro h1 {
    max-width: 17ch;
  }

  .query-seeds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 1rem;
    max-width: 39rem;
    margin-top: 1.65rem;
    border-block: 1px solid var(--color-line);
  }

  .query-seeds span {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .query-seeds a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-size: 0.875rem;
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .query-seeds a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-underline-offset: 0.25em;
  }

  .search-form label {
    display: block;
    margin-bottom: 0.65rem;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-form input {
    width: 100%;
    padding: 0.85rem 0;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: clamp(1.15rem, 3vw, 1.55rem);
  }

  .search-form input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  .search-form input:focus-visible {
    border-bottom-color: var(--color-primary);
    outline: 3px solid var(--color-secondary);
    outline-offset: 4px;
  }

  .search-hint,
  .search-status {
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .search-status {
    margin: 0 0 0.25rem;
  }

  :global(.search-result) {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  :global(.search-result__meta),
  :global(.search-result__tags) {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  :global(.search-result__meta a),
  :global(.search-result__tags a) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 0.25em;
  }

  :global(.search-result h2) {
    margin: 0.4rem 0 0;
    font-size: clamp(1.15rem, 3vw, 1.45rem);
  }

  :global(.search-result h2 a) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  :global(.search-result h2 a:hover) {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  :global(.search-result__description) {
    max-width: 46rem;
    margin: 0.65rem 0 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  :global(.search-result__tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-top: 0.7rem;
    overflow-wrap: anywhere;
  }

  :global(.search-empty-link) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-block-start: 1rem;
    font-weight: 700;
  }

  @media (max-width: 38rem) {
    .search-intro h1 br {
      display: none;
    }

    .query-seeds {
      gap-inline: 0.75rem;
    }

    .query-seeds span {
      flex-basis: 100%;
      padding-top: 0.7rem;
    }

  }
</style>
