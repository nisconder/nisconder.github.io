---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { softwareProjects } from "../../data/software"
import { getPostCategory, getPostTags, getPublishedPosts } from "../../lib/posts"

const posts = await getPublishedPosts()
const querySeeds = Array.from(new Set([
  ...posts.flatMap((post) => getPostTags(post)),
  ...softwareProjects.flatMap((project) => project.tags),
])).slice(0, 6)
const categoryCounts = Array.from(
  posts.reduce((counts, post) => {
    const category = getPostCategory(post)
    if (category) counts.set(category, (counts.get(category) ?? 0) + 1)
    return counts
  }, new Map<string, number>()),
).sort(([leftCategory, leftCount], [rightCategory, rightCount]) =>
  rightCount - leftCount || leftCategory.localeCompare(rightCategory, "zh-CN"),
)
---

<BaseLayout
  title="搜索"
  description="按标题、摘要、分类和标签搜索本站文章与软件项目。"
>
  <header class="page-intro search-intro">
    <p class="eyebrow">SEARCH / ARCHIVE</p>
    <h1>从写过的内容里，<br />找到一个词。</h1>
    <p class="lede">
      按标题、正文、项目、分类或标签搜索。
    </p>
    <nav class="query-seeds" aria-label="常用搜索主题">
      <span>常见标签</span>
      {querySeeds.map((seed) => <a href={`/search/?q=${encodeURIComponent(seed)}`}>{seed}</a>)}
    </nav>
  </header>

  <section class="axis-section" data-note="搜索" aria-label="搜索">
    <form class="search-form" action="/search/" method="get" role="search" data-search-form>
      <label for="site-search">搜索站内内容</label>
      <div class="search-form__bar">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <input
          id="site-search"
          type="search"
          name="q"
          placeholder="例如：npm-safe、社会学、TypeScript…"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="search-hint search-status"
          data-search-input
        />
        <button type="submit">搜索</button>
      </div>
      <p id="search-hint" class="search-hint">
        支持同时输入多个关键词；也可以只选分类，直接浏览该分类下的文章。
      </p>

      {categoryCounts.length > 0 && (
        <fieldset class="category-filter" data-category-filter>
          <legend>文章分类</legend>
          <div class="category-filter__options">
            <button type="button" data-category="" aria-pressed="false">
              <span>全部</span>
              <small>{posts.length}</small>
            </button>
            {categoryCounts.map(([category, count]) => (
              <button type="button" data-category={category} aria-pressed="false">
                <span>{category}</span>
                <small>{count}</small>
              </button>
            ))}
          </div>
        </fieldset>
      )}
    </form>
  </section>

  <section class="axis-section" data-note="结果" aria-label="搜索结果">
    <p id="search-status" class="search-status" aria-live="polite" data-search-status>
      输入关键词，或选择一个文章分类。
    </p>
    <div class="search-results" data-search-results></div>
  </section>

</BaseLayout>

<script>
  interface SearchRecord {
    kind?: string
    title?: string
    description?: string
    excerpt?: string
    content?: string
    text?: string
    date?: string
    category?: string
    tags: string[]
    href: string
    url?: string
    search: {
      title: string
      tags: string
      category: string
      description: string
      content: string
    }
  }

  const form = document.querySelector<HTMLFormElement>("[data-search-form]")
  const input = document.querySelector<HTMLInputElement>("[data-search-input]")
  const status = document.querySelector<HTMLElement>("[data-search-status]")
  const results = document.querySelector<HTMLElement>("[data-search-results]")
  const categoryButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-category-filter] [data-category]"),
  )

  let indexPromise: Promise<SearchRecord[]> | null = null
  let searchIndex: SearchRecord[] = []
  let activeCategory = ""
  let activeType = ""

  const normalise = (value: unknown) =>
    String(value ?? "")
      .normalize("NFKC")
      .toLocaleLowerCase("zh-CN")

  const asArray = (value: unknown): string[] =>
    (Array.isArray(value) ? value : value ? [value] : []).map(String)

  const loadIndex = () => {
    if (indexPromise) return indexPromise

    if (!status) return Promise.reject(new Error("Search status is unavailable"))

    status.textContent = "正在载入搜索索引…"
    indexPromise = fetch("/search-index.json", {
      headers: { Accept: "application/json" },
    })
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        return response.json()
      })
      .then((payload) => {
        const items: Record<string, unknown>[] = Array.isArray(payload)
          ? payload
          : payload.items || payload.posts || []
        searchIndex = items.map((item): SearchRecord => {
          const title = typeof item.title === "string" ? item.title : undefined
          const description = typeof item.description === "string" ? item.description : undefined
          const excerpt = typeof item.excerpt === "string" ? item.excerpt : undefined
          const content = typeof item.content === "string" ? item.content : undefined
          const text = typeof item.text === "string" ? item.text : undefined
          const category = typeof item.category === "string" ? item.category : undefined
          const tags = asArray(item.tags)

          return {
            kind: typeof item.kind === "string" ? item.kind : undefined,
            title,
            description,
            excerpt,
            content,
            text,
            date: typeof item.date === "string" ? item.date : undefined,
            category,
            href: String(item.href || item.url || "#"),
            url: typeof item.url === "string" ? item.url : undefined,
            tags,
            search: {
              title: normalise(title),
              tags: normalise(tags.join(" ")),
              category: normalise(category),
              description: normalise(description || excerpt),
              content: normalise(content || text),
            },
          }
        })
        return searchIndex
      })
      .catch((error) => {
        console.error("Failed to load search index", error)
        indexPromise = null
        status.textContent = "搜索索引暂时无法载入。请稍后重新输入，或前往文章归档浏览。"
        throw error
      })

    return indexPromise
  }

  const scoreItem = (item: SearchRecord, tokens: string[]) => {
    const fields = item.search

    let score = 0
    for (const token of tokens) {
      let tokenScore = 0
      if (fields.title.includes(token)) tokenScore += 8
      if (fields.tags.includes(token)) tokenScore += 5
      if (fields.category.includes(token)) tokenScore += 4
      if (fields.description.includes(token)) tokenScore += 2
      if (fields.content.includes(token)) tokenScore += 1
      if (tokenScore === 0) return 0
      score += tokenScore
    }
    return score
  }

  const appendText = (element: HTMLElement, value: string) => {
    element.textContent = value
    return element
  }

  const render = (rawQuery: string, category = activeCategory, type = activeType) => {
    if (!status || !results) return
    const tokens = normalise(rawQuery).split(/\s+/).filter(Boolean)
    const normalisedCategory = normalise(category)
    const articleOnly = type === "article" || Boolean(normalisedCategory)
    results.replaceChildren()

    if (tokens.length === 0 && !normalisedCategory && !articleOnly) {
      status.textContent = "输入关键词，或选择一个文章分类。"
      return
    }

    const matches = searchIndex
      .filter((item) => (
        (!articleOnly || item.kind === "文章")
        && (!normalisedCategory || normalise(item.category) === normalisedCategory)
      ))
      .map((item) => ({ item, score: tokens.length > 0 ? scoreItem(item, tokens) : 1 }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score || String(b.item.date || "").localeCompare(String(a.item.date || "")))
      .slice(0, 20)

    const scope = category ? `“${category}”分类` : articleOnly ? "文章" : "全站"
    status.textContent = matches.length
      ? (rawQuery
        ? `在${scope}中找到 ${matches.length} 条与“${rawQuery}”匹配的内容。`
        : category
          ? `${scope}共有 ${matches.length} 篇文章。`
          : `共有 ${matches.length} 篇公开文章。`)
      : (rawQuery
        ? `在${scope}中没有找到与“${rawQuery}”匹配的内容。可以减少关键词或切换分类。`
        : category
          ? `${scope}暂时没有公开文章。`
          : "暂时没有公开文章。")

    if (matches.length === 0) {
      const archiveLink = document.createElement("a")
      archiveLink.className = "search-empty-link"
      archiveLink.href = "/articles/"
      appendText(archiveLink, "浏览全部文章 →")
      results.append(archiveLink)
      return
    }

    const fragment = document.createDocumentFragment()
    for (const { item } of matches) {
      const article = document.createElement("article")
      article.className = "search-result"

      const meta = document.createElement("p")
      meta.className = "search-result__meta"
      if (item.kind) meta.append(item.kind)
      if (item.kind && (item.category || item.date)) meta.append(" · ")
      if (item.category) {
        if (item.kind === "文章") {
          const categoryLink = document.createElement("a")
          categoryLink.href = `/search/?category=${encodeURIComponent(item.category)}`
          appendText(categoryLink, item.category)
          meta.append(categoryLink)
        } else {
          meta.append(item.category)
        }
      }
      if (item.category && item.date) meta.append(" · ")
      if (item.date) meta.append(item.date)

      const heading = document.createElement("h2")
      const link = document.createElement("a")
      link.href = item.href
      appendText(link, item.title || "未命名内容")
      heading.append(link)

      article.append(meta, heading)

      const description = item.description || item.excerpt
      if (description) {
        const summary = document.createElement("p")
        summary.className = "search-result__description"
        appendText(summary, description)
        article.append(summary)
      }

      if (item.tags.length > 0) {
        const tags = document.createElement("nav")
        tags.className = "search-result__tags"
        tags.setAttribute("aria-label", `《${item.title || "未命名内容"}》的标签`)
        for (const tag of item.tags) {
          const tagLink = document.createElement("a")
          tagLink.href = `/search/?q=${encodeURIComponent(tag)}`
          appendText(tagLink, `#${tag}`)
          tags.append(tagLink)
        }
        article.append(tags)
      }

      fragment.append(article)
    }
    results.append(fragment)
  }

  const syncStateToUrl = (query: string, category: string, type: string) => {
    const url = new URL(window.location.href)
    if (query) url.searchParams.set("q", query)
    else url.searchParams.delete("q")
    if (category) url.searchParams.set("category", category)
    else url.searchParams.delete("category")
    if (type === "article" && !category) url.searchParams.set("type", "article")
    else url.searchParams.delete("type")
    window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`)
  }

  const updateCategoryButtons = () => {
    for (const button of categoryButtons) {
      const category = button.dataset.category ?? ""
      const isPressed = category
        ? category === activeCategory
        : activeType === "article" && !activeCategory
      button.setAttribute("aria-pressed", String(isPressed))
    }
  }

  const runSearch = () => {
    const query = input?.value.trim() ?? ""
    syncStateToUrl(query, activeCategory, activeType)
    if (!query && !activeCategory && activeType !== "article") {
      render("", "", "")
      return
    }

    void loadIndex()
      .then(() => render(query, activeCategory, activeType))
      .catch(() => {})
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault()
    runSearch()
  })

  for (const button of categoryButtons) {
    button.addEventListener("click", () => {
      activeCategory = button.dataset.category ?? ""
      activeType = "article"
      updateCategoryButtons()
      runSearch()
    })
  }

  const applyUrlState = () => {
    if (!input) return
    const parameters = new URLSearchParams(window.location.search)
    const query = parameters.get("q")?.trim() ?? ""
    activeCategory = parameters.get("category")?.trim() ?? ""
    activeType = parameters.get("type") === "article" || activeCategory ? "article" : ""
    input.value = query
    updateCategoryButtons()

    if (!query && !activeCategory && activeType !== "article") {
      render("", "", "")
      return
    }

    void loadIndex()
      .then(() => render(query, activeCategory, activeType))
      .catch(() => {})
  }

  applyUrlState()

  window.addEventListener("popstate", () => {
    applyUrlState()
  })
</script>

<style>
  .search-intro h1 {
    max-width: 17ch;
  }

  .query-seeds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 1rem;
    max-width: 39rem;
    margin-top: 1.65rem;
    border-block: 1px solid var(--color-line);
  }

  .query-seeds span {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .query-seeds a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-size: 0.875rem;
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .query-seeds a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-underline-offset: 0.25em;
  }

  .search-form {
    width: min(100%, 58rem);
  }

  .search-form > label {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 750;
  }

  .search-form__bar {
    display: grid;
    min-width: 0;
    min-height: 3.5rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-inline-start: 0.4rem solid var(--color-primary);
    border-radius: var(--card-radius);
    background: var(--color-field);
  }

  .search-form__bar:focus-within {
    border-color: var(--color-primary);
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  .search-form__bar svg {
    width: 1.25rem;
    height: 1.25rem;
    align-self: center;
    margin-inline: 0.9rem 0.15rem;
    fill: none;
    stroke: var(--color-primary);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .search-form input {
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    padding: 0.8rem 0.75rem;
    border: 0;
    border-radius: 0;
    background: var(--color-field);
    color: inherit;
    font: inherit;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
  }

  .search-form input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  .search-form input:focus-visible {
    outline: 0;
  }

  .search-form__bar > button {
    min-width: 5.5rem;
    min-height: 3.5rem;
    padding-inline: 1.15rem;
    border: 0;
    border-inline-start: 1px solid var(--color-primary);
    border-radius: 0;
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 750;
  }

  .search-form__bar > button:hover {
    background: color-mix(in srgb, var(--color-reading-panel), var(--color-heading) 12%);
  }

  .search-form__bar > button:focus-visible {
    outline: 0;
    box-shadow: inset 0 0 0 3px var(--color-secondary);
  }

  .category-filter {
    min-width: 0;
    padding: 0;
    margin: 1.35rem 0 0;
    border: 0;
  }

  .category-filter legend {
    padding: 0;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 750;
  }

  .category-filter__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-block-start: 0.7rem;
  }

  .category-filter__options button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-card);
    color: var(--color-text);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .category-filter__options button:not([aria-pressed='true']):hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .category-filter__options button[aria-pressed='true'] {
    border-color: var(--color-secondary);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .category-filter__options small {
    color: inherit;
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    opacity: 0.82;
  }

  .search-hint,
  .search-status {
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .search-status {
    margin: 0 0 0.25rem;
  }

  :global(.search-result) {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  :global(.search-result__meta),
  :global(.search-result__tags) {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  :global(.search-result__meta a),
  :global(.search-result__tags a) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 0.25em;
  }

  :global(.search-result h2) {
    margin: 0.4rem 0 0;
    font-size: clamp(1.15rem, 3vw, 1.45rem);
  }

  :global(.search-result h2 a) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  :global(.search-result h2 a:hover) {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  :global(.search-result__description) {
    max-width: 46rem;
    margin: 0.65rem 0 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  :global(.search-result__tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-top: 0.7rem;
    overflow-wrap: anywhere;
  }

  :global(.search-empty-link) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-block-start: 1rem;
    font-weight: 700;
  }

  @media (max-width: 38rem) {
    .search-intro h1 br {
      display: none;
    }

    .query-seeds {
      gap-inline: 0.75rem;
    }

    .query-seeds span {
      flex-basis: 100%;
      padding-top: 0.7rem;
    }

    .search-form__bar svg {
      margin-inline-start: 0.7rem;
    }

    .search-form__bar > button {
      min-width: 4.75rem;
      padding-inline: 0.8rem;
    }
  }
</style>
