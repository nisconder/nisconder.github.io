---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { softwareProjects } from "../../data/software"
import { getInterestJourney } from "../../lib/interests"
import { getPostCategory, getPostTags, getPublishedPosts } from "../../lib/posts"
import { getSearchIndexData } from '../../lib/search-index'

const posts = await getPublishedPosts()
const querySeeds = Array.from(new Set([
  ...posts.flatMap((post) => getPostTags(post)),
  ...softwareProjects.flatMap((project) => project.tags),
])).slice(0, 3)
const categoryCounts = Array.from(
  posts.reduce((counts, post) => {
    const category = getPostCategory(post)
    if (category) counts.set(category, (counts.get(category) ?? 0) + 1)
    return counts
  }, new Map<string, number>()),
).sort(([leftCategory, leftCount], [rightCategory, rightCount]) =>
  rightCount - leftCount || leftCategory.localeCompare(rightCategory, "zh-CN"),
)
const interestPoints = await getInterestJourney('search')
const searchData = await getSearchIndexData()
const compactJson = JSON.stringify({
  fullUrl: searchData.fullUrl,
  items: searchData.items.map(({ content, ...metadata }) => metadata),
}).replace(/</g, '\\u003c')
---

<BaseLayout
  title="搜索"
  description="搜索本站文章正文、系列合集、项目说明、分类和标签。"
  noindex
  interestPoints={interestPoints}
>
  <header class="page-intro search-intro">
    <p class="eyebrow">SEARCH / ARCHIVE</p>
    <h1>搜索文章、合集与项目</h1>
    <p class="lede">
      文章正文与合集目录已纳入索引，也可以按项目、分类或标签查找。
    </p>
    <nav class="query-seeds" aria-label="常用搜索主题">
      <span>常见标签</span>
      {querySeeds.map((seed) => <a href={`/search/?q=${encodeURIComponent(seed)}`}>{seed}</a>)}
    </nav>
  </header>

  <section class="axis-section" data-note="搜索" aria-label="搜索">
    <form class="search-form" action="/search/" method="get" role="search" data-search-form>
      <label for="site-search">搜索站内内容</label>
      <div class="search-form__bar">
        <div class="search-form__input-shell">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input
            id="site-search"
            type="search"
            name="q"
            placeholder="输入标题、正文、项目或标签…"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="search-hint search-status"
            data-search-input
          />
        </div>
        <button type="submit">搜索</button>
      </div>
      <p id="search-hint" class="search-hint">
        检索范围：文章标题与正文全文、合集目录、项目名称与说明、分类和标签。支持多个关键词；也可以只选分类。
      </p>

      {categoryCounts.length > 0 && (
        <fieldset class="category-filter" data-category-filter>
          <legend>文章分类</legend>
          <div class="category-filter__options">
            <button type="button" data-category="" aria-pressed="false">
              <span>全部</span>
              <small>{posts.length}</small>
            </button>
            {categoryCounts.map(([category, count]) => (
              <button type="button" data-category={category} aria-pressed="false">
                <span>{category}</span>
                <small>{count}</small>
              </button>
            ))}
          </div>
        </fieldset>
      )}
    </form>
  </section>

  <section class="axis-section" data-note="结果" aria-label="搜索结果">
    <div class="search-output" data-search-output>
      <p id="search-status" class="search-status" aria-live="polite" data-search-status>
        输入关键词，或选择一个文章分类。
      </p>
      <div class="search-results" data-search-results></div>
    </div>
  </section>

  <script type="application/json" data-search-catalog set:html={compactJson} />
</BaseLayout>

<script>
  import { initialiseSearch } from '../../lib/search-page'
  document.addEventListener('astro:page-load', initialiseSearch)
  initialiseSearch()
</script>

<style>
  .search-intro h1 {
    max-width: 17ch;
  }

  .query-seeds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 1rem;
    max-width: 39rem;
    margin-top: 1.65rem;
    border-block: 1px solid var(--color-line);
  }

  .query-seeds span {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .query-seeds a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-size: 0.875rem;
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .query-seeds a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-underline-offset: 0.25em;
  }

  .search-form {
    width: min(100%, 58rem);
    padding: clamp(1.15rem, 3vw, 1.75rem);
    border: 1px solid var(--color-line-strong);
    border-block-start: 0.5rem solid var(--color-primary);
    border-radius: var(--card-radius);
    background: var(--color-card);
  }

  .search-form > label {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--color-heading);
    font-size: 1rem;
    font-weight: 750;
  }

  .search-form__bar {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 0.75rem;
  }

  .search-form__input-shell {
    display: grid;
    min-width: 0;
    min-height: 3.75rem;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    border: 2px solid var(--color-control-border);
    border-radius: var(--card-radius);
    background: var(--color-field);
  }

  .search-form__input-shell:focus-within {
    border-color: var(--color-primary);
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  .search-form__input-shell svg {
    width: 1.35rem;
    height: 1.35rem;
    margin-inline: 1rem 0.2rem;
    fill: none;
    stroke: var(--color-primary);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .search-form input {
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    padding: 0.8rem 0.9rem;
    border: 0;
    border-radius: 0;
    background: var(--color-field);
    color: inherit;
    font: inherit;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
  }

  .search-form input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  .search-form input:focus-visible {
    outline: 0;
  }

  .search-form__bar > button {
    min-width: 7rem;
    min-height: 3.75rem;
    padding-inline: 1.35rem;
    border: 2px solid var(--color-reading-panel);
    border-radius: var(--card-radius);
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 800;
  }

  .search-form__bar > button:hover {
    background: color-mix(in srgb, var(--color-reading-panel), var(--color-heading) 12%);
  }

  .search-form__bar > button:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  .category-filter {
    min-width: 0;
    padding: 1rem;
    margin: 1.25rem 0 0;
    border: 1px solid var(--color-secondary);
    border-radius: var(--card-radius);
    background: var(--color-secondary-soft);
  }

  .category-filter legend {
    padding-inline: 0.35rem;
    color: var(--color-secondary);
    font-size: 0.875rem;
    font-weight: 750;
  }

  .category-filter__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-block-start: 0.7rem;
  }

  .category-filter__options button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-field);
    color: var(--color-text);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .category-filter__options button:not([aria-pressed='true']):hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .category-filter__options button[aria-pressed='true'] {
    border-color: var(--color-secondary);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .category-filter__options small {
    color: inherit;
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    opacity: 0.82;
  }

  .search-hint,
  .search-status {
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .search-status {
    margin: 0 0 0.25rem;
  }

  :global(.search-retry) {
    min-height: 2.75rem;
    padding: .35rem .65rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-field);
    color: var(--color-primary);
    font: inherit;
    cursor: pointer;
  }

  :global(.search-retry:focus-visible) {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }

  :global(.search-result) {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
    content-visibility: auto;
    contain-intrinsic-size: auto 18rem;
  }

  :global(.search-result__meta),
  :global(.search-result__tags) {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  :global(.search-result__meta a),
  :global(.search-result__tags a) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-secondary);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 0.25em;
  }

  :global(.search-result h2) {
    margin: 0.4rem 0 0;
    font-size: clamp(1.15rem, 3vw, 1.45rem);
  }

  :global(.search-result h2 a) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  :global(.search-result h2 a:hover) {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  :global(.search-result__description) {
    max-width: 46rem;
    margin: 0.65rem 0 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  :global(.search-result__tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-top: 0.7rem;
    overflow-wrap: anywhere;
  }

  :global(.search-empty-link) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-block-start: 1rem;
    font-weight: 700;
  }

  @media (max-width: 38rem) {
    .search-intro h1 br {
      display: none;
    }

    .query-seeds {
      gap-inline: 0.75rem;
    }

    .query-seeds span {
      flex-basis: 100%;
      padding-top: 0.7rem;
    }

    .search-form {
      padding: 1rem;
    }

    .search-form__bar {
      grid-template-columns: minmax(0, 1fr);
    }

    .search-form__input-shell svg {
      margin-inline-start: 0.7rem;
    }

    .search-form__bar > button {
      width: 100%;
      min-width: 0;
      min-height: 3.5rem;
    }

    .category-filter {
      padding: 0.85rem;
    }
  }
</style>
