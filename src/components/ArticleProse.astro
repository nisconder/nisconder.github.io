<div class="prose" data-reading-body><slot /></div>

<script>
  function enhanceArticle() {
    const prose = document.querySelector<HTMLElement>('[data-reading-body]')
    if (!prose || prose.dataset.toolsReady) return
    prose.dataset.toolsReady = 'true'
    for (const heading of prose.querySelectorAll<HTMLElement>('h2[id], h3[id]')) {
      const title = heading.textContent?.trim() || heading.id
      if (!heading.hasAttribute('aria-label') && !heading.hasAttribute('aria-labelledby')) heading.setAttribute('aria-label', title)
      const link = document.createElement('a')
      link.className = 'heading-permalink'
      link.href = '#' + encodeURIComponent(heading.id)
      link.setAttribute('aria-label', '直达本节：' + title)
      link.title = '本节链接'
      heading.append(link)
    }

    const status = document.createElement('span')
    status.className = 'copy-announcement'
    status.setAttribute('role', 'status')
    prose.append(status)
    for (const code of prose.querySelectorAll<HTMLElement>('pre > code')) {
      const pre = code.parentElement!
      const frame = document.createElement('div')
      frame.className = 'code-frame'
      const bar = document.createElement('div')
      bar.className = 'code-tools'
      const lang = document.createElement('span')
      const language = pre.dataset.language || [...code.classList].find(c => c.startsWith('language-'))?.slice(9)
      lang.textContent = !language || /^(plain)?text$/i.test(language) ? '文本' : language.toUpperCase()
      const button = document.createElement('button')
      button.type = 'button'
      button.textContent = '复制'
      button.setAttribute('aria-label', '复制本段代码')
      bar.append(lang, button)
      pre.replaceWith(frame)
      frame.append(bar, pre)
      let reset: number
      button.addEventListener('click', async () => {
        window.clearTimeout(reset)
        let copied = false
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(code.textContent ?? '')
            copied = true
          }
        } catch { /* Try the selected code when clipboard access is denied. */ }
        if (!button.isConnected) return
        if (!copied) {
          const range = document.createRange()
          range.selectNodeContents(code)
          const selection = window.getSelection()
          selection?.removeAllRanges()
          selection?.addRange(range)
          try { copied = document.execCommand('copy') } catch { /* Leave the code selected. */ }
        }
        button.textContent = copied ? '已复制 ✓' : '请手动复制'
        status.textContent = copied ? '代码已复制。' : '代码已选中，可使用系统复制命令。'
        reset = window.setTimeout(() => { button.textContent = '复制' }, 2000)
      })
    }
  }
  document.addEventListener('astro:page-load', enhanceArticle)
  enhanceArticle()
</script>

<style>
  .prose :global(.heading-permalink) { display: inline-block; padding-inline: .32em; font: 600 .72em/1.4 var(--font-utility); color: var(--color-primary); text-decoration: none; vertical-align: .08em; }
  .prose :global(.heading-permalink)::before { content: '#'; }
  .prose :global(.code-frame) { margin-block: 1.2rem; overflow: clip; border-radius: var(--control-radius); background: #24292e; color: #e1e4e8; }
  .prose :global(.code-frame pre) { margin: 0; padding-block-start: .65rem; border: 0; border-radius: 0; }
  .prose :global(.code-tools) { display: flex; justify-content: flex-end; align-items: center; gap: .8rem; padding: .15rem .6rem; border-bottom: 1px solid #455151; color: #c4d8cb; font: 600 .75rem/1.3 var(--font-utility); }
  .prose :global(.code-tools button) { min-height: 2.3rem; min-width: 4.2rem; border: 0; border-radius: .35rem; background: transparent; color: #e8f3e9; font: 650 .78rem var(--font-body); cursor: pointer; }
  .prose :global(.code-tools button:is(:hover,:focus-visible)) { background: #37453e; }
  .prose :global(.copy-announcement) { position: absolute; width: 1px; height: 1px; clip-path: inset(50%); overflow: hidden; }
  @media (min-width: 44.01rem) and (hover: hover) and (pointer: fine) {
    .prose :global(.code-frame:not(:hover):not(:focus-within) button),
    .prose :global(:is(h2,h3):not(:hover):not(:focus-within) .heading-permalink) { opacity: 0; }
  }
  @media (pointer: coarse) { .prose :global(.code-tools button) { min-height: 2.75rem; } }
  @media print { .prose :global(.heading-permalink), .prose :global(.code-tools) { display: none; } }
</style>
