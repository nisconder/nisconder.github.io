---
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname
const navItems = [
  { href: '/articles/', label: '文章' },
  { href: '/music/', label: '音乐' },
  { href: '/software/', label: '软件园' },
  { href: '/about/', label: '关于' },
]

const isArticlePath = /^\/\d{4}\/\d{2}\/\d{2}\//.test(pathname)
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(href) || (href === '/articles/' && isArticlePath)
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="Nisconder 首页">
      <span class="site-brand__mark" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span class="site-brand__word">Nisconder</span>
    </a>

    <nav class="site-nav" aria-label="主要导航">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <nav class="site-tools" aria-label="站点工具">
      <a
        class="site-search-link"
        href="/search/"
        aria-current={isCurrent('/search/') ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span>搜索本站</span>
      </a>
      <ThemeToggle />
    </nav>
  </div>
  <div class="site-header__signal" aria-hidden="true"><span></span><span></span></div>
</header>

<style>
  .site-header {
    background: var(--color-surface);
  }

  .site-header__inner {
    display: grid;
    width: min(100%, var(--header-width));
    min-height: 4.25rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    margin-inline: auto;
    padding: 0.7rem var(--site-gutter);
  }

  .site-brand {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-brand__mark {
    position: relative;
    display: block;
    width: 1.6rem;
    height: 1.45rem;
    flex: 0 0 auto;
  }

  .site-brand__mark span {
    position: absolute;
    width: 1.05rem;
    height: 1.05rem;
  }

  .site-brand__mark span:first-child {
    inset-block-start: 0;
    inset-inline-start: 0;
    background: var(--color-primary);
  }

  .site-brand__mark span:last-child {
    inset-block-end: 0;
    inset-inline-end: 0;
    background: var(--color-secondary);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: clamp(0.25rem, 1.5vw, 0.8rem);
  }

  .site-tools {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.45rem;
    padding-inline-start: clamp(0.5rem, 1.5vw, 1rem);
    border-inline-start: 1px solid var(--color-line);
  }

  .site-nav > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: clamp(0.45rem, 1.4vw, 0.75rem);
    border-block-end: 2px solid transparent;
    border-radius: var(--card-radius);
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    text-underline-offset: 0.3em;
  }

  .site-search-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    padding-inline: clamp(0.7rem, 1.6vw, 0.9rem);
    border: 1px solid var(--color-primary);
    border-radius: var(--card-radius);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 750;
    text-decoration: none;
  }

  .site-search-link svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .site-nav > a:hover,
  .site-nav > a[aria-current='page'],
  .site-search-link:hover,
  .site-search-link[aria-current='page'] {
    color: var(--color-primary);
    border-block-end-color: var(--color-secondary);
    background: var(--color-primary-soft);
    text-decoration: none;
  }

  .site-search-link:hover,
  .site-search-link[aria-current='page'] {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }

  .site-header__signal {
    display: grid;
    height: 4px;
    grid-template-columns: minmax(2rem, 38%) 1fr;
  }

  .site-header__signal span:first-child {
    background: var(--color-reading-panel);
  }

  .site-header__signal span:last-child {
    background: var(--color-media-panel);
  }

  @media (max-width: 42rem) {
    .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.5rem;
      padding-block-end: 0;
    }

    .site-nav {
      display: grid;
      width: 100%;
      grid-column: 1 / -1;
      grid-row: 2;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.25rem;
      padding-block: 0.4rem;
      border-block-start: 1px solid var(--color-line);
    }

    .site-nav > a {
      justify-content: center;
      padding-inline: 0.25rem;
    }

    .site-tools {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 30rem) {
    .site-brand__word {
      display: none;
    }

    .site-nav > a {
      padding-inline: 0.2rem;
      font-size: 0.78rem;
    }

    .site-search-link {
      padding-inline: 0.45rem;
      font-size: 0.8125rem;
    }

    .site-tools {
      gap: 0.5rem;
      padding-inline-start: 0.25rem;
    }
  }
</style>
