---
import HeaderToolMark from './HeaderToolMark.astro'
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname
const navItems = [
  { href: '/articles/', label: '文章' },
  { href: '/series/', label: '合集' },
  { href: '/music/', label: '音乐' },
  { href: '/software/', label: '项目' },
  { href: '/about/', label: '关于' },
]

const isArticlePath = /^\/\d{4}\/\d{2}\/\d{2}\//.test(pathname)
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(href) || (href === '/articles/' && isArticlePath)
---

<header class="site-header" id="site-top" tabindex="-1">
  <div class="site-header__inner">
    <a class="site-brand" href="/" data-astro-prefetch="hover" aria-label="Nisconder 首页">
      <span class="site-brand__mark" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span class="site-brand__word">Nisconder</span>
    </a>

    <nav class="site-nav" aria-label="主要导航">
      {navItems.map((item) => (
        <a href={item.href} data-astro-prefetch={['/articles/', '/series/'].includes(item.href) ? 'hover' : undefined} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <nav class="site-tools" aria-label="站点工具">
      <a
        class="site-search-link"
        href="/search/"
        data-astro-prefetch="hover"
        aria-label="搜索本站"
        aria-keyshortcuts="/ Control+k Meta+k"
        aria-current={isCurrent('/search/') ? 'page' : undefined}
      >
        <span class="site-search-mark" aria-hidden="true"><span></span><span></span></span>
        <span class="site-tool-label">搜索</span><kbd class="search-shortcut" aria-hidden="true">/</kbd>
      </a>
      <ThemeToggle />
      <a class="site-tool-link site-rss-link" href="/rss/" data-astro-prefetch="hover" aria-label="订阅文章 RSS" title="订阅文章 RSS"
        aria-current={isCurrent('/rss/') ? 'page' : undefined}>
        <HeaderToolMark>
          <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
          <path d="M5 11a8 8 0 0 1 8 8M5 4a15 15 0 0 1 15 15" />
        </HeaderToolMark>
        <span class="site-tool-label">RSS</span>
      </a>
      <a class="site-tool-link site-gkd-link" href="/gkd/" data-astro-prefetch="hover"
        aria-label="Nisconder的GKD订阅" title="Nisconder的GKD订阅" aria-current={isCurrent('/gkd/') ? 'page' : undefined}>
        <HeaderToolMark>
          <path d="M12 3 4 6v5c0 4.5 3.3 7.8 8 10 4.7-2.2 8-5.5 8-10V6Z" />
          <path d="m8.5 11.5 2.4 2.4 4.8-5" />
        </HeaderToolMark>
        <span class="site-tool-label">GKD</span>
      </a>
    </nav>
  </div>
  <div class="site-header__signal" aria-hidden="true"><span></span><span></span></div>
  <span class="site-header__loading-message" data-navigation-status role="status" aria-live="polite"></span>
</header>

<script>
  import { navigate } from 'astro:transitions/client'
  document.addEventListener('keydown', async event => {
    const modifiedK = (event.ctrlKey || event.metaKey) && !event.shiftKey && event.key.toLowerCase() === 'k'
    const slash = event.key === '/' && !event.ctrlKey && !event.metaKey && !event.shiftKey
    if ((!slash && !modifiedK) || event.altKey || event.defaultPrevented || event.repeat || event.isComposing) return
    if (event.composedPath().some(node => node instanceof HTMLElement &&
      (node.isContentEditable || node.matches('input, textarea, select, [role="textbox"], [role="slider"], dialog')))) return
    event.preventDefault()
    if (!document.querySelector('[data-search-input]')) await navigate('/search/#site-search')
    document.querySelector<HTMLInputElement>('[data-search-input]')?.focus()
  })
</script>

<style>
  .site-header {
    background: var(--color-surface);
  }
  .site-brand__word { font: 680 1.36rem/1 var(--font-display); letter-spacing: -0.045em; }

  .site-header__inner {
    display: grid;
    width: min(100%, var(--header-width));
    min-height: 3.75rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1rem);
    margin-inline: auto;
    padding: 0.45rem var(--site-gutter);
  }

  .site-brand {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-brand__mark {
    position: relative;
    display: block;
    width: 1.35rem;
    height: 1.2rem;
    flex: 0 0 auto;
    perspective: 75px;
  }

  .site-brand__mark span {
    position: absolute;
    width: 0.84rem;
    height: 0.84rem;
  }

  .site-brand__mark span:first-child {
    inset-block-start: 0;
    inset-inline-start: 0;
    background: var(--color-primary);
  }

  .site-brand__mark span:last-child {
    inset-block-end: 0;
    inset-inline-end: 0;
    background: var(--color-secondary);
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-brand__mark span { transition: transform 260ms var(--ease-settle); }
    .site-brand:is(:hover, :focus-visible) .site-brand__mark span:first-child { transform: translate(-1px,-1px) rotateY(-24deg); }
    .site-brand:is(:hover, :focus-visible) .site-brand__mark span:last-child { transform: translate(2px,1px) rotateY(24deg); }
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: clamp(0.05rem, 0.6vw, 0.35rem);
  }

  .site-tools {
    --tool-ink-offset: -0.5px;
    --tool-echo-offset: 1.5px;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.35rem;
    padding-inline-start: clamp(0.45rem, 1vw, 0.8rem);
    border-inline-start: 1px solid var(--color-line);
  }
  .search-shortcut { padding: .06rem .24rem; border: 1px solid var(--color-line); border-radius: .2rem; color: var(--color-muted); font: .68rem/1.15 var(--font-utility); }

  .site-nav > a {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: clamp(0.45rem, 1.1vw, 0.7rem);
    border-radius: 0.45rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    text-underline-offset: 0.3em;
    white-space: nowrap;
  }

  .site-tools > :global(:is(a, button)) {
    display: inline-flex;
    min-width: 4.85rem;
    min-height: 2.75rem;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--control-radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--motion-feedback) ease;
  }

  .site-tools > :global(:is(:focus-visible, :active, [aria-current='page'])) {
    border-color: var(--color-secondary);
  }

  @media (hover: hover) {
    .site-tools > :global(:hover) { border-color: var(--color-secondary); }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .site-tools > :global(:hover) {
      --tool-ink-offset: -2px;
      --tool-echo-offset: 3px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-tools > :global(:focus-visible) {
      --tool-ink-offset: -2px;
      --tool-echo-offset: 3px;
    }

    .site-tools > :global(:active),
    .site-tools > :global([data-theme-switching='true']) {
      --tool-ink-offset: 0px;
      --tool-echo-offset: 0px;
    }
  }

  .site-search-mark {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
  }

  .site-search-mark > span {
    position: absolute;
    inset-block-start: 0.12rem;
    inset-inline-start: 0.08rem;
    width: 0.78rem;
    height: 0.78rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    transition: transform 170ms var(--ease-settle);
  }

  .site-search-mark > span::after {
    position: absolute;
    width: 0.46rem;
    height: 1.5px;
    inset-block-end: -0.24rem;
    inset-inline-end: -0.32rem;
    background: currentColor;
    content: '';
    transform: rotate(45deg);
    transform-origin: center;
  }

  .site-search-mark > span:first-child {
    color: var(--color-primary);
    transform: translate(var(--tool-ink-offset), var(--tool-ink-offset));
  }

  .site-search-mark > span:last-child {
    opacity: 0.32;
    color: var(--color-secondary);
    transform: translate(var(--tool-echo-offset), var(--tool-echo-offset));
  }

  .site-nav > a:is(:hover, :focus-visible, [aria-current='page']) {
    color: var(--color-primary);
    background: var(--color-primary-soft);
    text-decoration: none;
  }

  .site-nav > a::after {
    position: absolute;
    inset: auto 24% 0.28rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-primary);
    content: '';
    transform: scaleX(0);
  }

  .site-nav > a[aria-current='page']::after { transform: scaleX(1); }
  @media (prefers-reduced-motion: no-preference) {
    .site-nav > a[aria-current='page']::after { animation: nav-current-in 260ms var(--ease-settle); }
    @keyframes nav-current-in { from { transform: scaleX(0); } }
  }
  .site-header__signal {
    position: relative;
    display: grid;
    height: 1px;
    grid-template-columns: minmax(2rem, 38%) 1fr;
    overflow: hidden;
  }

  .site-header__signal::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, var(--color-primary), var(--color-secondary), transparent);
    opacity: 0;
    content: '';
  }

  :global(html[data-navigation-loading]) .site-header__signal::after {
    opacity: 1;
    animation: navigation-pending 1.1s ease-in-out infinite;
  }

  @keyframes navigation-pending {
    from { transform: translateX(-100%); }
    to { transform: translateX(100%); }
  }

  .site-header__loading-message {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .site-header__signal span { background: var(--color-line); }

  @media (max-width: 56rem) {
    .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.2rem 0.5rem;
      padding: 0.35rem var(--site-gutter) 0;
    }

    .site-brand {
      min-width: 0;
      justify-content: flex-start;
      font-size: 1rem;
    }

    .site-nav {
      display: grid;
      width: 100%;
      grid-column: 1 / -1;
      grid-row: 2;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.15rem;
      padding-block: 0.15rem;
      border-block-start: 1px solid var(--color-line);
    }

    .site-nav > a {
      min-height: 2.75rem;
      justify-content: center;
      padding-inline: 0.25rem;
      font-size: 0.875rem;
    }

    .site-tools {
      grid-column: 2;
      grid-row: 1;
      gap: 0.3rem;
      padding-inline-start: 0.4rem;
    }

  }

  @media (max-width: 44rem) {
    .site-tools > :global(:is(a, button)) {
      min-width: 2.75rem;
      padding-inline: 0.45rem;
    }

    .site-gkd-link :global(.site-tool-mark) { display: none; }
    .site-tool-link:not(.site-gkd-link) .site-tool-label,
    .site-search-link .site-tool-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .search-shortcut { display: none; }
  }

  @media (max-width: 30rem) {
    .site-nav > a {
      padding-inline: 0.2rem;
      font-size: 0.8125rem;
    }

    .site-tools {
      gap: 0.2rem;
      padding-inline-start: 0.25rem;
    }
  }

  @media (max-width: 23rem) {
    .site-brand {
      font-size: 0.875rem;
      gap: 0.35rem;
    }
  }

  @media (max-width: 22rem) {
    .site-brand__word { font-size: 1.12rem; }
    .site-brand__mark { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-navigation-loading]) .site-header__signal::after {
      animation: none;
    }
    .site-search-mark > span {
      transition: none;
    }
  }
</style>
