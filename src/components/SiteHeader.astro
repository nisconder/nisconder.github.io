---
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname
const navItems = [
  { href: '/articles/', label: '文章' },
  { href: '/music/', label: '音乐' },
  { href: '/software/', label: '项目' },
  { href: '/about/', label: '关于' },
]

const isArticlePath = /^\/\d{4}\/\d{2}\/\d{2}\//.test(pathname)
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(href) || (href === '/articles/' && isArticlePath)
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="Nisconder 首页">
      <span class="site-brand__mark" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span class="site-brand__word">Nisconder</span>
    </a>

    <nav class="site-nav" aria-label="主要导航">
      {navItems.map((item) => (
        <a href={item.href} data-astro-prefetch="viewport" aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <nav class="site-tools" aria-label="站点工具">
      <a
        class="site-search-link"
        href="/search/"
        aria-label="搜索本站"
        aria-current={isCurrent('/search/') ? 'page' : undefined}
      >
        <span class="site-search-mark" aria-hidden="true"><span></span><span></span></span>
        <span>搜索</span>
      </a>
      <ThemeToggle />
    </nav>
  </div>
  <div class="site-header__signal" aria-hidden="true"><span></span><span></span></div>
  <span class="site-header__loading-message" data-navigation-status role="status" aria-live="polite"></span>
</header>

<style>
  .site-header {
    background: var(--color-surface);
  }

  .site-header__inner {
    display: grid;
    width: min(100%, var(--header-width));
    min-height: 3.75rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1rem);
    margin-inline: auto;
    padding: 0.45rem var(--site-gutter);
  }

  .site-brand {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-brand__mark {
    position: relative;
    display: block;
    width: 1.35rem;
    height: 1.2rem;
    flex: 0 0 auto;
  }

  .site-brand__mark span {
    position: absolute;
    width: 0.84rem;
    height: 0.84rem;
  }

  .site-brand__mark span:first-child {
    inset-block-start: 0;
    inset-inline-start: 0;
    background: var(--color-primary);
  }

  .site-brand__mark span:last-child {
    inset-block-end: 0;
    inset-inline-end: 0;
    background: var(--color-secondary);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: clamp(0.05rem, 0.6vw, 0.35rem);
  }

  .site-tools {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.35rem;
    padding-inline-start: clamp(0.45rem, 1vw, 0.8rem);
    border-inline-start: 1px solid var(--color-line);
  }

  .site-nav > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: clamp(0.45rem, 1.1vw, 0.7rem);
    border-block-end: 2px solid transparent;
    border-radius: var(--card-radius);
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    text-underline-offset: 0.3em;
  }

  .site-search-link {
    display: inline-flex;
    min-width: 4.85rem;
    min-height: 2.75rem;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    padding-inline: 0.65rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--card-radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-search-mark {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
  }

  .site-search-mark > span {
    position: absolute;
    inset-block-start: 0.12rem;
    inset-inline-start: 0.08rem;
    width: 0.78rem;
    height: 0.78rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    transition: transform 170ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .site-search-mark > span::after {
    position: absolute;
    width: 0.46rem;
    height: 1.5px;
    inset-block-end: -0.24rem;
    inset-inline-end: -0.32rem;
    background: currentColor;
    content: '';
    transform: rotate(45deg);
    transform-origin: center;
  }

  .site-search-mark > span:first-child {
    color: var(--color-primary);
    transform: translate(-0.5px, -0.5px);
  }

  .site-search-mark > span:last-child {
    color: var(--color-secondary);
    transform: translate(1.5px, 1.5px);
  }

  .site-nav > a:hover,
  .site-nav > a[aria-current='page'] {
    color: var(--color-primary);
    border-block-end-color: var(--color-secondary);
    background: var(--color-primary-soft);
    text-decoration: none;
  }

  .site-search-link:hover,
  .site-search-link[aria-current='page'] {
    border-color: var(--color-secondary);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }

  .site-search-link:hover .site-search-mark > span:first-child {
    transform: translate(-2px, -2px);
  }

  .site-search-link:hover .site-search-mark > span:last-child {
    transform: translate(3px, 3px);
  }

  .site-search-link:active .site-search-mark > span:first-child,
  .site-search-link:active .site-search-mark > span:last-child {
    transform: translate(0, 0);
  }

  .site-header__signal {
    position: relative;
    display: grid;
    height: 2px;
    grid-template-columns: minmax(2rem, 38%) 1fr;
    overflow: hidden;
  }

  .site-header__signal::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, var(--color-primary), var(--color-secondary), transparent);
    opacity: 0;
    content: '';
  }

  :global(html[data-navigation-loading]) .site-header__signal::after {
    opacity: 1;
    animation: navigation-pending 1.1s ease-in-out infinite;
  }

  @keyframes navigation-pending {
    from { transform: translateX(-100%); }
    to { transform: translateX(100%); }
  }

  .site-header__loading-message {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .site-header__signal span:first-child {
    background: var(--color-reading-panel);
  }

  .site-header__signal span:last-child {
    background: var(--color-media-panel);
  }

  @media (max-width: 44rem) {
    .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.2rem 0.5rem;
      padding: 0.35rem var(--site-gutter) 0;
    }

    .site-brand {
      min-width: 0;
      justify-content: flex-start;
      font-size: 1rem;
    }

    .site-nav {
      display: grid;
      width: 100%;
      grid-column: 1 / -1;
      grid-row: 2;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.15rem;
      padding-block: 0.15rem;
      border-block-start: 1px solid var(--color-line);
    }

    .site-nav > a {
      min-height: 2.75rem;
      justify-content: center;
      padding-inline: 0.25rem;
      font-size: 0.875rem;
    }

    .site-tools {
      grid-column: 2;
      grid-row: 1;
      gap: 0.3rem;
      padding-inline-start: 0.4rem;
    }

    .site-search-link {
      min-width: 2.75rem;
      padding-inline: 0.45rem;
    }

    .site-search-link > :last-child {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (max-width: 30rem) {
    .site-nav > a {
      padding-inline: 0.2rem;
      font-size: 0.8125rem;
    }

    .site-tools {
      gap: 0.3rem;
      padding-inline-start: 0.25rem;
    }
  }

  @media (max-width: 22rem) {
    .site-brand__word {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-navigation-loading]) .site-header__signal::after {
      animation: none;
    }

    .site-search-mark > span {
      transition: none;
    }
  }
</style>
