---
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname
const navItems = [
  { href: '/articles/', label: '文章' },
  { href: '/music/', label: '音乐' },
  { href: '/about/', label: '关于' },
  { href: '/search/', label: '搜索' },
]

const isArticlePath = /^\/\d{4}\/\d{2}\/\d{2}\//.test(pathname)
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(href) || (href === '/articles/' && isArticlePath)
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="Nisconder 首页">
      <span class="site-brand__mark" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span class="site-brand__word">Nisconder</span>
    </a>

    <nav class="site-nav" aria-label="主要导航">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
  <div class="site-header__signal" aria-hidden="true"><span></span><span></span></div>
</header>

<style>
  .site-header {
    background: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    width: min(100%, var(--header-width));
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
    padding: 0.7rem var(--site-gutter);
  }

  .site-brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-brand__mark {
    position: relative;
    display: block;
    width: 1.6rem;
    height: 1.45rem;
    flex: 0 0 auto;
  }

  .site-brand__mark span {
    position: absolute;
    width: 1.05rem;
    height: 1.05rem;
  }

  .site-brand__mark span:first-child {
    inset-block-start: 0;
    inset-inline-start: 0;
    background: var(--color-primary);
  }

  .site-brand__mark span:last-child {
    inset-block-end: 0;
    inset-inline-end: 0;
    background: var(--color-secondary);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 0.8rem);
  }

  .site-nav > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: clamp(0.45rem, 1.4vw, 0.75rem);
    border-block-end: 2px solid transparent;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    text-underline-offset: 0.3em;
  }

  .site-nav > a:hover,
  .site-nav > a[aria-current='page'] {
    color: var(--color-primary);
    border-block-end-color: var(--color-secondary);
    background: var(--color-primary-soft);
    text-decoration: none;
  }

  .site-header__signal {
    display: grid;
    height: 4px;
    grid-template-columns: minmax(2rem, 38%) 1fr;
  }

  .site-header__signal span:first-child {
    background: var(--color-primary);
  }

  .site-header__signal span:last-child {
    background: var(--color-secondary);
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      gap: 0.5rem;
    }

    .site-brand__word {
      display: none;
    }

    .site-nav {
      gap: 0;
    }

    .site-nav > a {
      padding-inline: 0.45rem;
      font-size: 0.8125rem;
    }
  }
</style>
