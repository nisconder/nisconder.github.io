---
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname
const navItems = [
  { href: '/articles/', label: '文章' },
  { href: '/series/', label: '合集' },
  { href: '/music/', label: '音乐' },
  { href: '/software/', label: '项目' },
  { href: '/about/', label: '关于' },
]
const isArticlePath = /^\/\d{4}\/\d{2}\/\d{2}\//.test(pathname)
const isCurrent = (href: string) => pathname === href.slice(0, -1)
  || pathname.startsWith(href) || (href === '/articles/' && isArticlePath)
const isSubscription = isCurrent('/subscribe/') || isCurrent('/gkd/')
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" data-astro-prefetch="hover" aria-label="Nisconder 首页">
      <span class="site-brand__mark" aria-hidden="true"><span></span><span></span></span>
      <span class="site-brand__word">Nisconder<span class="site-brand__caption">笔记 · 项目 · 生活</span></span>
    </a>
    <nav class="site-nav" aria-label="主要导航">
      {navItems.map((item) => (
        <a href={item.href} data-astro-prefetch="hover" aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <nav class="site-tools" aria-label="站点工具">
      <a class="site-subscribe-link" href="/subscribe/" data-astro-prefetch="hover"
        aria-current={isSubscription ? 'page' : undefined}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none" />
          <path d="M5 11a8 8 0 0 1 8 8M5 4a15 15 0 0 1 15 15" />
        </svg>
        <span>订阅</span>
      </a>
      <div class="site-utilities">
        <a class="site-search-link" href="/search/" data-astro-prefetch="hover" aria-label="搜索本站" title="搜索本站"
          aria-current={isCurrent('/search/') ? 'page' : undefined}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" />
          </svg>
        </a>
        <ThemeToggle />
      </div>
    </nav>
  </div>
  <div class="site-header__signal" aria-hidden="true"></div>
  <span class="site-header__loading-message" data-navigation-status role="status" aria-live="polite"></span>
</header>

<style>
  .site-header { background: var(--color-surface); border-block-end: 1px solid var(--color-line); }
  .site-header__inner {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    width: min(100%, var(--header-width)); min-height: 5rem; margin-inline: auto;
    padding: 0.65rem var(--site-gutter); gap: clamp(1rem, 3vw, 2.5rem);
  }
  .site-brand {
    display: inline-flex; width: fit-content; min-height: 2.75rem; align-items: center; gap: 0.75rem;
    color: var(--color-text); font-family: var(--font-display); text-decoration: none;
  }
  .site-brand:hover { text-decoration: none; }
  .site-brand__mark { position: relative; display: block; width: 1.6rem; height: 1.6rem; flex-shrink: 0; }
  .site-brand__mark span { position: absolute; width: 1.05rem; height: 1.05rem; border-radius: 0.18rem; }
  .site-brand__mark span:first-child { top: 0; left: 0; background: var(--color-primary); }
  .site-brand__mark span:last-child { right: 0; bottom: 0; background: var(--color-secondary); }
  .site-brand__word { font-size: 1.15rem; font-weight: 750; line-height: 1.35; letter-spacing: -0.025em; }
  .site-brand__caption { display: block; margin-block-start: 0.15rem; color: var(--color-muted); font-size: 0.625rem; font-weight: 400; letter-spacing: 0.1em; }
  .site-nav { display: flex; align-items: center; gap: 0.2rem; }
  .site-nav > a {
    position: relative; display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center;
    padding-inline: 0.85rem; border-radius: 0.45rem; color: var(--color-muted);
    font-size: 0.875rem; font-weight: 650; text-decoration: none;
  }
  .site-nav > a::after {
    position: absolute; bottom: 0.1rem; left: 50%; width: 1rem; height: 2px;
    background: var(--color-primary); border-radius: 1px; content: ''; transform: translateX(-50%) scaleX(0);
  }
  .site-nav > a:hover { color: var(--color-text); background: var(--color-surface-soft); text-decoration: none; }
  .site-nav > a[aria-current='page'] { color: var(--color-primary); }
  .site-nav > a[aria-current='page']::after { transform: translateX(-50%) scaleX(1); }
  .site-tools { display: flex; justify-self: end; align-items: center; gap: 0.65rem; }
  .site-subscribe-link {
    display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.45rem; padding-inline: 0.85rem;
    border: 1px solid transparent; border-radius: 0.55rem; background: var(--color-primary-soft);
    color: var(--color-primary); font-size: 0.8125rem; font-weight: 750; text-decoration: none;
  }
  .site-subscribe-link:hover, .site-subscribe-link[aria-current='page'] {
    border-color: var(--color-primary); text-decoration: none;
  }
  .site-utilities { display: flex; align-items: center; border-inline-start: 1px solid var(--color-line); padding-inline-start: 0.4rem; }
  .site-search-link {
    display: inline-flex; width: 2.75rem; min-height: 2.75rem; align-items: center; justify-content: center;
    border-radius: 0.45rem; color: var(--color-muted); text-decoration: none;
  }
  .site-search-link:hover, .site-search-link[aria-current='page'] { color: var(--color-primary); background: var(--color-primary-soft); }
  .site-header__signal { position: relative; height: 2px; overflow: hidden; }
  .site-header__signal::after {
    position: absolute; inset: 0; background: linear-gradient(90deg, transparent, var(--color-primary), var(--color-secondary), transparent);
    opacity: 0; content: '';
  }
  :global(html[data-navigation-loading]) .site-header__signal::after { opacity: 1; animation: navigation-pending 1.1s ease-in-out infinite; }
  @keyframes navigation-pending { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  .site-header__loading-message { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 60rem) {
    .site-header__inner { gap: 0.75rem; }
    .site-nav > a { padding-inline: 0.6rem; }
    .site-brand__caption { display: none; }
  }
  @media (max-width: 48rem) {
    .site-header__inner { grid-template-columns: auto 1fr; padding-block: 0.45rem 0; gap: 0.35rem 0.5rem; }
    .site-brand { gap: 0.45rem; }
    .site-brand__word { font-size: 1rem; }
    .site-brand__mark { width: 1.25rem; height: 1.25rem; }
    .site-brand__mark span { width: 0.85rem; height: 0.85rem; }
    .site-nav { grid-column: 1 / -1; grid-row: 2; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-block-start: 1px solid var(--color-line); gap: 0; }
    .site-nav > a { padding: 0; font-size: 0.8125rem; border-radius: 0; }
    .site-nav > a::after { bottom: 0; }
    .site-tools { grid-column: 2; grid-row: 1; gap: 0.25rem; }
    .site-subscribe-link { padding-inline: 0.6rem; gap: 0.35rem; }
    .site-utilities { border: 0; padding: 0; }
  }
  @media (max-width: 23rem) { .site-subscribe-link svg { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(html[data-navigation-loading]) .site-header__signal::after { animation: none; }
  }
</style>
