<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="切换为深色模式"
  aria-pressed="false"
>
  <span class="theme-toggle__polarity" aria-hidden="true">
    <svg class="theme-toggle__moon" viewBox="0 0 24 24"><path d="M20.8 14.1A9 9 0 0 1 9.9 3.2a9 9 0 1 0 10.9 10.9Z" /></svg>
    <svg class="theme-toggle__sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
  </span>
  <span data-theme-label>深色</span>
</button>

<script is:inline data-astro-rerun>
  (() => {
    const storageKey = 'nisconder-theme'
    const root = document.documentElement
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const controller = new AbortController()
    const { signal } = controller
    let themeTransition
    let feedbackTimer
    let themeRevision = 0

    const updateControls = (theme) => {
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        const isDark = theme === 'dark'
        button.setAttribute('aria-pressed', String(isDark))
        button.setAttribute('aria-label', isDark ? '切换为浅色模式' : '切换为深色模式')
        const label = button.querySelector('[data-theme-label]')
        if (label) label.textContent = isDark ? '浅色' : '深色'
      })
    }

    const applyTheme = (theme) => {
      root.dataset.theme = theme
      root.style.colorScheme = theme
      document.querySelector('#theme-color')?.setAttribute('content', theme === 'dark' ? '#0b1114' : '#f6f8f7')
      updateControls(theme)
    }

    const finishTransition = () => {
      themeRevision += 1
      themeTransition?.skipTransition()
      themeTransition = undefined
      window.clearTimeout(feedbackTimer)
      delete root.dataset.themeTransition
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        delete button.dataset.themeSwitching
      })
    }

    const restoreTheme = () => {
      finishTransition()
      let theme = systemTheme.matches ? 'dark' : 'light'
      try {
        const saved = localStorage.getItem(storageKey)
        if (saved === 'light' || saved === 'dark') theme = saved
      } catch {
        // Restore the system choice when storage is unavailable.
      }
      applyTheme(theme)
    }

    restoreTheme()

    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      if (button.dataset.themeBound === 'true') return
      button.dataset.themeBound = 'true'
      button.addEventListener('click', () => {
        button.dataset.themeSwitching = 'true'
        const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark'
        const revision = ++themeRevision
        themeTransition?.skipTransition()
        if (!reducedMotion.matches && !root.hasAttribute('data-astro-transition') && typeof document.startViewTransition === 'function') {
          root.dataset.themeTransition = ''
          const transition = document.startViewTransition(() => {
            if (revision === themeRevision) applyTheme(nextTheme)
          })
          themeTransition = transition
          transition.finished.catch(() => {}).finally(() => {
            if (themeTransition !== transition) return
            themeTransition = undefined
            delete root.dataset.themeTransition
          })
        } else {
          applyTheme(nextTheme)
        }
        window.clearTimeout(feedbackTimer)
        feedbackTimer = window.setTimeout(() => {
          delete button.dataset.themeSwitching
        }, 190)
        try {
          localStorage.setItem(storageKey, nextTheme)
        } catch {
          // The selected theme still applies for this page when storage is unavailable.
        }
      }, { signal })
    })

    systemTheme.addEventListener('change', (event) => {
      try {
        if (localStorage.getItem(storageKey)) return
      } catch {
        // Follow the system setting when storage cannot be read.
      }
      applyTheme(event.matches ? 'dark' : 'light')
    }, { signal })

    // A BFCache or prerendered document keeps its old DOM. Refresh the saved
    // choice on activation without rebinding controls or animating the restore.
    window.addEventListener('pageshow', restoreTheme, { signal })
    document.addEventListener('prerenderingchange', restoreTheme, { signal })
    window.addEventListener('pagehide', finishTransition, { signal })
    document.addEventListener('astro:before-preparation', restoreTheme, { signal })
    document.addEventListener('astro:before-swap', () => {
      finishTransition()
      controller.abort()
    }, { once: true, signal })
  })()
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    min-width: 4.85rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--control-radius);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 700;
    transition:
      background-color var(--motion-feedback) ease,
      border-color var(--motion-feedback) ease,
      color var(--motion-feedback) ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-secondary);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .theme-toggle__polarity { display: grid; width: 1.25rem; height: 1.25rem; place-items: center; }
  .theme-toggle__polarity svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle__sun, .theme-toggle[aria-pressed='true'] .theme-toggle__moon { display: none; }
  .theme-toggle[aria-pressed='true'] .theme-toggle__sun { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle[data-theme-switching='true'] .theme-toggle__polarity { animation: turn-light 260ms var(--ease-settle); }
    @keyframes turn-light { from { transform: rotate(-28deg) scale(.86); } }
  }

  @media (max-width: 44rem) {
    .theme-toggle {
      min-width: 2.75rem;
      padding-inline: 0.45rem;
    }

    .theme-toggle [data-theme-label] {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
