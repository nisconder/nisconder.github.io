<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="切换为深色模式"
  aria-pressed="false"
>
  <svg class="theme-toggle__icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.7" />
    <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" />
  </svg>
  <span data-theme-label>深色</span>
</button>

<script is:inline data-astro-rerun>
  (() => {
    const storageKey = 'nisconder-theme'
    const root = document.documentElement
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const controller = new AbortController()
    const { signal } = controller
    let themeTransition
    let feedbackTimer
    let themeRevision = 0

    const updateControls = (theme) => {
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        const isDark = theme === 'dark'
        button.setAttribute('aria-pressed', String(isDark))
        button.setAttribute('aria-label', isDark ? '切换为浅色模式' : '切换为深色模式')
        const label = button.querySelector('[data-theme-label]')
        if (label) label.textContent = isDark ? '浅色' : '深色'
      })
    }

    const applyTheme = (theme) => {
      root.dataset.theme = theme
      root.style.colorScheme = theme
      document.querySelector('#theme-color')?.setAttribute('content', theme === 'dark' ? '#0b1114' : '#e8f0f2')
      updateControls(theme)
    }

    const finishTransition = () => {
      themeRevision += 1
      themeTransition?.skipTransition()
      themeTransition = undefined
      window.clearTimeout(feedbackTimer)
      delete root.dataset.themeTransition
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        delete button.dataset.themeSwitching
      })
    }

    const restoreTheme = () => {
      finishTransition()
      let theme = systemTheme.matches ? 'dark' : 'light'
      try {
        const saved = localStorage.getItem(storageKey)
        if (saved === 'light' || saved === 'dark') theme = saved
      } catch {
        // Restore the system choice when storage is unavailable.
      }
      applyTheme(theme)
    }

    restoreTheme()

    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      if (button.dataset.themeBound === 'true') return
      button.dataset.themeBound = 'true'
      button.addEventListener('click', () => {
        button.dataset.themeSwitching = 'true'
        const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark'
        const revision = ++themeRevision
        themeTransition?.skipTransition()
        if (!reducedMotion.matches && !root.hasAttribute('data-astro-transition') && typeof document.startViewTransition === 'function') {
          root.dataset.themeTransition = ''
          const transition = document.startViewTransition(() => {
            if (revision === themeRevision) applyTheme(nextTheme)
          })
          themeTransition = transition
          transition.finished.catch(() => {}).finally(() => {
            if (themeTransition !== transition) return
            themeTransition = undefined
            delete root.dataset.themeTransition
          })
        } else {
          applyTheme(nextTheme)
        }
        window.clearTimeout(feedbackTimer)
        feedbackTimer = window.setTimeout(() => {
          delete button.dataset.themeSwitching
        }, 190)
        try {
          localStorage.setItem(storageKey, nextTheme)
        } catch {
          // The selected theme still applies for this page when storage is unavailable.
        }
      }, { signal })
    })

    systemTheme.addEventListener('change', (event) => {
      try {
        if (localStorage.getItem(storageKey)) return
      } catch {
        // Follow the system setting when storage cannot be read.
      }
      applyTheme(event.matches ? 'dark' : 'light')
    }, { signal })

    // A BFCache or prerendered document keeps its old DOM. Refresh the saved
    // choice on activation without rebinding controls or animating the restore.
    window.addEventListener('pageshow', restoreTheme, { signal })
    document.addEventListener('prerenderingchange', restoreTheme, { signal })
    window.addEventListener('pagehide', finishTransition, { signal })
    document.addEventListener('astro:before-preparation', restoreTheme, { signal })
    document.addEventListener('astro:before-swap', () => {
      finishTransition()
      controller.abort()
    }, { once: true, signal })
  })()
</script>

<style>
  .theme-toggle {
    display: inline-flex; width: 2.75rem; height: 2.75rem; flex-shrink: 0;
    align-items: center; justify-content: center; padding: 0;
    border: 0; border-radius: 0.45rem; background: transparent;
    color: var(--color-muted); cursor: pointer;
  }
  .theme-toggle:hover { color: var(--color-primary); background: var(--color-primary-soft); }
  .theme-toggle__icon { transition: transform 180ms ease; }
  .theme-toggle[aria-pressed='true'] .theme-toggle__icon { transform: rotate(180deg); }
  .theme-toggle [data-theme-label] {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  @media (prefers-reduced-motion: reduce) { .theme-toggle__icon { transition: none; } }
</style>
