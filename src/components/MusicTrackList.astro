---
import type { PlaylistTrack } from "../lib/playlist"

interface Props {
  tracks: PlaylistTrack[]
  startIndex?: number
  indexes?: number[]
  label: string
}

const { tracks, startIndex = 0, indexes, label } = Astro.props
const isRestricted = (fee: number) => fee !== 0 && fee !== 8
---

<ol class="track-list" start={startIndex + 1} aria-label={label}>
  {
    tracks.map((track, localIndex) => {
      const index = indexes?.[localIndex] ?? startIndex + localIndex
      const restricted = isRestricted(track.fee)
      const number = (index + 1).toString().padStart(2, "0")
      const neteaseUrl = `https://music.163.com/#/song?id=${track.id}`

      return (
        <li class:list={{ "track-row": true, "track-row--restricted": restricted }}>
          {
            restricted ? (
              <a
                class="track-row__control"
                href={neteaseUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`${track.title}，${track.author}，需在网易云播放`}
              >
                <span class="track-row__number" aria-hidden="true">{number}</span>
                <span class="track-row__copy">
                  <strong title={track.title}>{track.title}</strong>
                  <small>{track.author}</small>
                </span>
                <span class="track-row__state" aria-hidden="true">打开 ↗</span>
              </a>
            ) : (
              <button
                class="track-row__control"
                type="button"
                data-track-index={index}
                data-track-title={track.title}
                data-track-author={track.author}
                data-track-audio={track.audio}
                data-track-external={neteaseUrl}
                aria-label={`播放 ${track.title}，${track.author}`}
              >
                <span class="track-row__number" aria-hidden="true">{number}</span>
                <span class="track-row__copy">
                  <strong title={track.title}>{track.title}</strong>
                  <small>{track.author}</small>
                </span>
                <span class="track-row__state" data-track-state aria-hidden="true">播放</span>
              </button>
            )
          }
        </li>
      )
    })
  }
</ol>

<style>
  .track-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .track-row + .track-row {
    border-block-start: 1px solid var(--color-line);
  }

  .track-row__control {
    display: grid;
    width: 100%;
    min-width: 0;
    min-height: 4rem;
    grid-template-columns: 2.25rem minmax(0, 1fr) 4.25rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border: 0;
    border-radius: 0;
    background: var(--color-card);
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    text-align: start;
    text-decoration: none;
    touch-action: manipulation;
  }

  .track-row__control:hover,
  .track-row__control:focus-visible {
    background: var(--color-primary-soft);
  }

  .track-row__control:active {
    background: color-mix(in srgb, var(--color-primary-soft), var(--color-primary) 12%);
  }

  .track-row__control[aria-current='true'] {
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
  }

  .track-row__number,
  .track-row__state {
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .track-row__number {
    color: var(--color-secondary);
  }

  .track-row__state {
    justify-self: end;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .track-row__control[aria-current='true'] .track-row__number,
  .track-row__control[aria-current='true'] .track-row__state,
  .track-row__control[aria-current='true'] .track-row__copy small {
    color: inherit;
  }

  .track-row__copy {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
  }

  .track-row__copy strong,
  .track-row__copy small {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .track-row__copy strong {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.94rem;
    line-height: 1.35;
  }

  .track-row__copy small {
    overflow: hidden;
    color: var(--color-muted);
    font-size: var(--text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track-row--restricted .track-row__state {
    color: var(--color-secondary);
  }

  @media (max-width: 32rem) {
    .track-row__control {
      min-height: 4.25rem;
      grid-template-columns: 1.75rem minmax(0, 1fr) 3.5rem;
      gap: 0.5rem;
      padding-inline: 0.75rem;
    }

    .track-row__state {
      font-size: var(--text-xs);
    }
  }
</style>
