---
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__statement">文字、声音和个人注脚。</p>
    <nav class="site-footer__links" aria-label="站点索引">
      <a href="/articles/">文章</a>
      <a href="/music/">音乐</a>
      <a href="/about/">关于</a>
      <a href="/rss.xml">RSS</a>
      <a href="https://github.com/nisconder" rel="me noopener" target="_blank">GitHub</a>
      <a href="mailto:72447244.wnm@gmail.com">邮箱</a>
    </nav>
    <p class="site-footer__copyright">© {year} Nisconder</p>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .site-footer__inner {
    display: flex;
    width: min(100%, var(--header-width));
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-inline: auto;
    padding: 1.25rem var(--site-gutter);
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer__statement {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .site-footer a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .site-footer__copyright {
    margin-inline-start: auto;
    font-family: var(--font-utility);
  }

  @media (max-width: 43.75rem) {
    .site-footer__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer__copyright {
      margin-inline-start: 0;
    }
  }
</style>
