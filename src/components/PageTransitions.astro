---
import { ClientRouter } from 'astro:transitions'
---

<ClientRouter fallback="swap" />

<script>
  import { installNavigationFeedback } from '../lib/navigation-feedback.mjs'
  import { installPublicNavigationPrefetch } from '../lib/navigation-cache.mjs'

  // The feedback wrapper runs after the cache hook and covers hits and misses.
  // Development keeps Astro's loader, including its client-only island setup.
  if (import.meta.env.PROD) installPublicNavigationPrefetch(document, window)
  installNavigationFeedback(document)

  document.addEventListener('astro:before-swap', (event) => {
    // Keep Astro's lifecycle and history while skipping navigation animation.
    // CSS separately excludes the document from navigation snapshot capture.
    event.viewTransition.ready.catch(() => {})
    event.viewTransition.skipTransition()

    let theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
    try {
      const saved = localStorage.getItem('nisconder-theme')
      if (saved === 'light' || saved === 'dark') theme = saved
    } catch {
      // Preserve the current visible theme if storage is unavailable.
    }
    const nextRoot = event.newDocument.documentElement
    nextRoot.dataset.theme = theme
    nextRoot.style.colorScheme = theme
    event.newDocument.querySelector('#theme-color')?.setAttribute(
      'content', theme === 'dark' ? '#0b1114' : '#e8f0f2',
    )
    event.newDocument.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', String(theme === 'dark'))
      button.setAttribute('aria-label', theme === 'dark' ? '切换为浅色模式' : '切换为深色模式')
      const label = button.querySelector('[data-theme-label]')
      if (label) label.textContent = theme === 'dark' ? '浅色' : '深色'
    })
  })
</script>
