---
interface Props {
  href: string
  title: string
  description?: string
  excerpt?: string
  date: string
  datetime?: string
  readingMinutes?: number
  category?: string
  tags?: string[]
}

const {
  href,
  title,
  description,
  excerpt,
  date,
  datetime,
  readingMinutes,
  category,
  tags = [],
} = Astro.props
const summary = description ?? excerpt
const searchHref = (query: string) => `/search/?q=${encodeURIComponent(query)}`
const categoryHref = (value: string) => `/search/?category=${encodeURIComponent(value)}`
---

<article class="post-row" data-post-category={category ?? ''}>
  <div class="post-row__meta">
    <time datetime={datetime ?? date}>{date}</time>
    {
      readingMinutes && (
        <span class="post-row__reading-time">约 {readingMinutes} 分钟</span>
      )
    }
    {
      category && (
        <a
          class="post-row__category"
          href={categoryHref(category)}
          aria-label={`查看“${category}”分类下的文章`}
        >
          <strong>{category}</strong>
        </a>
      )
    }
  </div>

  <div class="post-row__body">
    <h3 class="post-row__title"><a data-astro-prefetch href={href}>{title}</a></h3>
    {summary && <p class="post-row__summary">{summary}</p>}

    {tags.length > 0 && (
      <nav class="post-row__branches" aria-label={`《${title}》的相关标签`}>
        <ul>
          {tags.map((tag) => (
            <li><a href={searchHref(tag)} aria-label={`搜索标签“${tag}”`}>{tag}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</article>

<style>
  .post-row {
    display: grid;
    min-width: 0;
    gap: 0.35rem 1rem;
    padding-block: clamp(0.8rem, 2vw, 1.4rem);
    border-block-start: 1px solid var(--color-line);
  }

  .post-row:last-child {
    padding-block-end: 0;
  }

  .post-row__meta,
  .post-row__body {
    min-width: 0;
  }

  .post-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.8rem;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .post-row__meta time {
    letter-spacing: 0.025em;
    font-variant-numeric: tabular-nums;
  }

  .post-row__reading-time {
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .post-row__category {
    display: inline-flex;
    max-width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-secondary);
    text-decoration: none;
  }

  .post-row__category strong {
    overflow-wrap: anywhere;
    font-weight: 750;
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.28em;
  }

  .post-row__category:hover {
    color: var(--color-primary);
  }

  .post-row__title {
    margin-block-end: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.65rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .post-row__title a {
    display: inline-flex;
    max-width: 100%;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }

  .post-row__title a:is(:hover, :focus-visible) {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .post-row__summary {
    max-width: 42rem;
    margin-block-end: 0.2rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .post-row__branches {
    font-size: var(--text-xs);
  }

  .post-row__branches ul {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 0 0.35rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .post-row__branches li {
    max-width: 100%;
    min-width: 0;
  }

  .post-row__branches a {
    display: inline-flex;
    max-width: 100%;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.35rem;
    color: var(--color-secondary);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration-color: color-mix(in srgb, var(--color-secondary), transparent 35%);
    text-underline-offset: 0.25em;
  }

  .post-row__branches a::before {
    margin-inline-end: 0.25rem;
    color: var(--color-muted);
    content: '#';
    font-weight: 500;
  }

  .post-row__branches a:hover {
    color: var(--color-primary);
    text-decoration-color: var(--color-primary);
  }

  @media (min-width: 56rem) {
    .post-row {
      grid-template-columns: minmax(6.75rem, 7.75rem) minmax(0, 1fr);
      align-items: start;
      column-gap: clamp(1rem, 2.5vw, 1.75rem);
    }

    .post-row__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
      padding-block-start: 0.25rem;
    }

    .post-row__category {
      width: 100%;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 0.1rem;
    }

  }

</style>
