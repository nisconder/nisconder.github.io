---
interface Props {
  href: string
  title: string
  description?: string
  excerpt?: string
  date: string
  datetime?: string
  category?: string
  tags?: string[]
}

const { href, title, description, excerpt, date, datetime, category, tags = [] } = Astro.props
const summary = description ?? excerpt
---

<article class="post-row">
  <div class="post-row__meta">
    <time datetime={datetime ?? date}>{date}</time>
    {category && <span>{category}</span>}
  </div>

  <h2><a href={href}>{title}</a></h2>
  {summary && <p class="post-row__summary">{summary}</p>}

  {tags.length > 0 && (
    <ul class="post-row__tags" aria-label="文章标签">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}

  <a class="post-row__read" href={href} aria-label={`阅读《${title}》`}>
    阅读文章 <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-row {
    position: relative;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-block-start: 1px solid var(--color-line);
  }

  .post-row:last-child {
    border-block-end: 1px solid var(--color-line);
  }

  .post-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    margin-block-end: 0.65rem;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .post-row__meta > * + *::before {
    margin-inline-end: 0.8rem;
    color: var(--color-secondary);
    content: '/';
  }

  h2 {
    max-width: 28ch;
    margin-block-end: 0.65rem;
    font-size: clamp(1.45rem, 3.6vw, 2rem);
    letter-spacing: -0.02em;
  }

  h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
  }

  .post-row__summary {
    max-width: 42rem;
    margin-block-end: 0.9rem;
    color: var(--color-muted);
    font-size: 0.9875rem;
    line-height: 1.7;
  }

  .post-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding: 0;
    margin: 0 0 0.85rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    list-style: none;
  }

  .post-row__tags li + li::before {
    margin-inline-end: 0.75rem;
    color: var(--color-line);
    content: '·';
  }

  .post-row__read {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.28em;
  }

  .post-row__read:hover {
    color: var(--color-text);
  }

  @media (max-width: 31.25rem) {
    .post-row__read {
      width: 100%;
      min-height: 3rem;
      justify-content: center;
      border: 1px solid var(--color-primary);
      border-radius: 0.25rem;
      text-decoration: none;
    }
  }
</style>
