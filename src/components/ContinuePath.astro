---
export interface InterestPoint {
  section: string
  relation: string
  title: string
  description: string
  href: string
  external?: boolean
}

interface Props {
  next: InterestPoint
  branch?: InterestPoint
  title?: string
  description?: string
}

const {
  next,
  branch,
  title = '从这里继续',
  description = '顺着当前内容继续，或者换到另一个板块。',
} = Astro.props
const visibleItems = [next, branch].filter((item): item is InterestPoint => Boolean(item))
const headingId = `continue-path-${Astro.url.pathname.replace(/[^a-z0-9]+/gi, '-') || 'home'}`
---

{
  visibleItems.length > 0 && (
    <section class="continue-path axis-section" aria-labelledby={headingId}>
      <header class="continue-path__header">
        <div>
          <p class="eyebrow">CONTINUE / PATH</p>
          <h2 id={headingId}>{title}</h2>
        </div>
        <p>{description}</p>
      </header>

      <nav aria-label={title}>
        <ul class="continue-path__list">
          {visibleItems.map((item, index) => (
            <li class="continue-path__item">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                <span class="continue-path__role">
                  {index === 0 ? '接着看' : '换个方向'} · {item.section}
                </span>
                <strong>{item.title}</strong>
                <span class="continue-path__relation">{item.relation}</span>
                <span class="continue-path__description">{item.description}</span>
                <span class="continue-path__arrow" aria-hidden="true">
                  {item.external ? '↗' : '→'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>
  )
}

<style>
  .continue-path {
    width: min(100%, var(--discussion-width));
    margin-inline: auto;
  }

  .continue-path__header {
    display: grid;
    grid-template-columns: minmax(12rem, 0.7fr) minmax(18rem, 1.3fr);
    align-items: end;
    gap: 1rem clamp(2rem, 7vw, 6rem);
    margin-block-end: 1.25rem;
  }

  .continue-path__header h2,
  .continue-path__header p {
    margin: 0;
  }

  .continue-path__header h2 {
    font-size: var(--title-section);
    letter-spacing: -0.02em;
  }

  .continue-path__header > p {
    max-width: 42ch;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .continue-path__list {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.65fr);
    padding: 0;
    margin: 0;
    border-block: 1px solid var(--color-line-strong);
    list-style: none;
  }

  .continue-path__item {
    --path-accent: var(--color-primary);
    min-width: 0;
  }

  .continue-path__item + .continue-path__item {
    --path-accent: var(--color-secondary);
    border-inline-start: 1px solid var(--color-line);
  }

  .continue-path__item a {
    position: relative;
    display: grid;
    min-height: 10.5rem;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem 3.25rem 1.25rem 1.35rem;
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--motion-feedback) ease;
  }

  .continue-path__item:first-child a {
    background: color-mix(in srgb, var(--color-primary-soft), transparent 44%);
  }

  .continue-path__item a::before {
    width: 0.7rem;
    height: 0.7rem;
    margin-block-end: 0.2rem;
    background: var(--path-accent);
    content: '';
  }

  .continue-path__item a:hover {
    background: var(--color-surface-soft);
  }

  .continue-path__item a:focus-visible {
    z-index: 1;
    outline: 3px solid var(--color-secondary);
    outline-offset: -3px;
  }

  .continue-path__role {
    color: var(--path-accent);
    font-family: var(--font-utility);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .continue-path__item strong {
    max-width: 28ch;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .continue-path__description {
    max-width: 46ch;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .continue-path__relation {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.5;
  }

  .continue-path__item + .continue-path__item strong {
    font-size: clamp(1rem, 1.7vw, 1.18rem);
  }

  .continue-path__arrow {
    position: absolute;
    inset-inline-end: 1.35rem;
    inset-block-end: 1.25rem;
    color: var(--path-accent);
    font-size: 1.15rem;
    transition: transform var(--motion-feedback) var(--ease-settle);
  }

  .continue-path__item a:hover .continue-path__arrow {
    transform: translateX(0.25rem);
  }

  @media (max-width: 44rem) {
    .continue-path__header {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }

    .continue-path__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .continue-path__item + .continue-path__item {
      border-block-start: 1px solid var(--color-line);
      border-inline-start: 0;
    }

    .continue-path__item + .continue-path__item a {
      min-height: 7.5rem;
    }

    .continue-path__item a {
      min-height: 8.5rem;
      padding: 1rem 3rem 1rem 1.1rem;
    }

    .continue-path__arrow {
      inset-inline-end: 1.1rem;
      inset-block-end: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .continue-path__item a,
    .continue-path__arrow {
      transition: none;
    }
  }
</style>
