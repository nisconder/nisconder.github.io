---
import '../styles/waline.css'

interface Props {
  path?: string | URL
  title?: string
  description?: string
}

const {
  path = Astro.url.pathname,
  title = '在这里留言',
  description = '这一页有自己的讨论区。可以回应内容，也可以留下新的话题。',
} = Astro.props

const pathname = new URL(path.toString(), Astro.url.origin).pathname.replace(/\/{2,}/g, '/')
const commentPath = pathname === '/' ? '/' : `${pathname.replace(/\/+$/, '')}/`
---

<section
  class="comments-section site-comments"
  id="comments"
  aria-labelledby="comments-title"
  data-site-comments
>
  <header class="site-comments__header">
    <span class="site-comments__icon" aria-hidden="true"><i></i><i></i></span>
    <div class="site-comments__heading">
      <h2 id="comments-title">{title}</h2>
      <p data-comments-caption>{description}</p>
    </div>
    <button
      class="site-comments__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-comments-body"
      data-comments-toggle
      hidden
    >
      <span data-comments-toggle-label>展开留言</span>
      <span class="site-comments__toggle-mark" aria-hidden="true"></span>
    </button>
  </header>
  <div id="site-comments-body" class="site-comments__body" data-comments-body hidden>
    <p class="site-comments__status" data-waline-status aria-live="polite">
      正在准备留言区…
    </p>
    <div data-waline-root data-waline-path={commentPath}></div>
    <p class="site-comments__status" data-waline-login-status role="status" hidden></p>
  </div>
  <noscript>启用 JavaScript 后可以查看或写下留言。</noscript>
</section>

<style>
  .site-comments {
    width: min(100%, var(--discussion-width));
    margin: clamp(2rem, 5vw, 4rem) auto 0;
    border: 1px solid var(--masthead-line);
    border-radius: var(--card-radius);
    background: var(--color-card);
    scroll-margin-block-start: 1rem;
  }
  .site-comments__header {
    display: flex;
    align-items: center;
    gap: clamp(.75rem, 2vw, 1.2rem);
    padding: clamp(1rem, 2.7vw, 1.8rem);
    border-radius: var(--card-radius) var(--card-radius) 0 0;
    background: var(--masthead-surface);
  }
  .site-comments__icon {
    position: relative;
    flex: none;
    width: 2.8rem;
    height: 2.8rem;
    color: var(--color-primary);
  }
  .site-comments__icon i {
    position: absolute;
    width: 1.85rem;
    height: 1.45rem;
    border: 1.8px solid currentColor;
    border-radius: .55rem .55rem .55rem .12rem;
  }
  .site-comments__icon i:first-child {
    right: .15rem;
    bottom: .34rem;
    color: var(--color-secondary);
    background: var(--color-secondary-soft);
    transform: scaleX(-1);
  }
  .site-comments__icon i:last-child {
    top: .28rem;
    left: .12rem;
    background: var(--color-primary-soft);
  }
  .site-comments__icon i:last-child::after {
    position: absolute;
    inset: .45rem .38rem auto;
    border-top: 2px solid currentColor;
    content: '';
  }
  .site-comments__heading { flex: 1; min-width: 0; }
  .site-comments__heading h2 {
    margin: 0;
    color: var(--color-heading);
    font: 720 clamp(1.4rem, 2.6vw, 1.95rem)/1.22 var(--font-display);
    letter-spacing: -.035em;
  }
  .site-comments__heading p, .site-comments__status, .site-comments noscript {
    color: var(--color-muted);
    font: 400 var(--text-sm)/1.65 var(--font-body);
  }
  .site-comments__heading p { margin: .32rem 0 0; }
  .site-comments__status { margin: 0; padding: .8rem 0; }
  .site-comments__status[hidden], .site-comments__toggle[hidden], .site-comments__body[hidden] { display: none; }
  .site-comments__toggle {
    display: inline-flex;
    flex: none;
    min-height: 2.75rem;
    align-items: center;
    gap: .62rem;
    padding: .35rem .75rem;
    border: 1px solid var(--masthead-line);
    border-radius: var(--control-radius);
    background: var(--color-surface);
    color: var(--color-primary);
    font: 650 .83rem/1.2 var(--font-body);
    cursor: pointer;
  }
  .site-comments__toggle-mark {
    width: .48rem;
    height: .48rem;
    border-bottom: 1.7px solid currentColor;
    border-right: 1.7px solid currentColor;
    transform: translateY(-.1rem) rotate(45deg);
    transition: transform var(--motion-feedback) ease;
  }
  .site-comments__toggle[aria-expanded='true'] .site-comments__toggle-mark { transform: translateY(.1rem) rotate(225deg); }
  .site-comments__body { min-width: 0; padding: clamp(.85rem, 2.6vw, 1.75rem); }
  .site-comments[data-comments-expanded='false'] .site-comments__header { border-radius: var(--card-radius); padding-block: .85rem; }
  @media (max-width: 44rem) {
    .site-comments__header { flex-wrap: wrap; gap: .65rem; }
    .site-comments__heading p { display: none; }
    .site-comments__icon { width: 2.1rem; height: 2.1rem; }
    .site-comments__icon i { width: 1.45rem; height: 1.1rem; }
    .site-comments__icon i:last-child::after { inset: .33rem .25rem auto; }
  }
  @media (prefers-reduced-motion: reduce) { .site-comments__toggle-mark { transition: none; } }
</style>

<script>
  import { installCommentsController } from '../lib/comments-controller.mjs'

  installCommentsController()
</script>
