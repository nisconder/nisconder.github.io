---
interface Props {
  path?: string | URL
  title?: string
  description?: string
}

const {
  path = Astro.url.pathname,
  title = '在这里留言',
  description = '这一页有自己的讨论区。可以回应内容，也可以留下新的话题。',
} = Astro.props

const pathname = new URL(path.toString(), Astro.url.origin).pathname.replace(/\/{2,}/g, '/')
const commentPath = pathname === '/' ? '/' : `${pathname.replace(/\/+$/, '')}/`
---

<section
  class="comments-section site-comments"
  id="comments"
  aria-labelledby="comments-title"
  data-site-comments
>
  <header class="site-comments__header">
    <div class="site-comments__heading">
      <h2 id="comments-title">{title}</h2>
      <p>{description}</p>
    </div>
    <button
      class="site-comments__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-comments-body"
      data-comments-toggle
      hidden
    >
      <span data-comments-toggle-label>展开留言</span>
      <span class="site-comments__toggle-mark" aria-hidden="true"></span>
    </button>
  </header>
  <div id="site-comments-body" class="site-comments__body" data-comments-body>
    <p class="site-comments__status" data-waline-status aria-live="polite">
      滚动到这里时自动载入留言。
    </p>
    <div data-waline-root data-waline-path={commentPath}></div>
    <p class="site-comments__status" data-waline-login-status role="status" hidden></p>
    <noscript>留言区需要启用 JavaScript；其他内容不受影响。</noscript>
  </div>
</section>

<style>
  .site-comments {
    position: relative;
    width: min(100%, var(--discussion-width));
    margin: clamp(2.5rem, 5vw, 4.5rem) auto 0;
    padding-block-start: clamp(1.5rem, 2.5vw, 2rem);
    overflow: visible;
    border-block-start: 1px solid var(--color-line-strong);
  }

  .site-comments__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .site-comments__heading {
    display: grid;
    min-width: 0;
    flex: 1 1 auto;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(22rem, 1.3fr);
    align-items: end;
    gap: 1rem clamp(2rem, 7vw, 6rem);
  }

  .site-comments__heading h2,
  .site-comments__heading p {
    margin: 0;
  }

  .site-comments__heading h2 {
    font-size: clamp(1.6rem, 2.7vw, 2.15rem);
    line-height: 1.25;
  }

  .site-comments__heading > p:last-child {
    max-width: 50ch;
  }

  .site-comments__heading > p:last-child,
  .site-comments__status {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .site-comments__toggle {
    display: inline-grid;
    min-width: 7.75rem;
    min-height: 2.75rem;
    flex: 0 0 auto;
    grid-template-columns: auto 1.4rem;
    align-items: center;
    gap: 0.55rem;
    padding-inline: 1rem;
    border: 1px solid var(--color-primary);
    border-inline-end: 0.3rem solid var(--color-secondary);
    border-radius: var(--card-radius);
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 750;
    transition:
      background-color var(--motion-feedback) ease,
      border-color var(--motion-feedback) ease,
      color var(--motion-feedback) ease;
  }

  .site-comments__toggle-mark {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  .site-comments__toggle-mark::before,
  .site-comments__toggle-mark::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: 0.9rem;
    height: 0.1rem;
    border-radius: 999px;
    background: currentColor;
    content: '';
    transition: transform 220ms ease;
  }

  .site-comments__toggle-mark::before {
    transform: translate(-50%, -50%);
  }

  .site-comments__toggle-mark::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .site-comments__toggle[aria-expanded='true'] .site-comments__toggle-mark::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .site-comments__toggle[aria-expanded='true'] .site-comments__toggle-mark::after {
    transform: translate(-50%, -50%) rotate(135deg);
  }

  .site-comments__body {
    min-width: 0;
  }

  .site-comments :global(.wl-editor) {
    height: 7.25rem !important;
    min-height: 7.25rem !important;
    max-height: 18rem !important;
    resize: vertical !important;
  }

  .site-comments :global(.wl-actions a[href*='markdown' i]),
  .site-comments :global(.wl-actions [aria-label*='markdown' i]),
  .site-comments :global(.wl-actions [title*='markdown' i]) {
    display: none !important;
  }

  @media (max-width: 44rem) {
    .site-comments {
      margin-block-start: 2rem;
      padding-block-start: 1.5rem;
    }

    .site-comments__header {
      align-items: center;
      gap: 0.75rem;
      margin-block-end: 0;
    }

    .site-comments__heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .site-comments__heading h2 {
      font-size: 1.35rem;
    }

    .site-comments__heading > p:last-child {
      display: none;
    }

    .site-comments__body {
      margin-block-start: 1rem;
    }

    .site-comments :global(.wl-header) {
      grid-template-columns: minmax(0, 1fr) !important;
      gap: 0.6rem !important;
    }

    .site-comments :global(.wl-editor) {
      height: 6.75rem !important;
      min-height: 6.75rem !important;
      max-height: 14rem !important;
    }

    .site-comments:not([data-comments-bound]) .site-comments__body {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-comments__toggle-mark::before,
    .site-comments__toggle-mark::after {
      transition: none;
    }
  }
</style>

<script>
  import { bindWalineLoginFeedback } from '../lib/waline-login-feedback.mjs'

  const bindLoginFeedback = () => {
    document.querySelectorAll<HTMLElement>('[data-site-comments]').forEach((section) => {
      if (section.dataset.loginFeedbackBound) return
      const root = section.querySelector<HTMLElement>('[data-waline-root]')
      const status = section.querySelector<HTMLElement>('[data-waline-login-status]')
      if (!root || !status) return
      section.dataset.loginFeedbackBound = 'true'
      const dispose = bindWalineLoginFeedback(root, status, 'https://my-waline-pink.vercel.app')
      document.addEventListener('astro:before-swap', dispose, { once: true })
    })
  }

  bindLoginFeedback()
  document.addEventListener('astro:page-load', bindLoginFeedback)
</script>

<script is:inline data-astro-rerun>
  (() => {
    const sections = [...document.querySelectorAll('[data-site-comments]:not([data-comments-bound])')]
    if (sections.length === 0) return

    const styleHref = 'https://cdn.jsdelivr.net/npm/@waline/client@3.7.1/dist/waline.css'
    const scriptHref = 'https://cdn.jsdelivr.net/npm/@waline/client@3.7.1/dist/waline.js'

    const loadStyles = (signal) => new Promise((resolve, reject) => {
      if (signal.aborted) {
        reject(new DOMException('Comments page was left', 'AbortError'))
        return
      }
      let link = document.querySelector(`link[href="${styleHref}"]`)
      if (link instanceof HTMLLinkElement && link.sheet) return resolve()

      const shouldAppend = !(link instanceof HTMLLinkElement)
      if (shouldAppend) {
        link = document.createElement('link')
        link.rel = 'stylesheet'
        link.href = styleHref
      }

      if (!(link instanceof HTMLLinkElement)) {
        reject(new Error('Waline stylesheet link could not be created'))
        return
      }

      const cleanup = () => {
        link.removeEventListener('load', onLoad)
        link.removeEventListener('error', onError)
        signal.removeEventListener('abort', onAbort)
      }
      const onLoad = () => {
        cleanup()
        resolve()
      }
      const onError = () => {
        cleanup()
        link.remove()
        reject(new Error('Waline stylesheet failed to load'))
      }
      const onAbort = () => {
        cleanup()
        if (shouldAppend) link.remove()
        reject(new DOMException('Comments page was left', 'AbortError'))
      }
      link.addEventListener('load', onLoad, { once: true })
      link.addEventListener('error', onError, { once: true })
      signal.addEventListener('abort', onAbort, { once: true })

      if (shouldAppend) document.head.append(link)
    })

    const loadModule = () => {
      if (window.__nisconderWalineModule) return window.__nisconderWalineModule
      const module = import(scriptHref)
      window.__nisconderWalineModule = module
      module.catch(() => {
        if (window.__nisconderWalineModule === module) {
          delete window.__nisconderWalineModule
        }
      })
      return module
    }

    const bindSection = (section) => {
      if (!(section instanceof HTMLElement)) return
      const root = section.querySelector('[data-waline-root]')
      const status = section.querySelector('[data-waline-status]')
      const body = section.querySelector('[data-comments-body]')
      const toggle = section.querySelector('[data-comments-toggle]')
      const toggleLabel = section.querySelector('[data-comments-toggle-label]')
      if (
        !(root instanceof HTMLElement)
        || !(status instanceof HTMLElement)
        || !(body instanceof HTMLElement)
        || !(toggle instanceof HTMLButtonElement)
      ) return
      section.dataset.commentsBound = 'true'

      const lifecycle = new AbortController()
      const mobileQuery = window.matchMedia('(max-width: 44rem)')
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      let disposed = false
      let observer
      let bodyAnimation
      let rootAnimation
      let bodyHideTimer
      let scrollFrame
      let disclosureRevision = 0
      const active = () => !disposed && section.isConnected && root.isConnected

      const setExpanded = (expanded, animate = false) => {
        if (!active()) return
        const revision = ++disclosureRevision
        window.clearTimeout(bodyHideTimer)
        bodyAnimation?.cancel()
        toggle.hidden = !mobileQuery.matches
        toggle.setAttribute('aria-expanded', String(expanded))
        if (toggleLabel) toggleLabel.textContent = expanded ? '收起留言' : '展开留言'
        section.dataset.commentsExpanded = String(expanded)

        if (!animate || reducedMotion.matches) {
          body.hidden = !expanded
          body.inert = !expanded
          body.setAttribute('aria-hidden', String(!expanded))
          return
        }

        if (expanded) {
          body.hidden = false
          body.inert = false
          body.setAttribute('aria-hidden', 'false')
          bodyAnimation = body.animate(
            [{ opacity: 0 }, { opacity: 1 }],
            { duration: 220, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
          )
          return
        }

        if (body.contains(document.activeElement)) toggle.focus()
        body.inert = true
        body.setAttribute('aria-hidden', 'true')
        bodyAnimation = body.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: 120, easing: 'ease-in', fill: 'forwards' },
        )
        const finishCollapse = () => {
          if (active() && revision === disclosureRevision && section.dataset.commentsExpanded === 'false') {
            body.hidden = true
          }
        }
        bodyAnimation.finished.catch(() => undefined).then(finishCollapse)
        bodyHideTimer = window.setTimeout(finishCollapse, 160)
      }

      const showRetry = () => {
        if (!active()) return
        status.replaceChildren('留言加载失败。 ')
        const retry = document.createElement('button')
        retry.type = 'button'
        retry.className = 'button secondary'
        retry.textContent = '重新加载'
        retry.addEventListener('click', () => {
          root.__walineInstance?.destroy?.()
          delete root.__walineInstance
          root.replaceChildren()
          root.dataset.walineState = 'idle'
          retry.remove()
          loadComments()
        }, { once: true, signal: lifecycle.signal })
        status.append(retry)
      }

      const loadComments = async () => {
        if (!active()) return
        if (root.dataset.walineState === 'loading' || root.dataset.walineState === 'ready') return
        root.dataset.walineState = 'loading'
        status.textContent = '正在加载留言…'

        try {
          const [, module] = await Promise.all([loadStyles(lifecycle.signal), loadModule()])
          if (!active()) return
          root.replaceChildren()
          root.__walineInstance = module.init({
            el: root,
            serverURL: 'https://my-waline-pink.vercel.app',
            path: root.dataset.walinePath,
            lang: 'zh-CN',
            login: 'enable',
            dark: "html[data-theme='dark']",
          })
          root.dataset.walineState = 'ready'
          status.remove()
          if (!reducedMotion.matches) {
            rootAnimation = root.animate(
              [{ opacity: 0 }, { opacity: 1 }],
              { duration: 180, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
            )
          }
        } catch {
          if (!active()) return
          root.__walineInstance?.destroy?.()
          delete root.__walineInstance
          root.replaceChildren()
          root.dataset.walineState = 'error'
          showRetry()
        }
      }

      const observeComments = () => {
        if (!active() || body.hidden || root.dataset.walineState === 'ready') return
        if ('IntersectionObserver' in window) {
          observer?.disconnect()
          observer = new IntersectionObserver((entries) => {
            if (!active() || !entries.some((entry) => entry.isIntersecting)) return
            observer.disconnect()
            loadComments()
          }, { rootMargin: '150px 0px' })
          observer.observe(section)
        } else {
          loadComments()
        }
      }

      const dispose = () => {
        if (disposed) return
        disposed = true
        disclosureRevision += 1
        lifecycle.abort()
        observer?.disconnect()
        window.clearTimeout(bodyHideTimer)
        cancelAnimationFrame(scrollFrame)
        bodyAnimation?.cancel()
        rootAnimation?.cancel()
        try {
          root.__walineInstance?.destroy?.()
        } finally {
          delete root.__walineInstance
        }
      }

      document.addEventListener('astro:before-swap', (event) => {
        const swap = event.swap
        // Keep Waline intact through the exit animation, then unmount while its head styles still exist.
        event.swap = () => {
          dispose()
          swap.call(event)
        }
      }, { signal: lifecycle.signal })

      if (mobileQuery.matches) {
        setExpanded(false)
      } else {
        setExpanded(true)
        observeComments()
      }

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') !== 'true'
        setExpanded(expanded, true)
        if (expanded) {
          loadComments()
          cancelAnimationFrame(scrollFrame)
          scrollFrame = requestAnimationFrame(() => {
            if (active()) body.scrollIntoView({ block: 'nearest' })
          })
        } else {
          observer?.disconnect()
        }
      }, { signal: lifecycle.signal })

      mobileQuery.addEventListener?.('change', (event) => {
        if (event.matches) {
          setExpanded(false)
          observer?.disconnect()
        } else {
          setExpanded(true)
          observeComments()
        }
      }, { signal: lifecycle.signal })
    }

    sections.forEach(bindSection)

  })()
</script>
