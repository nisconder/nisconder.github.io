---
interface Props {
  path?: string | URL
  title?: string
  description?: string
}

const {
  path = Astro.url.pathname,
  title = '在这里留言',
  description = '这一页有自己的讨论区。可以回应内容，也可以留下新的话题。',
} = Astro.props

const pathname = new URL(path.toString(), Astro.url.origin).pathname.replace(/\/{2,}/g, '/')
const commentPath = pathname === '/' ? '/' : `${pathname.replace(/\/+$/, '')}/`
---

<section
  class="comments-section site-comments"
  id="comments"
  aria-labelledby="comments-title"
  data-site-comments
>
  <header class="site-comments__header">
    <div class="site-comments__heading">
      <h2 id="comments-title">{title}</h2>
      <p>{description}</p>
    </div>
    <button
      class="site-comments__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-comments-body"
      data-comments-toggle
      hidden
    >
      展开留言
    </button>
  </header>
  <div id="site-comments-body" class="site-comments__body" data-comments-body>
    <p class="site-comments__status" data-waline-status aria-live="polite">
      滚动到这里时自动载入留言。
    </p>
    <div data-waline-root data-waline-path={commentPath}></div>
    <noscript>留言区需要启用 JavaScript；其他内容不受影响。</noscript>
  </div>
</section>

<style>
  .site-comments {
    position: relative;
    width: min(100%, var(--discussion-width));
    margin: clamp(2.5rem, 5vw, 4.5rem) auto 0;
    padding-block-start: clamp(1.5rem, 2.5vw, 2rem);
    overflow: visible;
    border-block-start: 1px solid var(--color-line-strong);
  }

  .site-comments__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .site-comments__heading {
    display: grid;
    min-width: 0;
    flex: 1 1 auto;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(22rem, 1.3fr);
    align-items: end;
    gap: 1rem clamp(2rem, 7vw, 6rem);
  }

  .site-comments__heading h2,
  .site-comments__heading p {
    margin: 0;
  }

  .site-comments__heading h2 {
    font-size: clamp(1.6rem, 2.7vw, 2.15rem);
    line-height: 1.25;
  }

  .site-comments__heading > p:last-child {
    max-width: 50ch;
  }

  .site-comments__heading > p:last-child,
  .site-comments__status {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .site-comments__toggle {
    min-width: 7rem;
    min-height: 2.75rem;
    flex: 0 0 auto;
    padding-inline: 1rem;
    border: 1px solid var(--color-primary);
    border-inline-end: 0.3rem solid var(--color-secondary);
    border-radius: var(--card-radius);
    background: var(--color-reading-panel);
    color: var(--color-on-reading-panel);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 750;
  }

  .site-comments__body {
    min-width: 0;
  }

  @media (max-width: 44rem) {
    .site-comments {
      margin-block-start: 2rem;
      padding-block-start: 1.5rem;
    }

    .site-comments__header {
      align-items: center;
      gap: 0.75rem;
      margin-block-end: 0;
    }

    .site-comments__heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .site-comments__heading h2 {
      font-size: 1.35rem;
    }

    .site-comments__heading > p:last-child {
      display: none;
    }

    .site-comments__body {
      margin-block-start: 1rem;
    }

    .site-comments:not([data-comments-bound]) .site-comments__body {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const sections = [...document.querySelectorAll('[data-site-comments]:not([data-comments-bound])')]
    if (sections.length === 0) return

    const styleHref = 'https://cdn.jsdelivr.net/npm/@waline/client@3.7.1/dist/waline.css'
    const scriptHref = 'https://cdn.jsdelivr.net/npm/@waline/client@3.7.1/dist/waline.js'

    const loadStyles = () => new Promise((resolve, reject) => {
      let link = document.querySelector(`link[href="${styleHref}"]`)
      if (link instanceof HTMLLinkElement && link.sheet) return resolve()

      const shouldAppend = !(link instanceof HTMLLinkElement)
      if (shouldAppend) {
        link = document.createElement('link')
        link.rel = 'stylesheet'
        link.href = styleHref
      }

      if (!(link instanceof HTMLLinkElement)) {
        reject(new Error('Waline stylesheet link could not be created'))
        return
      }

      link.addEventListener('load', resolve, { once: true })
      link.addEventListener('error', () => {
        link.remove()
        reject(new Error('Waline stylesheet failed to load'))
      }, { once: true })

      if (shouldAppend) document.head.append(link)
    })

    const loadAssets = () => {
      if (window.__nisconderWalineAssets) return window.__nisconderWalineAssets
      const assets = Promise.all([loadStyles(), import(scriptHref)])
      window.__nisconderWalineAssets = assets
      assets.catch(() => {
        if (window.__nisconderWalineAssets === assets) {
          delete window.__nisconderWalineAssets
        }
      })
      return assets
    }

    const bindSection = (section) => {
      if (!(section instanceof HTMLElement)) return
      section.dataset.commentsBound = 'true'
      const root = section.querySelector('[data-waline-root]')
      const status = section.querySelector('[data-waline-status]')
      const body = section.querySelector('[data-comments-body]')
      const toggle = section.querySelector('[data-comments-toggle]')
      if (
        !(root instanceof HTMLElement)
        || !(status instanceof HTMLElement)
        || !(body instanceof HTMLElement)
        || !(toggle instanceof HTMLButtonElement)
      ) return

      const mobileQuery = window.matchMedia('(max-width: 44rem)')
      let observer

      const setExpanded = (expanded) => {
        body.hidden = !expanded
        toggle.hidden = !mobileQuery.matches
        toggle.setAttribute('aria-expanded', String(expanded))
        toggle.textContent = expanded ? '收起留言' : '展开留言'
        section.dataset.commentsExpanded = String(expanded)
      }

      const showRetry = () => {
        status.replaceChildren('留言加载失败。 ')
        const retry = document.createElement('button')
        retry.type = 'button'
        retry.className = 'button secondary'
        retry.textContent = '重新加载'
        retry.addEventListener('click', () => {
          root.__walineInstance?.destroy?.()
          delete root.__walineInstance
          root.replaceChildren()
          root.dataset.walineState = 'idle'
          retry.remove()
          loadComments()
        }, { once: true })
        status.append(retry)
      }

      const loadComments = async () => {
        if (root.dataset.walineState === 'loading' || root.dataset.walineState === 'ready') return
        root.dataset.walineState = 'loading'
        status.textContent = '正在加载留言…'

        try {
          const [, module] = await loadAssets()
          if (!root.isConnected) return
          root.replaceChildren()
          root.__walineInstance = module.init({
            el: root,
            serverURL: 'https://my-waline-pink.vercel.app',
            path: root.dataset.walinePath,
            lang: 'zh-CN',
            login: 'enable',
            dark: "html[data-theme='dark']",
          })
          root.dataset.walineState = 'ready'
          status.remove()
        } catch {
          root.__walineInstance?.destroy?.()
          delete root.__walineInstance
          root.replaceChildren()
          root.dataset.walineState = 'error'
          showRetry()
        }
      }

      const observeComments = () => {
        if (body.hidden || root.dataset.walineState === 'ready') return
        if ('IntersectionObserver' in window) {
          observer?.disconnect()
          observer = new IntersectionObserver((entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return
            observer.disconnect()
            loadComments()
          }, { rootMargin: '600px 0px' })
          observer.observe(section)
        } else {
          loadComments()
        }
      }

      if (mobileQuery.matches) {
        setExpanded(false)
      } else {
        setExpanded(true)
        observeComments()
      }

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') !== 'true'
        setExpanded(expanded)
        if (expanded) {
          loadComments()
          requestAnimationFrame(() => body.scrollIntoView({ block: 'nearest' }))
        } else {
          observer?.disconnect()
        }
      })

      mobileQuery.addEventListener?.('change', (event) => {
        if (event.matches) {
          setExpanded(false)
          observer?.disconnect()
        } else {
          setExpanded(true)
          observeComments()
        }
      })
    }

    sections.forEach(bindSection)

    document.addEventListener('astro:before-swap', () => {
      sections.forEach((section) => {
        const root = section.querySelector('[data-waline-root]')
        root?.__walineInstance?.destroy?.()
      })
    }, { once: true })
  })()
</script>
