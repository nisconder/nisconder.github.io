              "matches": [
                "[text*=\"先用后付服务协议\"]",
                "@[clickable=true] > [text=\"不感兴趣\"]"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "com.taptap",
      "name": "TapTap",
      "groups": [
        {
          "key": 2,
          "name": "分段广告-游戏浏览页面推荐广告",
          "desc": "点击[]对此内容不感兴趣]",
          "fastQuery": true,
          "rules": [
            {
              "key": 0,
              "activityIds": ".other.basic.impl.TapMainActivity",
              "matches": "[id=\"com.taptap.app.middle:id/decision_layout_mask\"] + @[id=\"com.taptap.app.game:id/app_menu\"][visibleToUser=true]"
