              "matches": "[vid=\"video_mute_toggle\"][clickable=true][visibleToUser=true]",
              "excludeMatches": "[vid=\"video_mute_toggle\"][desc=\"隐藏\"][clickable=true][visibleToUser=true]"
            }
          ]
        },
        {
          "key": 13,
          "name": "功能类-查看潜在敏感内容的个人页面",
          "desc": "点某些账号详情页-警告!-> 是,查看个人资料",
