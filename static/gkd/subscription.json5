    {
      "id": "com.hanweb.android.zhejiang.activity",
      "name": "浙里办",
      "groups": [
        {
          "key": 1,
          "name": "更新提示",
          "fastQuery": true,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              "actionMaximum": 1,
              "matches": "@[vid=\"iv_cancel\"] -2 * >2 [text=\"发现新版本\"]"
            },
            {
              "key": 1,
              "actionMaximumKey": 0,
              "matches": "LinearLayout[childCount=2] > LinearLayout[childCount=2] > [text=\"立即升级\"]"
