      "matchSystemApp": false,
      "matchLauncher": false,
      "matchRoot": true,
      "key": 0,
      "name": "开屏广告-全局",
      "desc": "仅处理明确广告SDK跳过ID，或splash内广告跳转文案与相邻倒计时的窄变体；切入应用8秒内最多一次。明确协议同意弹窗暂停匹配。",
      "order": -10,
      "matchTime": 8000,
      "forcedTime": 8000,
      "actionCdKey": 0,
      "actionMaximumKey": 0,
      "priorityTime": 8000,
      "disableIfAppGroupMatch": "开屏广告",
      "rules": [
        {
          "key": 0,
          "matches": "[id$=\":id/tt_splash_skip_btn\"][visibleToUser=true][width>0 && height>0 && width<500 && height<300]",
          "excludeMatches": [
            "[text*=\"请阅读并同意\" || text*=\"请先阅读并同意\" || text*=\"请您仔细阅读\" || text*=\"请您务必认真阅读\" || (text*=\"协议\" && text*=\"隐私\")][visibleToUser=true] <<n [id=\"android:id/parentPanel\"][visibleToUser=true] >n [text=\"同意\" || text=\"同意并继续\" || text=\"同意并使用\" || text=\"同意并进入\"][clickable=true][visibleToUser=true]",
            "[text*=\"协议\" && text*=\"隐私\"][visibleToUser=true] < [visibleToUser=true] > [text=\"同意\" || text=\"同意并继续\" || text=\"同意并使用\" || text=\"同意并进入\"][clickable=true][visibleToUser=true]"
          ]
        },
        {
          "key": 2,
          "matches": "[text=\"下载或跳转第三方应用\"][visibleToUser=true] <<n [id*=\"splash\" || id*=\"Splash\"][visibleToUser=true] >n @[text=\"跳过\"][visibleToUser=true][width>0 && height>0 && width<500 && height<300] + [text~=\"[0-9]{1,2}\"][visibleToUser=true]",
          "excludeMatches": [
            "[text*=\"请阅读并同意\" || text*=\"请先阅读并同意\" || text*=\"请您仔细阅读\" || text*=\"请您务必认真阅读\" || (text*=\"协议\" && text*=\"隐私\")][visibleToUser=true] <<n [id=\"android:id/parentPanel\"][visibleToUser=true] >n [text=\"同意\" || text=\"同意并继续\" || text=\"同意并使用\" || text=\"同意并进入\"][clickable=true][visibleToUser=true]",
            "[text*=\"协议\" && text*=\"隐私\"][visibleToUser=true] < [visibleToUser=true] > [text=\"同意\" || text=\"同意并继续\" || text=\"同意并使用\" || text=\"同意并进入\"][clickable=true][visibleToUser=true]"
          ]
        }
      ],
