    {
      "id": "com.tencent.mm",
      "name": "微信",
      "groups": [
        {
          "key": 0,
          "name": "分段广告-朋友圈广告",
          "desc": "广告入口绑定已知控件和广告反馈面板；隐藏/空白入口仅适用已有快照验证的版本。取消无广告证据的返回和取消补救。",
          "activityIds": [
            ".plugin.sns.ui.SnsTimeLineUI",
            ".plugin.sns.ui.improve.ImproveSnsTimelineUI",
            ".plugin.profile.ui.ContactInfoUI"
          ],
          "rules": [
            {
              "key": 0,
              "name": "①点击[广告]",
              "fastQuery": true,
              "matches": "@[id=\"com.tencent.mm:id/jw\" || id=\"com.tencent.mm:id/fj\"][clickable=true][visibleToUser=true][width>0 && height>0] > [text=\"广告\" || text=\"廣告\" || text=\"Sponsored\"][visibleToUser=true]"
            },
            {
              "key": 1,
              "name": "①旧版本隐藏广告入口（已知广告控件坐标）",
              "fastQuery": true,
              "actionDelay": 0,
              "position": {
                "left": "width * 0.9223",
                "top": "height * 0.5"
              },
              "versionCode": {
                "include": [
                  2580,
                  2600,
                  2820
                ]
              },
              "matches": "@[id=\"com.tencent.mm:id/kbe\"][childCount=2][visibleToUser=true][height>0 && height<200 && width>500] > [id=\"com.tencent.mm:id/jw\"][visibleToUser=false]"
            },
            {
              "key": 2,
              "name": "①旧版本空白广告入口（已知控件ID链）",
              "versionCode": {
                "include": [
                  2020,
                  2820
                ]
              },
              "anyMatches": [
                "[id=\"com.tencent.mm:id/fzb\"] > @[id=\"com.tencent.mm:id/fj\"][childCount=0][clickable=true][visibleToUser=true][width>0 && height>0]",
                "[id=\"com.tencent.mm:id/kbe\"] > @[id=\"com.tencent.mm:id/jw\"][childCount=0][clickable=true][visibleToUser=true][width>0 && height>0]"
              ]
            },
            {
              "preKeys": [
                0,
                1,
                2
              ],
              "key": 25,
              "name": "②点击[关闭]",
              "fastQuery": true,
              "anyMatches": [
                "[text*=\"广告\" || text*=\"廣告\" || text*=\" ad\"][visibleToUser=true] < [id=\"com.tencent.mm:id/n2o\" || id=\"com.tencent.mm:id/huk\"] > @[id=\"com.tencent.mm:id/n2m\"][text=\"关闭该广告\" || text=\"關閉此廣告\" || text=\"Close the ad\"][clickable=true][visibleToUser=true][width>0 && height>0]",
                "[text=\"广告反馈\" || text=\"\\\"Ad feedback\\\"\"][visibleToUser=true] < LinearLayout < LinearLayout > FrameLayout > @[text=\"关闭广告\" || text=\"\\\"Close Ad\\\"\"][clickable=true][visibleToUser=true][width>0 && height>0]",
                "[text=\"赞助商提供的广告信息\" || text=\"Sponsored story\"][visibleToUser=true] < [id=\"com.tencent.mm:id/n2o\" || id=\"com.tencent.mm:id/huk\"] >n @[id=\"com.tencent.mm:id/n2t\" || id=\"com.tencent.mm:id/hup\"][clickable=true][visibleToUser=true][width>0 && height>0]"
              ]
            },
            {
              "preKeys": [
                25
              ],
              "key": 50,
              "name": "③点击[关闭]",
              "matches": "[text=\"关闭该广告的原因\" || text=\"Reason for closing the ad\" || text=\"不感兴趣原因\"][visibleToUser=true] < [id=\"com.tencent.mm:id/n2o\" || id=\"com.tencent.mm:id/huk\"] >n @[text=\"直接关闭\" || text=\"Close\" || text=\"关闭广告\"][clickable=true][visibleToUser=true][width>0 && height>0]"
            },
            {
              "preKeys": [
                50
              ],
              "key": 75,
              "name": "④点击[确认]",
              "fastQuery": true,
              "matches": "[id=\"com.tencent.mm:id/huk\"] > [text=\"不感兴趣原因\"][visibleToUser=true] +2 @[id=\"com.tencent.mm:id/hui\"][text=\"确认\"][clickable=true][visibleToUser=true][width>0 && height>0]"
            }
          ],
          "matchRoot": true
        },
        {
          "key": 1,
          "name": "功能类-微信设备快捷登录",
          "desc": "自动点击[登录]Win/Mac/平板/手表等客户端",
          "fastQuery": true,
          "matchTime": 10000,
          "actionMaximum": 1,
          "rules": [
            {
              "activityIds": [
                ".plugin.webwx.ui.ExtDeviceWXLoginUI",
                ".ui.LauncherUI"
              ],
              "matches": "RelativeLayout[vid!=null][left!=0] > ImageView[width = height] + TextView[text^=\"登录\" || text^=\"登入\" || text^=\"Log in to Weixin for\"][visibleToUser=true] +n * > Button[text=\"登录\" || text=\"登入\" || text=\"Log In\"][visibleToUser=true]"
            }
          ]
        },
        {
          "key": 2,
          "name": "功能类-自动授权登录",
          "desc": "自动允许使用头像昵称等",
          "fastQuery": true,
          "actionMaximum": 1,
          "rules": [
            {
              "key": 0,
              "activityIds": [
                ".plugin.base.stub.UIEntryStub",
                ".ui.LauncherUI",
                ".plugin.webview.ui.tools.MMWebViewUI",
                ".plugin.webview.ui.tools.SDKOAuthUI"
              ],
              "matches": [
                "[text^=\"获取你的\" || text^=\"取得你的\" || text^=\"你的昵称\"]",
                "[text=\"允许\" || text=\"允許\"]"
              ]
            },
            {
              "preKeys": [
                0
              ],
              "activityIds": ".plugin.webview.ui.tools.SDKOAuthOtherUI",
              "matches": [
                "[text=\"申请获得\"][visibleToUser=true]",
                "[text=\"允许\"][visibleToUser=true]"
              ]
            }
          ]
        },
        {
          "key": 4,
          "name": "功能类-微信读书网页版扫码登录自动授权",
          "matchTime": 10000,
          "actionMaximum": 1,
          "activityIds": ".plugin.webview.ui.tools.MMWebViewUI",
          "rules": [
            {
              "key": 1,
              "matches": "[text=\"微信读书网页版\"] +3 Button[text=\"登 录\"]"
            },
            {
              "preKeys": [
                1
              ],
              "key": 2,
              "action": "back",
              "matches": "[text=\"登录成功\"]"
            }
          ]
        },
        {
          "key": 5,
          "name": "功能类-自动领取红包",
          "desc": "自动领取私聊红包,群聊红包",
          "fastQuery": true,
          "rules": [
            {
              "key": 1,
              "name": "点击别人发的红包",
              "activityIds": [
                ".ui.LauncherUI",
                ".ui.chatting.variants.ChattingMainUI"
              ],
              "matches": "LinearLayout[childCount=1] >2 @FrameLayout[clickable=true] >3 [childCount=1] <2 LinearLayout +(1,2) RelativeLayout > [text=\"微信红包\"]"
            },
            {
              "preKeys": [
                1
              ],
              "key": 2,
              "name": "点击红包-开",
              "matchRoot": true,
              "activityIds": ".plugin.luckymoney.ui.LuckyMoney",
              "matches": "@Button[desc=\"开\" || desc=\"開\"] -(2,3) LinearLayout >2 [text$=\"红包\" || text$=\"紅包\"]"
            },
            {
              "preKeys": [
                1,
                2
              ],
              "name": "从红包结算界面返回",
              "activityIds": ".plugin.luckymoney.ui.LuckyMoney",
              "matches": "@ImageView[desc=\"返回\"] +n LinearLayout >8 [text$=\"红包\" || text$=\"紅包\"]"
            }
          ]
        },
        {
          "key": 6,
          "name": "功能类-自动[关闭]已抢完的红包",
          "desc": "点击x掉",
          "rules": [
            {
              "fastQuery": true,
              "activityIds": ".plugin.luckymoney.ui.LuckyMoneyNewReceiveUI",
              "matches": "@[desc=\"关闭\"] - [visibleToUser=true] >3 [text^=\"手慢了\"][text*=\"红包\"][text.length<15]"
            }
          ]
        },
        {
          "key": 7,
          "name": "功能类-自动[选中]发送原图",
          "desc": "自动选中底部中间的发送原图，可手动取消勾选",
          "fastQuery": true,
          "actionMaximum": 1,
          "actionMaximumKey": 1,
          "activityIds": [
            ".plugin.gallery.ui.AlbumPreviewUI",
            ".plugin.gallery.ui.ImagePreviewUI",
            ".plugin.picker.LocalMediaPickerUI",
            ".plugin.picker.preview.LocalMediaPreviewUI"
          ],
          "rules": [
            {
              "key": 1,
              "matches": "@[clickable=true][desc^=\"未选中\" || desc^=\"未選定\" || desc^=\"Unselected\"] + [text=\"原图\" || text=\"原圖\" || text=\"Full Image\"][visibleToUser=true]"
            },
            {
              "key": 2,
              "matches": "@[clickable=true] > [checkable=true][checked=false] + [text=\"原图\" || text=\"原圖\" || text=\"Full Image\"][visibleToUser=true]"
            },
            {
              "key": 3,
              "matches": "[clickable=true][desc^=\"未选中\" || desc^=\"未選定\" || desc^=\"Unselected\"][!(desc*=\"选择\")][text=null]"
            }
          ]
        },
        {
          "key": 9,
          "name": "功能类-自动查看原图",
