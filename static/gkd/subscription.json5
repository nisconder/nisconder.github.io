          ]
        },
        {
          "key": 6,
          "name": "功能类-自动点击翻译",
          "desc": "旧版帖子详情保留原兼容；12.42.0（312420001）适配个人简介和个人页信息流的可访问“显示翻译”按钮，两种控件已验证自动触发。新版详情正文按钮未暴露无障碍节点，暂不支持详情直接触发；首页信息流尚未适配。",
          "rules": [
            {
              "fastQuery": true,
              "actionCd": 2000,
              "activityIds": "com.twitter.tweetdetail.TweetDetailActivity",
              "matches": "[vid=\"translation_link\" || vid=\"grok_translation_link\"][index=parent.childCount.minus(1)][index!=2]",
              "versionName": {
                "pattern": "^(?:(?:[0-9]|1[01])\\.[0-9]+\\.[0-9]+|12\\.(?:[0-8]\\.[0-9]+|9\\.0))(?:[-.].*)?$"
              }
            },
            {
              "key": 100,
              "name": "个人简介翻译（12.42.0）",
              "fastQuery": false,
              "action": "clickNode",
              "actionCd": 2000,
              "matches": "@TextView[text=\"显示翻译\"][clickable=true][visibleToUser=true][childCount=0][width>0 && height>0] < View[childCount=1] <n ScrollView <<n [id=\"UserProfileScreen\"]",
              "versionCodes": [
                312420001
              ],
              "activityIds": [
                "com.x.android.main.MainActivity"
              ],
              "matchRoot": true
            },
            {
              "key": 101,
              "name": "个人页信息流翻译（12.42.0）",
              "fastQuery": false,
              "action": "clickNode",
              "actionCd": 2000,
              "matches": "@TextView[text=\"显示翻译\"][clickable=true][visibleToUser=true][childCount=0][width>0 && height>0] - Button[desc=\"发帖选项\"] - ImageView[desc=\"让 Grok 解释此帖子\"] - [id=\"timeline_post\"] <<n [id=\"UserProfileScreen\"]",
              "versionCodes": [
                312420001
              ],
              "activityIds": [
                "com.x.android.main.MainActivity"
              ],
              "matchRoot": true
            }
          ]
        },
        {
          "key": 7,
          "name": "功能类-自动[显示更多帖子]",
          "desc": "只点击居中的,不点击靠左的[显示更多帖子]",
          "rules": [
            {
              "key": 0,
              "fastQuery": true,
              "activityIds": "com.twitter.app.main.MainActivity",
              "matches": "@FrameLayout[clickable=true] > [text=\"显示更多帖子\"]"
            },
            {
              "key": 1,
              "activityIds": "com.x.android.main.MainActivity",
              "matches": "@[clickable=true] > TextView[visibleToUser=true][text=\"显示更多帖子\"][right>parent.right.minus(parent.width.div(2))]"
            }
          ]
        },
        {
          "key": 8,
          "name": "其他-关闭[开启个性化广告]弹窗",
          "rules": [
            {
              "fastQuery": true,
              "activityIds": "com.twitter.app.main.MainActivity",
              "matches": "[vid=\"secondary_button\"][clickable=true][getChild(0).getChild(0).getChild(0).text=\"保留更少相关广告\"]"
            }
          ]
