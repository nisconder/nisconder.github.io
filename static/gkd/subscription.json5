      "disableIfAppGroupMatch": "更新提示",
      "rules": [
        {
          "key": 0,
          "matches": "[id=\"android:id/alertTitle\"][text=\"发现新版本\" || text=\"发现新版本！\" || text=\"检测到新版本\" || text=\"版本更新\" || text=\"应用更新\" || text=\"软件更新\" || text=\"New version available\" || text=\"Update available\"][visibleToUser=true] <<n [id=\"android:id/parentPanel\"][visibleToUser=true] >n @[id=\"android:id/button2\"][text=\"稍后\" || text=\"稍后再说\" || text=\"以后再说\" || text=\"暂不更新\" || text=\"忽略此版本\" || text=\"Later\" || text=\"Not now\"][clickable=true][visibleToUser=true]",
