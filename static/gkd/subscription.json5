            }
          ]
        },
        {
          "key": 11,
          "name": "功能类-网络错误自动重试",
          "desc": "无法获取帖子=> 点击[重试]",
          "rules": [
            {
              "fastQuery": true,
              "activityIds": "com.twitter.tweetdetail.TweetDetailActivity",
              "matches": "[text^=\"现在无法获取帖子\"] + [text=\"重试\"][clickable=true][visibleToUser=true]"
            }
          ]
        },
        {
          "key": 12,
          "name": "功能类-进入视频自动静音",
