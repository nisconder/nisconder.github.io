            },
            {
              "key": 5,
              "fastQuery": true,
              "activityIds": "com.bilibili.vip.web.VipWebActivity",
              "matches": "@TextView[width<130 && height<130] - TextView[childCount=0][id=\"dialog-canvas\"] <<n [vid=\"webview\"]"
            }
          ]
        },
        {
          "key": 13,
          "name": "全屏广告-分享稿件弹窗",
