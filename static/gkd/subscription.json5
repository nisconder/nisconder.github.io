                "Button[text^=\"查看\"][clickable=true][visibleToUser=true]",
                "Button[clickable=true][text^=\"查看\"][visibleToUser=true]"
              ]
            },
            {
              "key": 1,
              "activityIds": ".ui.LauncherUI",
              "matches": "[text^=\"原图\"][clickable=true][visibleToUser=true]"
            }
          ]
        },
        {
          "key": 10,
          "name": "开屏广告-微信小程序",
          "fastQuery": true,
          "matchTime": 10000,
          "forcedTime": 10000,
          "priorityTime": 10000,
